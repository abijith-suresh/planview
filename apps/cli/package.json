{
  "name": "@abijith-suresh/planview",
  "version": "0.1.1",
  "description": "Turn an HTML file into a durable, immutable localhost URL.",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "bin": {
    "planview": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build --workspace @planview/daemon && tsc --project tsconfig.json && node scripts/bundle.mjs && node scripts/make-executable.mjs dist/index.js",
    "prepack": "npm run build",
    "typecheck": "npm run build --workspace @planview/daemon && tsc --project tsconfig.json --noEmit",
    "test": "npm run build && node --test test/cli.test.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "esbuild": "0.27.7"
  },
  "dependencies": {
    "effect": "4.0.0-beta.107"
  }
}
