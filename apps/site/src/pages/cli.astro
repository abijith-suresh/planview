---
// biome-ignore lint/correctness/noUnusedImports: Astro uses this layout component below.
import SiteLayout from "../layouts/SiteLayout.astro";

// biome-ignore lint/complexity/useLiteralKeys: The site accepts an optional build-time environment variable.
const appUrl = process.env["PUBLIC_APP_URL"] ?? "https://app.plansplease.dev";
// biome-ignore lint/correctness/noUnusedVariables: Astro uses this value in the page template below.
const signInUrl = `${appUrl.replace(/\/$/, "")}/dashboard`;
---

<SiteLayout
  title="CLI | plansplease"
  description="Install the plansplease CLI to preview HTML files and page folders on your own machine."
  activePath="cli"
>
  <section class="page-heading" aria-labelledby="cli-title">
    <div>
      <h1 id="cli-title">The local path is one command.</h1>
      <p>
        Install the CLI when a coding agent needs to leave a page on your machine. It serves local
        snapshots through a loopback-only daemon and keeps the workflow out of your project.
      </p>
    </div>
    <a class="page-action" href={signInUrl}>Open the cloud workspace</a>
  </section>

  <section class="content-section" aria-labelledby="install-title">
    <div class="command-card">
      <div>
        <h2 id="install-title">Install once. Preview often.</h2>
        <p>
          The CLI accepts a standalone HTML file or a page folder with an <code>index.html</code>
          entry point.
        </p>
      </div>
      <pre class="command-block"><code><span>$</span> npm install --global @abijith-suresh/planview
<span>$</span> planview publish --open ./report.html</code></pre>
    </div>
  </section>

  <section class="content-section" aria-labelledby="commands-title">
    <h2 id="commands-title">Commands you can use now.</h2>

    <div class="content-grid">
      <article class="content-card">
        <h2>publish</h2>
        <p>Write a local snapshot and print its URL. Add <code>--open</code> to open it in your browser.</p>
      </article>
      <article class="content-card">
        <h2>get</h2>
        <p>Read a snapshot back by its document id or exact local URL.</p>
      </article>
      <article class="content-card">
        <h2>start / stop</h2>
        <p>Manage the local daemon explicitly when you want it running before an agent starts work.</p>
      </article>
      <article class="content-card">
        <h2>status</h2>
        <p>Check whether the local daemon is running without starting it.</p>
      </article>
    </div>

    <p class="page-note">
      The current CLI is published as <code>@abijith-suresh/planview</code>. The product name and
      package name may change before the public release.
    </p>
  </section>
</SiteLayout>
