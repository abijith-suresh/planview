---
// biome-ignore lint/correctness/noUnusedImports: Astro renders this layout below.
import SiteLayout from "../layouts/SiteLayout.astro";
import { documentationUrl } from "../lib/docs-url";
// biome-ignore lint/correctness/noUnusedVariables: Astro uses this public docs URL below.
const canonical = documentationUrl("guides/cli");
---

<SiteLayout title="CLI | plansplease" description="Install a repository build and preview immutable snapshots on your computer." activePath="cli" canonical={canonical}>
  <section class="page-heading" aria-labelledby="cli-title">
    <div>
      <h1 id="cli-title">Give a local HTML file a URL.</h1>
      <p>The command remains planview. It publishes an HTML file or a folder with index.html and prints a localhost URL. Cloud upload currently accepts standalone HTML.</p>
    </div>
    <a class="page-action" href={canonical}>Read the CLI guide</a>
  </section>
  <p class="page-note">npm publication is disabled for now. The guide explains how to install a repository build.</p>
</SiteLayout>
