---
// biome-ignore lint/correctness/noUnusedImports: Astro uses this layout component below.
import SiteLayout from "../layouts/SiteLayout.astro";

// biome-ignore lint/complexity/useLiteralKeys: The site accepts an optional build-time environment variable.
const appUrl = process.env["PUBLIC_APP_URL"] ?? "https://app.plansplease.dev";
// biome-ignore lint/correctness/noUnusedVariables: Astro uses this value in the page template below.
const signInUrl = `${appUrl.replace(/\/$/, "")}/dashboard`;
---

<SiteLayout
  title="Features | plansplease"
  description="Preview agent-made HTML locally, or keep a private cloud copy you can open later."
  activePath="features"
>
  <section class="page-heading" aria-labelledby="features-title">
    <div>
      <h1 id="features-title">A small home for agent-made pages.</h1>
      <p>
        plansplease gives the HTML your coding agent produces a place to run while it is still
        useful. Start on your machine. Save a page to your private workspace when you need it
        elsewhere.
      </p>
    </div>
    <a class="page-action" href={signInUrl}>Try the cloud workspace</a>
  </section>

  <section class="content-section" aria-labelledby="features-list-title">
    <h2 id="features-list-title">The useful parts.</h2>

    <div class="feature-list">
      <article class="feature-row">
        <span class="feature-number">01</span>
        <div>
          <h2>Preview where you work</h2>
          <p>
            The CLI serves an HTML file through a loopback URL on your machine. No deployment is
            needed to open the page your agent just made.
          </p>
        </div>
        <code class="feature-command">planview publish --open ./page.html</code>
      </article>

      <article class="feature-row">
        <span class="feature-number">02</span>
        <div>
          <h2>Keep a private cloud copy</h2>
          <p>
            Sign in and upload one standalone HTML file to your workspace. Open it again from the
            dashboard when the original agent session is gone.
          </p>
        </div>
        <span class="feature-command">one account / one workspace</span>
      </article>

      <article class="feature-row">
        <span class="feature-number">03</span>
        <div>
          <h2>Start with one file</h2>
          <p>
            The first cloud workflow stays deliberately small. Upload an HTML file, read the
            result, and decide later whether it deserves to become a full project.
          </p>
        </div>
        <span class="feature-command">HTML in / page out</span>
      </article>
    </div>

    <p class="page-note">
      Cloud uploads are private to the signed-in account in the current alpha. See the
      <a href="../privacy/">privacy page</a> for the current behavior.
    </p>
  </section>
</SiteLayout>
