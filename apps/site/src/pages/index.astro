---
// biome-ignore lint/correctness/noUnusedVariables: Astro template references this data below.
const steps = [
  {
    number: "01",
    title: "Point at a file",
    body: "Give Planview an HTML file you already have. No upload, account, or copy of your work leaves the machine.",
  },
  {
    number: "02",
    title: "Get a local address",
    body: "Planview serves it from a loopback-only localhost address and gives it a readable path you can bookmark or keep in a note.",
  },
  {
    number: "03",
    title: "Return to the same place",
    body: "The snapshot is immutable while retained. Reopen it after a reboot or from another tab; access keeps it available under the 30-day last-access policy.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Planview turns an HTML file into an immutable localhost URL with 30-day last-access retention."
    />
    <title>Planview — a lasting address for local work</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href={import.meta.env.BASE_URL} aria-label="Planview home">
          <span class="wordmark-mark" aria-hidden="true">pv</span>
          <span>planview</span>
        </a>
        <nav aria-label="Main navigation">
          <a href="#workflow">The workflow</a>
          <a href="#principles">Why local</a>
        </nav>
        <span class="header-note">A quiet tool for visible work</span>
      </header>

      <a class="skip-link" href="#main-content">Skip to main content</a>

      <main id="main-content" tabindex="-1">
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-copy">
            <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Private / static / local</p>
            <h1 id="hero-title">A lasting address for <em>local</em> work.</h1>
            <p class="hero-intro">
              Planview turns an HTML file into an <strong>immutable localhost URL</strong> — a small,
              dependable place to return to while the snapshot is retained.
            </p>
            <a class="text-link" href="#workflow">
              <span>See how it works</span>
              <span aria-hidden="true">↘</span>
            </a>
          </div>

          <div class="hero-visual" aria-hidden="true">
            <div class="orbit orbit-one"></div>
            <div class="orbit orbit-two"></div>
            <div class="address-card">
              <div class="card-topline">
                <span class="live-indicator"><span></span> serving locally</span>
                <span class="card-menu">···</span>
              </div>
              <div class="address-label">your file, held in place</div>
              <div class="address">localhost<span>:4173</span><b>/plans/quiet-morning</b></div>
              <div class="card-rule"></div>
              <div class="card-footer">
                <span>IMMUTABLE</span>
                <span class="arrow-mark">↗</span>
                <span>NO CLOUD REQUIRED</span>
              </div>
            </div>
            <div class="visual-caption">01 <span>one local address</span></div>
          </div>
        </section>

        <section class="workflow-section" id="workflow" aria-labelledby="workflow-title">
          <div class="section-heading">
            <p class="eyebrow">The whole idea</p>
            <h2 id="workflow-title">Three moves.<br /><em>One retained URL.</em></h2>
          </div>
          <ol class="steps">
            {
              steps.map((step) => (
                <li class="step">
                  <span class="step-number">{step.number}</span>
                  <div>
                    <h3>{step.title}</h3>
                    <p>{step.body}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </section>

        <section class="principles-section" id="principles" aria-labelledby="principles-title">
          <div class="principles-heading">
            <p class="eyebrow">The boundary matters</p>
            <h2 id="principles-title">Local is a feature,<br /><em>not a limitation.</em></h2>
          </div>
          <div class="principles-note">
            <p>
              Your file stays on your machine. The URL is the useful part: a stable local reference
              for the thing you are making, retained under a 30-day last-access policy without
              turning a workbench into a product dashboard.
            </p>
            <div class="principle-line"><span>Private by default</span><span>↗</span></div>
          </div>
        </section>

        <aside class="closing-note" aria-label="Project note">
          <span class="closing-symbol" aria-hidden="true">✳</span>
          <p>Planview is being built for the moment before a local idea becomes a finished thing.</p>
          <span class="closing-index">PV / 001</span>
        </aside>
      </main>

      <footer class="site-footer">
        <span>Planview</span>
        <span>Immutable localhost URLs with 30-day last-access retention.</span>
        <span>Made for the in-between.</span>
      </footer>
    </div>
  </body>
</html>

<style>
  :root {
    --paper: #f4f0e7;
    --ink: #172d3b;
    --muted: #52656a;
    --line: rgba(23, 45, 59, 0.18);
    --orange: #a44626;
    --orange-on-dark: #ed7950;
    --green: #c7dfbc;
    --blue: #b9d4dc;
    --blue-ink: #234754;
    --on-dark-muted: #b9d4dc;
    --display: "Iowan Old Style", "Baskerville", "Times New Roman", serif;
    --mono: "SFMono-Regular", "Cascadia Code", "Roboto Mono", monospace;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.8rem;
    line-height: 1.6;
  }

  body::before {
    position: fixed;
    z-index: 10;
    inset: 0;
    pointer-events: none;
    opacity: 0.08;
    content: "";
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.5'/%3E%3C/svg%3E");
    mix-blend-mode: multiply;
  }

  a {
    color: inherit;
  }

  .skip-link {
    position: fixed;
    z-index: 20;
    top: 1rem;
    left: 1rem;
    padding: 0.75rem 1rem;
    background: var(--ink);
    color: var(--paper);
    transform: translateY(-200%);
    transition: transform 180ms ease;
  }

  .skip-link:focus-visible {
    outline: 3px solid var(--orange);
    outline-offset: 3px;
    transform: translateY(0);
  }

  .site-shell {
    width: min(100% - 3rem, 1240px);
    margin: 0 auto;
  }

  .site-header,
  .site-footer {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 2rem;
    min-height: 5rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    width: fit-content;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .wordmark-mark {
    display: grid;
    width: 1.75rem;
    height: 1.75rem;
    place-items: center;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--display);
    font-size: 0.8rem;
    letter-spacing: -0.1em;
    text-transform: lowercase;
  }

  nav {
    display: flex;
    gap: 2rem;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
    transition: color 180ms ease;
  }

  nav a:hover,
  nav a:focus-visible {
    color: var(--orange);
  }

  .header-note {
    justify-self: end;
    color: var(--muted);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 0.9fr);
    gap: clamp(3rem, 8vw, 9rem);
    align-items: center;
    min-height: 670px;
    padding: 5rem 0 7rem;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin: 0 0 2rem;
    color: var(--orange);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .status-dot {
    display: block;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--orange);
    box-shadow: 0 0 0 4px rgba(237, 121, 80, 0.15);
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1,
  h2 {
    margin-bottom: 1.75rem;
    font-family: var(--display);
    font-weight: 400;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  h1 {
    max-width: 650px;
    font-size: clamp(4rem, 7.6vw, 7.5rem);
  }

  h1 em,
  h2 em {
    color: var(--orange);
    font-style: italic;
  }

  .hero-intro {
    max-width: 440px;
    margin-bottom: 2rem;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.9;
  }

  .hero-intro strong {
    color: var(--ink);
    font-weight: 500;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 1.1rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--ink);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition: gap 180ms ease, color 180ms ease;
  }

  .text-link:hover,
  .text-link:focus-visible {
    gap: 1.6rem;
    color: var(--orange);
    border-color: var(--orange);
  }

  .hero-visual {
    position: relative;
    display: grid;
    min-height: 390px;
    place-items: center;
  }

  .orbit {
    position: absolute;
    border: 1px solid var(--line);
    border-radius: 50%;
    transform: rotate(-24deg);
  }

  .orbit-one {
    width: min(32vw, 390px);
    height: min(18vw, 220px);
  }

  .orbit-two {
    width: min(23vw, 280px);
    height: min(35vw, 430px);
    border-color: rgba(237, 121, 80, 0.35);
    transform: rotate(58deg);
  }

  .address-card {
    position: relative;
    z-index: 1;
    width: min(100%, 430px);
    padding: 1.5rem;
    background: var(--ink);
    color: var(--paper);
    box-shadow: 18px 20px 0 var(--green);
    transform: rotate(-4deg);
    animation: settle 900ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .card-topline,
  .card-footer,
  .principle-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .card-topline {
    color: var(--green);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .live-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .live-indicator span {
    display: block;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--green);
  }

  .card-menu {
    color: var(--on-dark-muted);
    letter-spacing: 0.15em;
  }

  .address-label {
    margin-top: 5rem;
    color: var(--on-dark-muted);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .address {
    margin: 0.5rem 0 1.4rem;
    font-family: var(--display);
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    letter-spacing: -0.04em;
    white-space: nowrap;
  }

  .address span {
    color: var(--orange-on-dark);
  }

  .address b {
    display: block;
    margin-top: 0.15rem;
    color: var(--green);
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0;
  }

  .card-rule {
    height: 1px;
    background: rgba(244, 240, 231, 0.22);
  }

  .card-footer {
    margin-top: 1rem;
    color: var(--on-dark-muted);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
  }

  .card-footer .arrow-mark {
    margin-left: auto;
    padding: 0 1rem;
    color: var(--orange-on-dark);
    font-size: 1.1rem;
  }

  .visual-caption {
    position: absolute;
    right: 0;
    bottom: 0;
    color: var(--orange);
    font-size: 0.68rem;
  }

  .visual-caption span {
    margin-left: 1rem;
    color: var(--muted);
  }

  .workflow-section {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(3rem, 10vw, 12rem);
    padding: 7rem 0;
    border-top: 1px solid var(--line);
  }

  h2 {
    margin-bottom: 0;
    font-size: clamp(2.8rem, 5vw, 5rem);
  }

  .steps {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 1.5rem;
    padding: 1.7rem 0;
    border-top: 1px solid var(--line);
  }

  .step:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .step-number {
    color: var(--orange);
    font-size: 0.68rem;
  }

  h3 {
    margin-bottom: 0.6rem;
    font-family: var(--display);
    font-size: 1.8rem;
    font-weight: 400;
    letter-spacing: -0.04em;
  }

  .step p,
  .principles-note p {
    max-width: 460px;
    margin-bottom: 0;
    line-height: 1.85;
  }

  .step p {
    color: var(--muted);
  }

  .principles-note p {
    color: var(--blue-ink);
  }

  .principles-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    padding: 7rem 0;
    border-top: 1px solid var(--line);
  }

  .principles-note {
    align-self: end;
    max-width: 430px;
    padding: 2rem;
    border: 1px solid var(--line);
    background: var(--blue);
  }

  .principle-line {
    margin-top: 3rem;
    padding-top: 0.9rem;
    border-top: 1px solid rgba(23, 45, 59, 0.3);
    color: var(--ink);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .closing-note {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1.5rem;
    align-items: center;
    margin: 1rem 0 6rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .closing-symbol {
    color: var(--orange);
    font-size: 1.4rem;
  }

  .closing-note p {
    max-width: 570px;
    margin: 0;
    font-family: var(--display);
    font-size: 1.3rem;
    letter-spacing: -0.02em;
  }

  .closing-index {
    color: var(--muted);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
  }

  .site-footer {
    min-height: 6rem;
    border-top: 0;
    border-bottom: 0;
    color: var(--muted);
  }

  .site-footer span:first-child {
    color: var(--ink);
    font-weight: 700;
  }

  .site-footer span:last-child {
    justify-self: end;
  }

  @keyframes settle {
    from {
      opacity: 0;
      transform: translateY(22px) rotate(-1deg);
    }
    to {
      opacity: 1;
      transform: rotate(-4deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    .address-card {
      animation: none;
    }
  }

  @media (max-width: 760px) {
    .site-shell {
      width: min(100% - 2rem, 620px);
    }

    .site-header,
    .site-footer {
      grid-template-columns: 1fr auto;
      gap: 1rem;
    }

    nav {
      order: 3;
      grid-column: 1 / -1;
      justify-content: space-between;
      width: 100%;
      padding-bottom: 1rem;
    }

    .header-note,
    .site-footer span:nth-child(2) {
      display: none;
    }

    .hero {
      display: block;
      min-height: 0;
      padding: 5rem 0 6rem;
    }

    h1 {
      font-size: clamp(3.6rem, 16vw, 6rem);
    }

    .hero-visual {
      min-height: 340px;
      margin-top: 4rem;
    }

    .orbit-one {
      width: 80vw;
      height: 45vw;
    }

    .orbit-two {
      width: 58vw;
      height: 90vw;
    }

    .workflow-section,
    .principles-section {
      display: block;
      padding: 5rem 0;
    }

    .section-heading,
    .principles-heading {
      margin-bottom: 4rem;
    }

    .principles-note {
      margin-left: 12%;
    }

    .closing-note {
      grid-template-columns: auto 1fr;
      margin-bottom: 4rem;
    }

    .closing-index {
      grid-column: 2;
    }

    .site-footer {
      min-height: 5rem;
    }
  }

  @media (max-width: 420px) {
    .address-card {
      padding: 1rem;
      box-shadow: 10px 12px 0 var(--green);
    }

    .address {
      font-size: 1.25rem;
    }

    .address b {
      font-size: 0.65rem;
    }

    .card-footer {
      font-size: 0.48rem;
    }
  }
</style>
