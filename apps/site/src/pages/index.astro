---
// biome-ignore lint/correctness/noUnusedVariables: Astro template references this data below.
const baseUrl = import.meta.env.BASE_URL;
// biome-ignore lint/correctness/noUnusedVariables: Astro template references this data below.
// biome-ignore lint/complexity/useLiteralKeys: The site accepts an optional build-time environment variable.
const appUrl = process.env["PUBLIC_APP_URL"] ?? "https://app.plansplease.dev";

// biome-ignore lint/correctness/noUnusedVariables: Astro template references this data below.
const steps = [
  {
    number: "01",
    tone: "peach",
    title: "Make something",
    body: "Your agent makes a plan, a prototype, a report, or a tiny page worth seeing.",
  },
  {
    number: "02",
    tone: "lilac",
    title: "Keep the page",
    body: "Publish one HTML file locally or send it to your private cloud workspace.",
  },
  {
    number: "03",
    tone: "mint",
    title: "Come back to it",
    body: "The page gets a stable address, so the useful part does not disappear in a terminal tab.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="plansplease keeps the useful HTML pages your coding agents make, locally or in your private cloud workspace."
    />
    <meta name="theme-color" content="#fffaf3" />
    <link rel="icon" href={`${baseUrl}favicon.svg`} type="image/svg+xml" />
    <title>plansplease | Keep the little web things close</title>
  </head>
  <body>
    <div class="site-shell">
      <a class="skip-link" href="#main-content">Skip to main content</a>

      <header class="site-header">
        <a class="brand" href={baseUrl} aria-label="plansplease home">
          <span class="brand-mark" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
          <span class="brand-name">plansplease</span>
        </a>

        <nav aria-label="Main navigation">
          <a href="#how-it-works">How it works</a>
          <a href="#for-agents">For agents</a>
          <a class="nav-button" href={appUrl}>Open workspace <span aria-hidden="true">↗</span></a>
        </nav>
      </header>

      <main id="main-content" tabindex="-1">
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-copy">
            <p class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span> A small tool for useful output</p>
            <h1 id="hero-title">Keep the little <em>web things</em> close.</h1>
            <p class="hero-intro">
              plansplease gives the HTML pages your coding agents make a place to land. Start on
              localhost. Keep the ones worth returning to in your private cloud workspace.
            </p>
            <div class="hero-actions">
              <a class="button button-primary" href={appUrl}>Try the workspace <span aria-hidden="true">↗</span></a>
              <a class="button button-quiet" href="#how-it-works">See how it works <span aria-hidden="true">↓</span></a>
            </div>
            <p class="hero-note"><span aria-hidden="true">✦</span> One HTML file today. More useful things soon.</p>
          </div>

          <div class="hero-scene" role="img" aria-label="A preview of a plansplease HTML page">
            <div class="sun-orb" aria-hidden="true"></div>
            <div class="hero-sticker sticker-yellow" aria-hidden="true">made<br />to revisit</div>
            <div class="hero-sticker sticker-blue" aria-hidden="true">private<br /><strong>by default</strong></div>
            <div class="browser-card">
              <div class="browser-bar">
                <div class="browser-dots" aria-hidden="true"><span></span><span></span><span></span></div>
                <div class="browser-address">plansplease.dev / preview / morning-plan</div>
                <span class="browser-lock" aria-hidden="true">⌁</span>
              </div>
              <div class="browser-page">
                <div class="page-meta"><span class="live-dot"></span> preview ready <span>just now</span></div>
                <div class="page-heading">
                  <span class="tiny-label">Monday / 08:30</span>
                  <h2>Morning plan</h2>
                  <p>A little room to figure out what comes next.</p>
                </div>
                <div class="page-list">
                  <div><span class="check check-pink">✓</span><span>Make coffee before opening tabs</span><b>done</b></div>
                  <div><span class="check check-purple">↗</span><span>Read the useful bits of yesterday</span><b>next</b></div>
                  <div><span class="check check-green">+</span><span>Leave space for one good idea</span><b>later</b></div>
                </div>
                <div class="page-footer"><span>held by plansplease</span><span>HTML / 4 kb</span></div>
              </div>
            </div>
            <div class="scene-caption"><span>01</span><span>an address for the things you make</span></div>
          </div>
        </section>

        <section class="value-strip" aria-label="Product qualities">
          <div><span class="strip-icon strip-icon-lilac">⌂</span><strong>Local first</strong><span>Keep work on your machine.</span></div>
          <div><span class="strip-icon strip-icon-mint">↗</span><strong>Cloud when needed</strong><span>Keep a private link anywhere.</span></div>
          <div><span class="strip-icon strip-icon-peach">✦</span><strong>Small on purpose</strong><span>One useful file at a time.</span></div>
        </section>

        <section class="how-section" id="how-it-works" aria-labelledby="how-title">
          <div class="section-intro">
            <p class="eyebrow">The simple version</p>
            <h2 id="how-title">A place for the things that are <em>almost</em> finished.</h2>
            <p>
              Agent output is useful before it becomes a product. plansplease is the quiet middle
              step between a terminal and something you can open again.
            </p>
          </div>
          <ol class="step-grid">
            {
              steps.map((step) => (
                <li class={`step-card step-card-${step.tone}`}>
                  <div class="step-topline"><span>{step.number}</span><span class="step-arrow" aria-hidden="true">↗</span></div>
                  <h3>{step.title}</h3>
                  <p>{step.body}</p>
                </li>
              ))
            }
          </ol>
        </section>

        <section class="split-section" id="for-agents" aria-labelledby="agents-title">
          <div class="split-copy">
            <p class="eyebrow">Made for the agent loop</p>
            <h2 id="agents-title">The last mile between <em>"here's the file"</em> and "here's the link."</h2>
            <p>
              Your agent can publish an HTML snapshot without asking you to open a folder, start a
              server, or hunt through a pile of temporary files.
            </p>
            <a class="inline-link" href={appUrl}>Open the cloud workspace <span aria-hidden="true">↗</span></a>
          </div>
          <div class="terminal-panel">
            <div class="terminal-top"><span>terminal</span><span>local / ready</span></div>
            <div class="terminal-line"><span class="terminal-prompt">$</span><code>plansplease publish ./morning-plan.html</code></div>
            <div class="terminal-output">
              <span class="terminal-check">✓</span>
              <div><strong>Published locally</strong><span>http://localhost:4173/p/morning-plan</span></div>
            </div>
            <div class="terminal-line terminal-muted"><span class="terminal-prompt">$</span><code>plansplease publish --cloud ./morning-plan.html</code></div>
            <div class="terminal-output terminal-output-cloud">
              <span class="terminal-check">↗</span>
              <div><strong>Saved to your workspace</strong><span>private / plansplease.dev</span></div>
            </div>
          </div>
        </section>

        <section class="cloud-card" aria-labelledby="cloud-title">
          <div class="cloud-card-copy">
            <p class="eyebrow">The cloud workspace</p>
            <h2 id="cloud-title">Your agent works here. You read it <em>anywhere.</em></h2>
            <p>
              Sign in with GitHub, upload a page, and keep a private collection of the small things
              you want to see again. No public gallery. No feed. No ceremony.
            </p>
            <a class="button button-primary button-on-light" href={appUrl}>Open plansplease <span aria-hidden="true">↗</span></a>
          </div>
          <div class="cloud-window" aria-hidden="true">
            <div class="cloud-window-header"><span>your workspace</span><span class="avatar">A</span></div>
            <div class="cloud-window-body">
              <div class="cloud-stat"><span>saved pages</span><strong>04</strong></div>
              <div class="cloud-page-row"><span class="row-swatch row-swatch-peach"></span><span>morning-plan.html</span><small>just now</small></div>
              <div class="cloud-page-row"><span class="row-swatch row-swatch-lilac"></span><span>notes-for-later.html</span><small>yesterday</small></div>
              <div class="cloud-page-row"><span class="row-swatch row-swatch-mint"></span><span>launch-checklist.html</span><small>last week</small></div>
              <div class="cloud-window-footer"><span>private workspace</span><span>⌁ connected</span></div>
            </div>
          </div>
        </section>

        <section class="closing-section" aria-labelledby="closing-title">
          <div class="closing-mark" aria-hidden="true"><span></span><span></span><span></span></div>
          <p class="eyebrow">Keep the useful bits</p>
          <h2 id="closing-title">Less setup.<br /><em>More looking.</em></h2>
          <a class="button button-primary" href={appUrl}>Start with plansplease <span aria-hidden="true">↗</span></a>
        </section>
      </main>

      <footer class="site-footer">
        <a class="brand footer-brand" href={baseUrl} aria-label="plansplease home">
          <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
          <span class="brand-name">plansplease</span>
        </a>
        <p>Small web things, kept close.</p>
        <p>Built for the agent loop.</p>
      </footer>
    </div>
  </body>
</html>

<style>
  :root {
    --paper: #fffaf3;
    --paper-deep: #f7f0e7;
    --ink: #29263d;
    --muted: #726d7d;
    --line: rgba(41, 38, 61, 0.13);
    --violet: #6955c8;
    --violet-dark: #51409d;
    --lilac: #eae4ff;
    --peach: #ffe4d6;
    --yellow: #fff0ae;
    --mint: #dff3e8;
    --blue: #dcecf8;
    --sans: "Avenir Next", "Segoe UI", "Trebuchet MS", sans-serif;
    --display: Georgia, "Times New Roman", serif;
    --mono: "SFMono-Regular", "Cascadia Code", "Roboto Mono", monospace;
  }

  * { box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 1rem;
    line-height: 1.6;
  }

  body::before {
    position: fixed;
    z-index: -1;
    inset: 0;
    pointer-events: none;
    content: "";
    background:
      radial-gradient(circle at 8% 8%, rgba(234, 228, 255, 0.7), transparent 25rem),
      radial-gradient(circle at 90% 22%, rgba(255, 228, 214, 0.6), transparent 26rem),
      radial-gradient(circle at 45% 92%, rgba(223, 243, 232, 0.55), transparent 28rem);
  }

  a { color: inherit; }

  .site-shell { width: min(100% - 2.5rem, 1180px); margin: 0 auto; }

  .skip-link {
    position: fixed;
    z-index: 20;
    top: 1rem;
    left: 1rem;
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    background: var(--ink);
    color: var(--paper);
    transform: translateY(-200%);
    transition: transform 180ms ease;
  }

  .skip-link:focus-visible { outline: 3px solid var(--violet); outline-offset: 3px; transform: translateY(0); }

  .site-header {
    display: flex;
    min-height: 5.75rem;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    border-bottom: 1px solid var(--line);
  }

  .brand { display: inline-flex; align-items: center; gap: 0.7rem; text-decoration: none; }
  .brand-name { font-size: 1.08rem; font-weight: 750; letter-spacing: -0.04em; }

  .brand-mark {
    display: inline-flex;
    width: 2rem;
    height: 2rem;
    align-items: center;
    justify-content: center;
    gap: 0.17rem;
    border: 1px solid rgba(41, 38, 61, 0.12);
    border-radius: 0.72rem;
    background: var(--lilac);
    transform: rotate(-6deg);
  }

  .brand-mark span { display: block; width: 0.27rem; border-radius: 999px; background: var(--violet); }
  .brand-mark span:nth-child(1) { height: 0.62rem; }
  .brand-mark span:nth-child(2) { height: 0.98rem; background: #ee9a7a; }
  .brand-mark span:nth-child(3) { height: 0.78rem; background: #68ad91; }

  nav { display: flex; align-items: center; gap: 1.8rem; font-size: 0.87rem; }
  nav a { color: var(--muted); text-decoration: none; transition: color 180ms ease; }
  nav a:hover, nav a:focus-visible { color: var(--violet-dark); }

  .nav-button, .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
    transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;
  }

  .nav-button { padding: 0.62rem 1rem; background: var(--ink); color: var(--paper); }
  .nav-button:hover, .button:hover { transform: translateY(-2px); box-shadow: 0 0.65rem 1.5rem rgba(41, 38, 61, 0.13); }

  .hero {
    display: grid;
    min-height: 39rem;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(3rem, 7vw, 7rem);
    padding: clamp(4rem, 9vw, 8rem) 0 6rem;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 1.25rem;
    color: var(--violet-dark);
    font-family: var(--mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .eyebrow-dot, .live-dot { display: inline-block; width: 0.5rem; height: 0.5rem; border-radius: 50%; background: #75b895; box-shadow: 0 0 0 0.22rem rgba(117, 184, 149, 0.18); }

  h1, h2, h3, p { margin-top: 0; }
  h1, h2 { letter-spacing: -0.065em; line-height: 0.98; }
  h1 { max-width: 11ch; margin-bottom: 1.7rem; font-size: clamp(3.75rem, 7.5vw, 7rem); font-weight: 750; }
  h1 em, h2 em { color: var(--violet); font-family: var(--display); font-weight: 400; letter-spacing: -0.08em; }

  .hero-intro { max-width: 31rem; margin-bottom: 2rem; color: var(--muted); font-size: 1.1rem; line-height: 1.7; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .button { min-height: 3.15rem; padding: 0.85rem 1.25rem; font-size: 0.92rem; }
  .button-primary { background: var(--violet); color: white; box-shadow: 0 0.5rem 1.3rem rgba(105, 85, 200, 0.22); }
  .button-primary:hover, .button-primary:focus-visible { background: var(--violet-dark); }
  .button-quiet { background: rgba(255, 255, 255, 0.72); color: var(--ink); box-shadow: inset 0 0 0 1px var(--line); }
  .hero-note { margin: 1.45rem 0 0; color: var(--muted); font-size: 0.8rem; }
  .hero-note span { color: #e58f6f; }

  .hero-scene { position: relative; min-height: 30rem; }
  .sun-orb { position: absolute; top: 1rem; right: 4%; width: 16rem; height: 16rem; border-radius: 50%; background: var(--yellow); filter: blur(0.2px); }
  .browser-card { position: absolute; z-index: 2; top: 4rem; left: 7%; width: min(100% - 7%, 35rem); overflow: hidden; border: 1px solid rgba(41, 38, 61, 0.12); border-radius: 1.35rem; background: rgba(255, 255, 255, 0.88); box-shadow: 0 1.6rem 3.6rem rgba(74, 62, 90, 0.13), 0 0.3rem 0 rgba(41, 38, 61, 0.05); transform: rotate(2.5deg); }
  .browser-bar { display: flex; height: 3.1rem; align-items: center; gap: 0.8rem; padding: 0 1rem; border-bottom: 1px solid var(--line); background: rgba(248, 246, 251, 0.92); }
  .browser-dots { display: flex; gap: 0.32rem; }
  .browser-dots span { width: 0.48rem; height: 0.48rem; border-radius: 50%; background: #ec9b83; }
  .browser-dots span:nth-child(2) { background: #e5c969; }
  .browser-dots span:nth-child(3) { background: #83b99c; }
  .browser-address { flex: 1; overflow: hidden; padding: 0.35rem 0.7rem; border-radius: 0.45rem; background: white; color: var(--muted); font-family: var(--mono); font-size: 0.58rem; text-overflow: ellipsis; white-space: nowrap; }
  .browser-lock { color: #86b899; font-size: 1rem; }
  .browser-page { padding: 1.7rem clamp(1.3rem, 4vw, 2.7rem) 1.15rem; background: linear-gradient(145deg, #fff 0%, #fbf8ff 100%); }
  .page-meta { display: flex; align-items: center; gap: 0.45rem; color: #5e9a78; font-family: var(--mono); font-size: 0.58rem; text-transform: uppercase; }
  .page-meta > span:last-child { margin-left: auto; color: var(--muted); text-transform: lowercase; }
  .page-heading { padding: 2.1rem 0 1.5rem; }
  .tiny-label { color: var(--muted); font-family: var(--mono); font-size: 0.58rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .page-heading h2 { margin: 0.55rem 0; font-size: clamp(2rem, 4vw, 3rem); }
  .page-heading p { margin: 0; color: var(--muted); font-size: 0.83rem; }
  .page-list { display: grid; gap: 0.55rem; }
  .page-list div { display: flex; align-items: center; gap: 0.55rem; padding: 0.72rem 0.8rem; border: 1px solid rgba(41, 38, 61, 0.08); border-radius: 0.72rem; background: rgba(255, 255, 255, 0.7); color: #4d4958; font-size: 0.75rem; }
  .page-list b { margin-left: auto; color: var(--muted); font-family: var(--mono); font-size: 0.55rem; font-weight: 500; text-transform: uppercase; }
  .check { display: grid; width: 1.4rem; height: 1.4rem; flex: 0 0 auto; place-items: center; border-radius: 0.45rem; font-size: 0.75rem; }
  .check-pink { background: var(--peach); color: #bb6e56; }
  .check-purple { background: var(--lilac); color: var(--violet); }
  .check-green { background: var(--mint); color: #5c9b79; }
  .page-footer { display: flex; justify-content: space-between; padding-top: 1.15rem; color: var(--muted); font-family: var(--mono); font-size: 0.55rem; text-transform: uppercase; }
  .hero-sticker { position: absolute; z-index: 3; display: grid; width: 6.7rem; height: 6.7rem; place-items: center; border-radius: 50%; font-family: var(--display); font-size: 0.95rem; line-height: 1.05; text-align: center; transform: rotate(-10deg); }
  .sticker-yellow { top: 0; left: 0; background: var(--peach); color: #9e675c; }
  .sticker-blue { right: 0; bottom: 4rem; background: var(--blue); color: #48647b; font-size: 0.84rem; transform: rotate(8deg); }
  .sticker-blue strong { font-family: var(--sans); font-size: 0.68rem; letter-spacing: 0.04em; text-transform: uppercase; }
  .scene-caption { position: absolute; right: 2%; bottom: 0.1rem; display: flex; gap: 0.7rem; color: var(--muted); font-family: var(--mono); font-size: 0.58rem; letter-spacing: 0.05em; text-transform: uppercase; }
  .scene-caption span:first-child { color: var(--violet); }

  .value-strip { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; overflow: hidden; border: 1px solid var(--line); border-radius: 1rem; background: var(--line); }
  .value-strip > div { display: grid; grid-template-columns: auto 1fr; column-gap: 0.75rem; padding: 1.1rem 1.25rem; background: rgba(255, 255, 255, 0.58); }
  .value-strip strong { align-self: end; font-size: 0.87rem; }
  .value-strip > div > span:last-child { grid-column: 2; color: var(--muted); font-size: 0.75rem; }
  .strip-icon { display: grid; width: 2rem; height: 2rem; grid-row: span 2; place-items: center; border-radius: 0.65rem; font-family: var(--mono); font-size: 0.78rem; }
  .strip-icon-lilac { background: var(--lilac); color: var(--violet); }
  .strip-icon-mint { background: var(--mint); color: #4b9674; }
  .strip-icon-peach { background: var(--peach); color: #b86c52; }

  .how-section { padding: clamp(7rem, 13vw, 11rem) 0; }
  .section-intro { display: grid; max-width: 47rem; grid-template-columns: 0.72fr 1.28fr; column-gap: 4rem; align-items: start; }
  .section-intro .eyebrow { grid-column: 1; }
  .section-intro h2 { grid-column: 2; margin: 0; font-size: clamp(2.5rem, 5vw, 4.5rem); }
  .section-intro p:last-child { grid-column: 2; max-width: 34rem; margin: 1.5rem 0 0; color: var(--muted); font-size: 1.03rem; }
  .step-grid { display: grid; margin: 4rem 0 0; padding: 0; grid-template-columns: repeat(3, 1fr); gap: 1rem; list-style: none; }
  .step-card { min-height: 18rem; padding: 1.5rem; border-radius: 1.2rem; }
  .step-card-peach { background: var(--peach); }
  .step-card-lilac { background: var(--lilac); }
  .step-card-mint { background: var(--mint); }
  .step-topline { display: flex; justify-content: space-between; color: var(--muted); font-family: var(--mono); font-size: 0.65rem; }
  .step-arrow { color: var(--ink); font-size: 1.2rem; }
  .step-card h3 { margin: 5rem 0 0.5rem; font-size: 1.35rem; letter-spacing: -0.04em; }
  .step-card p { max-width: 19rem; margin: 0; color: #666273; font-size: 0.9rem; }

  .split-section { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(3rem, 8vw, 8rem); align-items: center; padding: 2rem 0 10rem; }
  .split-copy h2, .cloud-card h2 { max-width: 10ch; margin-bottom: 1.4rem; font-size: clamp(2.8rem, 5vw, 4.5rem); }
  .split-copy > p:not(.eyebrow), .cloud-card-copy > p:not(.eyebrow) { max-width: 30rem; margin-bottom: 1.6rem; color: var(--muted); font-size: 1.03rem; }
  .inline-link { display: inline-flex; gap: 0.55rem; align-items: center; color: var(--violet-dark); font-size: 0.9rem; font-weight: 750; text-decoration: none; }
  .inline-link:hover, .inline-link:focus-visible { text-decoration: underline; text-underline-offset: 0.25rem; }
  .terminal-panel { overflow: hidden; border-radius: 1.15rem; background: #302e43; color: #fdf9f0; box-shadow: 0 1.4rem 2.8rem rgba(41, 38, 61, 0.17); transform: rotate(-2deg); }
  .terminal-top { display: flex; justify-content: space-between; padding: 1rem 1.2rem; border-bottom: 1px solid rgba(255, 255, 255, 0.13); color: #bcb8cb; font-family: var(--mono); font-size: 0.62rem; text-transform: uppercase; }
  .terminal-line { display: flex; gap: 0.7rem; padding: 1.6rem 1.4rem 0.7rem; font-family: var(--mono); font-size: 0.76rem; }
  .terminal-prompt { color: #e6b6a7; }
  .terminal-line code { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .terminal-output { display: flex; gap: 0.8rem; margin: 0 1.4rem; padding: 0.85rem 0.9rem; border-radius: 0.75rem; background: rgba(223, 243, 232, 0.1); }
