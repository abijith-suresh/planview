---
// biome-ignore lint/correctness/noUnusedVariables: Astro template references this value below.
const baseUrl = import.meta.env.BASE_URL;
// biome-ignore lint/correctness/noUnusedVariables: Astro template references this value below.
// biome-ignore lint/complexity/useLiteralKeys: The site accepts an optional build-time environment variable.
const appUrl = process.env["PUBLIC_APP_URL"] ?? "https://app.plansplease.dev";
// biome-ignore lint/correctness/noUnusedVariables: Astro template references this value below.
const signInUrl = `${appUrl.replace(/\/$/, "")}/dashboard`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="plansplease gives coding agents a simple way to publish the HTML pages they make, locally or in a private cloud workspace."
    />
    <meta name="theme-color" content="#1d1d2d" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" href={`${baseUrl}favicon.svg`} type="image/svg+xml" />
    <title>plansplease | Give agent-made HTML a URL</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href={baseUrl} aria-label="plansplease home">
          <span class="brand-name">plansplease</span>
        </a>

        <nav aria-label="Main navigation">
          <a class="header-link" href={signInUrl}>Sign in</a>
        </nav>
      </header>

      <main id="main-content" tabindex="-1">
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-copy">
            <h1 id="hero-title">
              Your agent made a page.
              <span>Give it a URL.</span>
            </h1>
            <p class="hero-intro">
              plansplease turns the HTML your coding agent makes into a page you can open. Use the
              CLI for a local preview, or upload one file to your cloud workspace.
            </p>
            <a class="primary-link" href={signInUrl}>Continue with GitHub</a>
            <p class="cta-note">Sign in or create an account.</p>
          </div>

          <div class="hero-demo" role="img" aria-label="An HTML file becoming a page you can open">
            <div class="demo-header">
              <span>one file in</span>
              <span>one page out</span>
            </div>

            <div class="demo-source">
              <div class="demo-source-row">
                <span>file</span>
                <code>report.html</code>
              </div>
              <div class="demo-source-row demo-source-result">
                <span>local preview</span>
                <code>localhost:4173 / snapshot</code>
              </div>
            </div>

            <div class="demo-page">
              <div class="demo-page-meta">
                <span>HTML preview</span>
                <span>ready to open</span>
              </div>
              <div class="demo-page-rule"></div>
              <p class="demo-page-label">weekly report / 04 kb</p>
              <h2>Weekly report</h2>
              <p class="demo-page-copy">A small page made by your coding agent.</p>
              <div class="demo-page-data">
                <div><span>status</span><strong>ready</strong></div>
                <div><span>format</span><strong>HTML</strong></div>
                <div><span>where</span><strong>your browser</strong></div>
              </div>
            </div>

            <div class="demo-destinations">
              <div>
                <span>local</span>
                <strong>localhost</strong>
              </div>
              <div>
                <span>cloud</span>
                <strong>your workspace</strong>
              </div>
            </div>
          </div>
        </section>

        <section class="pitch-line" aria-label="plansplease summary">
          <p>
            For reports, prototypes, dashboards, and one-off pages your agent makes before they
            become a project.
          </p>
          <span>One HTML file to start.</span>
        </section>
      </main>

      <footer class="site-footer">
        <a class="brand" href={baseUrl} aria-label="plansplease home">
          <span class="brand-name">plansplease</span>
        </a>
        <p>Local CLI / cloud upload</p>
        <a class="footer-link" href={signInUrl}>Continue with GitHub</a>
      </footer>
    </div>
  </body>
</html>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Chivo:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap");

  :root {
    --night: #1d1d2d;
    --night-soft: #29283e;
    --night-muted: #b7b0bf;
    --text: #f7f0e5;
    --paper: #f5eddd;
    --ink: #282638;
    --butter: #e5d58d;
    --mint: #a5d2c0;
    --coral: #df9d8d;
    --blue: #aebfdf;
    --lavender: #c2b2e0;
    --mono: "IBM Plex Mono", "SFMono-Regular", "Cascadia Code", monospace;
    --sans: "IBM Plex Sans", "Trebuchet MS", sans-serif;
    --display: "Chivo", "Trebuchet MS", sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    color-scheme: dark;
    scroll-behavior: smooth;
  }

  body {
    min-width: 320px;
    margin: 0;
    overflow-x: hidden;
    background: var(--night);
    color: var(--text);
    font-family: var(--sans);
    font-size: 1rem;
    line-height: 1.55;
  }

  a {
    color: inherit;
  }

  .site-shell {
    width: min(calc(100% - 3rem), 76rem);
    margin: 0 auto;
  }

  .skip-link {
    position: fixed;
    z-index: 20;
    top: 1rem;
    left: 1rem;
    padding: 0.7rem 1rem;
    background: var(--text);
    color: var(--ink);
    font-size: 0.85rem;
    text-decoration: none;
    transform: translateY(-200%);
    transition: transform 180ms ease;
  }

  .skip-link:focus-visible {
    outline: 3px solid var(--mint);
    outline-offset: 3px;
    transform: translateY(0);
  }

  .site-header {
    display: flex;
    min-height: 5.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    border-bottom: 1px solid rgba(247, 240, 229, 0.18);
  }

  .brand {
    text-decoration: none;
  }

  .brand-name {
    color: var(--text);
    font-family: var(--display);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.06em;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    color: var(--night-muted);
    font-size: 0.9rem;
  }

  .header-link,
  .footer-link {
    text-decoration: none;
    transition: background 180ms ease, color 180ms ease;
  }

  .header-link {
    padding: 0.58rem 0.9rem;
    border: 1px solid rgba(247, 240, 229, 0.34);
    border-radius: 0.35rem;
    color: var(--text);
  }

  .header-link:hover,
  .header-link:focus-visible {
    border-color: var(--mint);
    background: var(--mint);
    color: var(--ink);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(26rem, 0.9fr);
    align-items: center;
    gap: clamp(3rem, 7vw, 7rem);
    padding: clamp(4.5rem, 10vh, 7.5rem) 0 5.5rem;
  }

  h1,
  h2,
  p {
    margin-top: 0;
  }

  h1,
  h2 {
    text-wrap: balance;
  }

  h1 {
    max-width: 11ch;
    margin-bottom: 1.8rem;
    color: var(--text);
    font-family: var(--display);
    font-size: clamp(3.5rem, 5.9vw, 6.2rem);
    font-weight: 600;
    letter-spacing: -0.075em;
    line-height: 0.91;
  }

  h1 span {
    display: block;
    color: var(--butter);
  }

  .hero-intro {
    max-width: 34rem;
    margin-bottom: 2rem;
    color: var(--night-muted);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    line-height: 1.6;
  }

  .primary-link {
    display: inline-block;
    padding: 0.9rem 1.05rem;
    border: 1px solid var(--mint);
    border-radius: 0.35rem;
    background: var(--mint);
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 180ms ease, border-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .primary-link:hover,
  .primary-link:focus-visible {
    border-color: var(--text);
    background: var(--text);
    color: var(--ink);
    transform: translateY(-2px);
  }

  .cta-note {
    margin: 0.85rem 0 0;
    color: var(--night-muted);
    font-size: 0.78rem;
  }

  .hero-demo {
    padding: 1.2rem;
    background: var(--lavender);
    border-radius: 1rem 1rem 3.5rem 1rem;
    color: var(--ink);
  }

  .demo-header,
  .demo-page-meta,
  .demo-page-label,
  .demo-source-row,
  .demo-destinations span,
  .demo-destinations strong {
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .demo-header {
    display: flex;
    justify-content: space-between;
    padding: 0 0.2rem 1rem;
    color: var(--ink);
  }

  .demo-source {
    display: grid;
    gap: 0.4rem;
    padding: 1rem;
    background: var(--night-soft);
    color: var(--text);
  }

  .demo-source-row {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
  }

  .demo-source-row > span {
    color: var(--night-muted);
  }

  .demo-source code {
    overflow: hidden;
    color: var(--mint);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .demo-source-result code {
    color: var(--butter);
  }

  .demo-page {
    margin: 0 1.2rem;
    padding: clamp(1.35rem, 3vw, 2rem);
    background: var(--paper);
    box-shadow: 0 1.5rem 2.5rem rgba(29, 29, 45, 0.16);
  }

  .demo-page-meta {
    display: flex;
    justify-content: space-between;
    color: var(--night-soft);
  }

  .demo-page-rule {
    height: 1px;
    margin: 1.25rem 0 2rem;
    background: rgba(40, 38, 56, 0.2);
  }

  .demo-page-label {
    margin-bottom: 0.6rem;
    color: var(--night-soft);
  }

  .demo-page h2 {
    margin-bottom: 0.55rem;
    color: var(--ink);
    font-family: var(--display);
    font-size: clamp(2.2rem, 4vw, 3.8rem);
    font-weight: 600;
    letter-spacing: -0.075em;
    line-height: 0.95;
  }

  .demo-page-copy {
    margin-bottom: 2rem;
    color: #686176;
    font-size: 0.9rem;
  }

  .demo-page-data {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid rgba(40, 38, 56, 0.2);
  }

  .demo-page-data div {
    display: grid;
    gap: 0.4rem;
    padding: 1rem 0.8rem 0 0;
  }

  .demo-page-data div + div {
    padding-left: 0.8rem;
    border-left: 1px solid rgba(40, 38, 56, 0.2);
  }

  .demo-page-data span {
    color: #686176;
    font-family: var(--mono);
    font-size: 0.6rem;
    text-transform: uppercase;
  }

  .demo-page-data strong {
    color: var(--ink);
    font-size: 0.77rem;
    font-weight: 600;
  }

  .demo-destinations {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
    margin-top: 1rem;
  }

  .demo-destinations > div {
    display: grid;
    gap: 0.35rem;
    padding: 0.85rem;
  }

  .demo-destinations > div:first-child {
    background: var(--mint);
  }

  .demo-destinations > div:last-child {
    background: var(--coral);
  }

  .demo-destinations span,
  .demo-destinations strong {
    color: var(--ink);
  }

  .demo-destinations strong {
    font-size: 0.74rem;
    font-weight: 500;
  }

  .pitch-line {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.5rem 0 5rem;
    border-top: 1px solid rgba(247, 240, 229, 0.18);
    color: var(--night-muted);
  }

  .pitch-line p {
    max-width: 38rem;
    margin: 0;
    font-size: 0.95rem;
  }

  .pitch-line span {
    flex: 0 0 auto;
    color: var(--butter);
    font-family: var(--mono);
    font-size: 0.68rem;
    text-transform: uppercase;
  }

  .site-footer {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1rem;
    align-items: center;
    min-height: 5.5rem;
    border-top: 1px solid rgba(247, 240, 229, 0.18);
    color: var(--night-muted);
    font-size: 0.75rem;
  }

  .site-footer p {
    margin: 0;
    text-align: center;
  }

  .footer-link {
    justify-self: end;
    color: var(--text);
  }

  .footer-link:hover,
  .footer-link:focus-visible {
    color: var(--mint);
  }

  :focus-visible {
    outline: 3px solid var(--mint);
    outline-offset: 4px;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 4rem;
    }

    .hero-copy,
    .hero-demo {
      max-width: 42rem;
    }
  }

  @media (max-width: 620px) {
    .site-shell {
      width: min(calc(100% - 2rem), 76rem);
    }

    .site-header {
      min-height: 4.75rem;
    }

    .hero {
      gap: 3rem;
      padding: 4.5rem 0 3.5rem;
    }

    h1 {
      max-width: 10ch;
      font-size: clamp(3.35rem, 15vw, 5rem);
    }

    .hero-demo {
      padding: 0.8rem;
      border-radius: 0.75rem 0.75rem 2.5rem 0.75rem;
    }

    .demo-source-row {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    .demo-source-row + .demo-source-row {
      margin-top: 0.55rem;
    }

    .demo-page {
      margin: 0 0.7rem;
      padding: 1.1rem;
    }

    .demo-page h2 {
      font-size: 2.35rem;
    }

    .demo-page-data {
      grid-template-columns: 1fr;
    }

    .demo-page-data div,
    .demo-page-data div + div {
      grid-template-columns: 5rem 1fr;
      align-items: baseline;
      padding: 0.7rem 0;
      border-left: 0;
      border-bottom: 1px solid rgba(40, 38, 56, 0.2);
    }

    .demo-page-data div:last-child {
      border-bottom: 0;
    }

    .pitch-line {
      display: grid;
      gap: 1rem;
      padding-bottom: 3.5rem;
    }

    .site-footer {
      grid-template-columns: 1fr;
      gap: 0.6rem;
      padding: 1.4rem 0;
    }

    .site-footer p {
      text-align: left;
    }

    .footer-link {
      justify-self: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>
