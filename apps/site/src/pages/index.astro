---
// biome-ignore lint/correctness/noUnusedImports: Astro uses this layout component below.
import SiteLayout from "../layouts/SiteLayout.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro uses this page value below.
import { appSignInUrl } from "../lib/app-url";
---

<SiteLayout
  title="plansplease | Keep the pages your agent makes"
  description="Agents write specs, prototypes, and tools as HTML. plansplease gives each file a URL — instant locally, private in the cloud."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-head">
      <h1 id="hero-title">
        Your agent made a page.
        <span>Give it somewhere useful to live.</span>
      </h1>

      <p class="hero-lede">
        Specs, dashboards, code reviews, tiny tools — your agent writes them as HTML. plansplease
        turns every file into a URL: instant on your machine, private in the cloud, open from your
        phone.
      </p>

      <div class="hero-actions">
        <a class="btn-primary" href={appSignInUrl}>Continue with GitHub</a>
        <a class="btn-ghost" href="/docs/">Read the docs</a>
      </div>
    </div>

    <div
      class="demo"
      id="demo"
      role="img"
      aria-label="Animation of an agent publishing a page: asked to keep a migration plan, the agent writes auth-migration-spec.html and runs planview publish, which serves it at a local URL and saves a private copy at plansplease.app/p/auth-migration-spec — the saved page then opens alongside."
    >
      <div class="term" aria-hidden="true">
        <div class="term-bar">
          <span></span><span></span><span></span>
        </div>
        <div class="term-body">
          <p class="tl is-prompt">
            <span class="prompt-glyph">❯</span>
            <span class="prompt-text">keep the migration plan somewhere I can open later</span>
          </p>
          <p class="tl is-step"><span class="step-bullet">●</span> Wrote auth-migration-spec.html</p>
          <p class="tl is-step">
            <span class="step-bullet">●</span> planview publish ./auth-migration-spec.html
          </p>
          <p class="tl is-out">
            <span class="check">✓</span> served at
            <span class="url">http://localhost:4777/auth-migration-spec</span>
          </p>
          <p class="tl is-out">
            <span class="check">✓</span> saved to workspace
            <span class="url is-cloud">plansplease.app/p/auth-migration-spec</span>
          </p>
        </div>
      </div>

      <div class="page" aria-hidden="true">
        <div class="page-bar">
          <span class="page-glyph"></span>
          <span class="page-url">plansplease.app/p/auth-migration-spec</span>
          <span class="page-sync"><span class="sync-dot"></span>Synced</span>
        </div>
        <div class="page-body">
          <h2 class="page-title">Auth migration — rollout plan</h2>
          <div class="page-progress">
            <div class="progress-copy">
              <span>Migrated</span>
              <span class="progress-count">3 / 5 services</span>
            </div>
            <div class="progress-track"><span class="progress-fill"></span></div>
          </div>
          <div class="page-tabs">
            <span class="is-active">Overview</span>
            <span>Rollout</span>
            <span>Rollback</span>
          </div>
          <ul class="page-list">
            <li class="is-done">Token schema v2 <span>done</span></li>
            <li class="is-now">Gateway rollout <span>canary 20%</span></li>
            <li>Legacy session keys <span>queued</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="how" aria-labelledby="how-title">
    <div class="how-header">
      <h2 id="how-title">One command, two homes</h2>
      <p>
        The CLI is the fastest way in. Point it at any HTML file and it serves the page on your
        machine and saves a private copy to your workspace at the same time.
      </p>
    </div>

    <ol class="steps">
      <li class="step">
        <span class="step-index" aria-hidden="true">01</span>
        <div class="step-body">
          <h3>Publish the file</h3>
          <p>Any agent can write it. One command hands it a URL.</p>
          <code class="step-code">planview publish ./auth-migration-spec.html</code>
        </div>
      </li>

      <li class="step">
        <span class="step-index" aria-hidden="true">02</span>
        <div class="step-body">
          <h3>Open it anywhere</h3>
          <p>A local address for the machine you're on. A private cloud link for your phone, your
          team, and your future self.</p>
        </div>
      </li>

      <li class="step">
        <span class="step-index" aria-hidden="true">03</span>
        <div class="step-body">
          <h3>Keep it working</h3>
          <p>Pages outlive the chat. They stay in your workspace — searchable, deletable, yours —
          until you decide otherwise.</p>
        </div>
      </li>
    </ol>
  </section>

  <section class="makes" aria-labelledby="makes-title">
    <div class="makes-header">
      <h2 id="makes-title">Built for what agents actually output</h2>
      <p>
        Not landing pages for your side project — the working documents an agent produces while
        doing real work with you.
      </p>
    </div>

    <div class="makes-grid">
      <div class="make">
        <h3>Specs &amp; plans</h3>
        <p>Diagrams, tabs, and trade-off tables instead of a 300-line Markdown file nobody opens.</p>
      </div>
      <div class="make">
        <h3>Code reviews</h3>
        <p>PR diffs with margin notes and severity tags, readable by the whole team.</p>
      </div>
      <div class="make">
        <h3>Prototypes</h3>
        <p>Working sliders, toggles, and states — feel the interaction before the feature exists.</p>
      </div>
      <div class="make">
        <h3>Small tools</h3>
        <p>Throwaway editors for tickets, configs, prompts. Export the result back to the agent.</p>
      </div>
    </div>
  </section>

  <section class="why" aria-labelledby="why-title">
    <h2 id="why-title">Markdown caps out around a hundred lines. Your agent's work doesn't.</h2>
    <p>
      HTML carries diagrams, interaction, and structure in one file your browser already knows how
      to run. plansplease just gives that file a home — works with Claude Code, Cursor, Codex, or
      anything that writes HTML.
    </p>
  </section>

  <section class="cta" aria-labelledby="cta-title">
    <h2 id="cta-title">Stop losing good work in chat scrollback.</h2>
    <p class="cta-lede">Sign in, publish your next agent-made page, and see how long it lasts.</p>
    <div class="cta-actions">
      <a class="btn-primary" href={appSignInUrl}>Continue with GitHub</a>
      <a class="btn-ghost" href="/features/">Explore features</a>
    </div>
    <p class="cta-note">Free during alpha · CLI today, MCP soon · Private by default</p>
  </section>

  <nav class="concept-switch" aria-label="Landing page design concepts">
    <span aria-hidden="true">concept</span>
    <a href="/" aria-current="page">A</a>
    <a href="/1/">B</a>
    <a href="/2/">C</a>
    <a href="/3/">D</a>
  </nav>
</SiteLayout>

<script>
  const demo = document.getElementById("demo");

  if (
    demo &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches &&
    "IntersectionObserver" in window
  ) {
    const lines = Array.from(demo.querySelectorAll<HTMLElement>(".tl"));
    const promptText = demo.querySelector<HTMLElement>(".prompt-text");
    const page = demo.querySelector<HTMLElement>(".page");
    const prompt = promptText?.textContent ?? "";
    let timers: ReturnType<typeof setTimeout>[] = [];

    const at = (delay: number, fn: () => void) => {
      timers.push(setTimeout(fn, delay));
    };

    const reset = () => {
      timers.forEach(clearTimeout);
      timers = [];
      demo.classList.remove("is-playing", "is-holding");
      page?.classList.remove("is-in");
      lines.forEach((line) => line.classList.remove("is-on"));
      if (promptText) promptText.textContent = "";
    };

    const play = () => {
      reset();
      demo.classList.add("is-playing");
      if (promptText) {
        const promptLine = demo.querySelector<HTMLElement>(".is-prompt");
        promptLine?.classList.add("is-on");
        let i = 0;
        const type = () => {
          i += 1;
          promptText.textContent = prompt.slice(0, i);
          if (i < prompt.length) at(24 + Math.random() * 34, type);
        };
        at(250, type);
      }
      at(2600, () => lines[1]?.classList.add("is-on"));
      at(3300, () => lines[2]?.classList.add("is-on"));
      at(4000, () => lines[3]?.classList.add("is-on"));
      at(4700, () => lines[4]?.classList.add("is-on"));
      at(5450, () => page?.classList.add("is-in"));
      at(12500, () => demo.classList.add("is-holding"));
      at(13300, play);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            play();
            observer.disconnect();
            break;
          }
        }
      },
      { threshold: 0.35 },
    );
    observer.observe(demo);
  }
</script>

<style>
  /* ---------- Hero ---------- */

  .hero {
    position: relative;
    overflow: clip;
    padding: clamp(5rem, 10vh, 7rem) 0 5.5rem;
    text-align: center;
  }

  .hero::before {
    content: "";
    position: absolute;
    top: -16rem;
    left: 50%;
    width: 60rem;
    height: 36rem;
    background: radial-gradient(ellipse at center, rgba(229, 121, 90, 0.055), transparent 62%);
    pointer-events: none;
  }

  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.032) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.032) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(82% 64% at 50% 34%, black 26%, transparent 76%);
    -webkit-mask-image: radial-gradient(82% 64% at 50% 34%, black 26%, transparent 76%);
    pointer-events: none;
  }

  .hero-head {
    position: relative;
    z-index: 1;
  }

  h1 {
    max-width: 26ch;
    margin: 0 auto 1.6rem;
    color: var(--text-white);
    font-family: var(--display);
    font-size: clamp(2.8rem, 5.8vw, 4.5rem);
    font-weight: 640;
    letter-spacing: -0.046em;
    line-height: 1.04;
    text-wrap: balance;
  }

  h1 span {
    display: block;
    color: var(--night-muted);
  }

  .hero-lede {
    max-width: 38rem;
    margin: 0 auto 2.4rem;
    color: var(--night-muted);
    font-size: 1.12rem;
    line-height: 1.62;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.72rem 1.4rem;
    border-radius: 10px;
    background: var(--text-white);
    color: var(--ink);
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: background-color 140ms ease, transform 140ms ease;
  }

  .btn-primary:hover,
  .btn-primary:focus-visible {
    background: #e6e5e2;
    transform: translateY(-1px);
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    padding: 0.72rem 1.3rem;
    border: 1px solid var(--night-border-hover);
    border-radius: 10px;
    color: var(--text-white);
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 140ms ease, background-color 140ms ease;
  }

  .btn-ghost:hover,
  .btn-ghost:focus-visible {
    border-color: rgba(255, 255, 255, 0.24);
    background: rgba(255, 255, 255, 0.04);
  }

  /* Entry stagger */

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  .hero-head > * {
    animation: rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .hero-head > .hero-lede {
    animation-delay: 0.09s;
  }

  .hero-head > .hero-actions {
    animation-delay: 0.18s;
  }

  .demo {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 1.4rem;
    align-items: center;
    max-width: 66rem;
    margin: 4.25rem auto 0;
    text-align: left;
    animation: rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) 0.3s both;
  }

  /* ---------- Terminal ---------- */

  .term {
    overflow: hidden;
    border: 1px solid var(--night-border);
    border-radius: 14px;
    background: var(--night-soft);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.05) inset, 0 28px 64px -24px rgba(0, 0, 0, 0.6);
  }

  .term-bar {
    display: flex;
    gap: 0.45rem;
    align-items: center;
    padding: 0.8rem 1.1rem;
    border-bottom: 1px solid var(--night-border);
  }

  .term-bar span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
  }

  .term-body {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.4rem 1.5rem 1.6rem;
    font-family: var(--mono);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .tl {
    margin: 0;
    color: var(--night-muted);
    overflow-wrap: break-word;
  }

  .prompt-glyph {
    margin-right: 0.55rem;
    color: var(--mint);
  }

  .is-prompt {
    color: var(--text-white);
  }

  .is-playing .prompt-text::after {
    content: "";
    display: inline-block;
    width: 0.52em;
    height: 1.05em;
    margin-left: 2px;
    vertical-align: text-bottom;
    background: var(--mint);
    animation: caret 1.05s steps(2, jump-none) infinite;
  }

  @keyframes caret {
    50% {
      opacity: 0;
    }
  }

  .step-bullet {
    margin-right: 0.5rem;
    color: var(--mint);
    opacity: 0.75;
  }

  .is-step {
    color: var(--text);
  }

  .check {
    margin-right: 0.35rem;
    color: var(--mint);
  }

  .url {
    color: var(--night-muted);
  }

  .url.is-cloud {
    color: var(--mint);
  }

  /* ---------- Page card ---------- */

  .page {
    border: 1px solid var(--night-border);
    border-radius: 14px;
    background: var(--night-card);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.05) inset, 0 32px 72px -28px rgba(0, 0, 0, 0.65);
  }

  .page-bar {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--night-border);
    background: rgba(255, 255, 255, 0.015);
  }

  .page-glyph {
    flex-shrink: 0;
    width: 7px;
    height: 7px;
    border: 1.5px solid var(--night-subtle);
    border-radius: 2px;
  }

  .page-url {
    flex: 1;
    overflow: hidden;
    color: var(--text);
    font-family: var(--mono);
    font-size: 0.72rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .page-sync {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.4rem;
    color: var(--night-subtle);
    font-size: 0.7rem;
  }

  .sync-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--mint);
  }

  .page-body {
    padding: 1.5rem 1.6rem 1.6rem;
  }

  .page-title {
    margin: 0 0 1.3rem;
    color: var(--text-white);
    font-family: var(--display);
    font-size: 1.2rem;
    font-weight: 640;
    letter-spacing: -0.022em;
  }

  .page-progress {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.3rem;
  }

  .progress-copy {
    display: flex;
    justify-content: space-between;
    color: var(--night-muted);
    font-size: 0.8rem;
  }

  .progress-count {
    font-family: var(--mono);
    font-size: 0.72rem;
  }

  .progress-track {
    height: 5px;
    overflow: hidden;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.07);
  }

  .progress-fill {
    display: block;
    width: 60%;
    height: 100%;
    border-radius: 3px;
    background: var(--mint);
  }

  .page-tabs {
    display: flex;
    gap: 1.3rem;
    margin-bottom: 1.2rem;
    border-bottom: 1px solid var(--night-border);
  }

  .page-tabs span {
    padding-bottom: 0.6rem;
    color: var(--night-subtle);
    font-size: 0.82rem;
    font-weight: 500;
  }

  .page-tabs .is-active {
    border-bottom: 1px solid var(--mint);
    color: var(--text-white);
  }

  .page-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .page-list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--night-border);
    color: var(--night-muted);
    font-size: 0.83rem;
  }

  .page-list li:last-child {
    border-bottom: 0;
  }

  .page-list li span {
    flex-shrink: 0;
    color: var(--night-subtle);
    font-family: var(--mono);
    font-size: 0.68rem;
  }

  .page-list li.is-done {
    color: var(--text);
  }

  .page-list li.is-done span {
    color: var(--mint);
  }

  .page-list li.is-now {
    color: var(--text-white);
  }

  /* ---------- Animation states ----------
     Base styles render the finished scene. While .is-playing is set,
     elements stay hidden until the script reveals each in turn. */

  .is-playing .tl {
    opacity: 0;
  }

  .is-playing .tl.is-on {
    opacity: 1;
    transition: opacity 0.32s ease;
  }

  .is-playing .page {
    opacity: 0;
    transform: translateY(18px) scale(0.985);
  }

  .is-playing .page.is-in {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.55s cubic-bezier(0.2, 0.7, 0.2, 1),
      transform 0.55s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .is-playing.is-holding .term-body,
  .is-playing.is-holding .page {
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-head > *,
    .demo {
      animation: none;
    }
  }

  /* ---------- How it works ---------- */

  .how {
    padding: 6rem 0;
    border-top: 1px solid var(--night-border);
  }

  .how-header {
    max-width: 42rem;
    margin-bottom: 3.5rem;
  }

  .how-header h2 {
    margin: 0 0 1rem;
    color: var(--text-white);
    font-family: var(--display);
    font-size: clamp(1.8rem, 3.2vw, 2.5rem);
    font-weight: 640;
    letter-spacing: -0.034em;
    line-height: 1.12;
    text-wrap: balance;
  }

  .how-header p {
    margin: 0;
    color: var(--night-muted);
    font-size: 1.05rem;
    line-height: 1.62;
  }

  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3rem;
  }

  .step-index {
    display: block;
    margin-bottom: 1.1rem;
    color: var(--mint);
    font-family: var(--mono);
    font-size: 0.78rem;
  }

  .step h3 {
    margin: 0 0 0.6rem;
    color: var(--text-white);
    font-family: var(--display);
    font-size: 1.12rem;
    font-weight: 640;
    letter-spacing: -0.02em;
  }

  .step p {
    margin: 0;
    color: var(--night-muted);
    font-size: 0.92rem;
    line-height: 1.62;
  }

  .step-code {
    display: block;
    margin-top: 1.05rem;
    padding: 0.65rem 0.9rem;
    border: 1px solid var(--night-border);
    border-radius: 8px;
    background: var(--night-soft);
    color: var(--text);
    font-family: var(--mono);
    font-size: 0.76rem;
    overflow-x: auto;
    white-space: nowrap;
  }

  /* ---------- What agents make ---------- */

  .makes {
    padding: 6rem 0;
    border-top: 1px solid var(--night-border);
  }

  .makes-header {
    max-width: 42rem;
    margin-bottom: 3.5rem;
  }

  .makes-header h2 {
    margin: 0 0 1rem;
    color: var(--text-white);
    font-family: var(--display);
    font-size: clamp(1.8rem, 3.2vw, 2.5rem);
    font-weight: 640;
    letter-spacing: -0.034em;
    line-height: 1.12;
    text-wrap: balance;
  }

  .makes-header p {
    margin: 0;
    color: var(--night-muted);
    font-size: 1.05rem;
    line-height: 1.62;
  }

  .makes-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.6rem 3.4rem;
  }

  .make {
    padding-top: 1.4rem;
    border-top: 1px solid var(--night-border);
  }

  .make h3 {
    margin: 0 0 0.5rem;
    color: var(--text-white);
    font-family: var(--display);
    font-size: 1.05rem;
    font-weight: 640;
    letter-spacing: -0.015em;
  }

  .make p {
    margin: 0;
    color: var(--night-muted);
    font-size: 0.94rem;
    line-height: 1.6;
  }

  /* ---------- Why HTML ---------- */

  .why {
    padding: 7rem 0;
    border-top: 1px solid var(--night-border);
  }

  .why h2 {
    max-width: 30ch;
    margin: 0 0 1.4rem;
    color: var(--text-white);
    font-family: var(--display);
    font-size: clamp(2rem, 3.6vw, 2.9rem);
    font-weight: 640;
    letter-spacing: -0.036em;
    line-height: 1.1;
    text-wrap: balance;
  }

  .why p {
    max-width: 40rem;
    margin: 0;
    color: var(--night-muted);
    font-size: 1.08rem;
    line-height: 1.65;
  }

  /* ---------- CTA ---------- */

  .cta {
    padding: 7rem 0 7.5rem;
    border-top: 1px solid var(--night-border);
    text-align: center;
  }

  .cta h2 {
