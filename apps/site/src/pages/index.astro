---
// biome-ignore lint/correctness/noUnusedImports: Astro uses this layout component below.
import SiteLayout from "../layouts/SiteLayout.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro uses this page value below.
import { appSignInUrl } from "../lib/app-url";
---

<SiteLayout
  title="plansplease | Keep the pages your agent makes"
  description="Agents write specs, prototypes, and tools as HTML. plansplease gives each file a URL — instant locally, private in the cloud."
>
  <section class="hero" aria-labelledby="hero-title">
    <h1 id="hero-title">
      Your agent made a page.
      <span>Give it somewhere useful to live.</span>
    </h1>

    <p class="hero-lede">
      Specs, dashboards, code reviews, tiny tools — your agent writes them as HTML. plansplease
      turns every file into a URL: instant on your machine, private in the cloud, open from your
      phone.
    </p>

    <div class="hero-actions">
      <a class="btn-primary" href={appSignInUrl}>Continue with GitHub</a>
      <a class="btn-ghost" href="/docs/">Read the docs</a>
    </div>

    <div class="stage" role="img" aria-label="An agent-made migration plan served as a private plansplease page, also readable on a phone">
      <div class="frame">
        <div class="frame-bar">
          <span class="frame-glyph" aria-hidden="true"></span>
          <span class="frame-url">plansplease.app/p/auth-migration-spec</span>
          <span class="frame-sync" aria-hidden="true"><span class="sync-dot"></span>Synced</span>
        </div>

        <div class="frame-body">
          <div class="doc-head">
            <p class="doc-filename">auth-migration-spec.html</p>
            <h2 class="doc-title">Auth migration — rollout plan</h2>
          </div>

          <div class="doc-progress">
            <div class="progress-copy">
              <span class="progress-label">Migrated</span>
              <span class="progress-count">3 / 5 services</span>
            </div>
            <div class="progress-track"><span class="progress-fill"></span></div>
          </div>

          <div class="doc-tabs">
            <span class="tab is-active">Overview</span>
            <span class="tab">Rollout</span>
            <span class="tab">Rollback</span>
          </div>

          <div class="doc-diagram" aria-hidden="true">
            <span class="node">Client</span>
            <span class="wire"></span>
            <span class="node is-lit">Gateway</span>
            <span class="wire"></span>
            <span class="node">Session store</span>
          </div>

          <ul class="doc-list">
            <li class="is-done">Token schema v2 <span>done</span></li>
            <li class="is-now">Gateway rollout <span>canary 20%</span></li>
            <li>Legacy session keys <span>queued</span></li>
          </ul>
        </div>
      </div>

      <div class="phone" aria-hidden="true">
        <div class="phone-url">plansplease.app/p/auth-migration-spec</div>
        <p class="phone-title">Auth migration — rollout plan</p>
        <div class="phone-track"><span></span></div>
        <div class="phone-row is-done"><span class="tick"></span>Token schema v2</div>
        <div class="phone-row is-now"><span class="tick"></span>Gateway rollout</div>
      </div>
    </div>
  </section>

  <section class="how" aria-labelledby="how-title">
    <div class="how-header">
      <h2 id="how-title">One command, two homes</h2>
      <p>
        The CLI is the fastest way in. Point it at any HTML file and it serves the page on your
        machine and saves a private copy to your workspace at the same time.
      </p>
    </div>

    <ol class="steps">
      <li class="step">
        <span class="step-index" aria-hidden="true">01</span>
        <div class="step-body">
          <h3>Publish the file</h3>
          <p>Any agent can write it. One command hands it a URL.</p>
          <code class="step-code">planview publish ./auth-migration-spec.html</code>
        </div>
      </li>

      <li class="step">
        <span class="step-index" aria-hidden="true">02</span>
        <div class="step-body">
          <h3>Open it anywhere</h3>
          <p>A local address for the machine you're on. A private cloud link for your phone, your
          team, and your future self.</p>
        </div>
      </li>

      <li class="step">
        <span class="step-index" aria-hidden="true">03</span>
        <div class="step-body">
          <h3>Keep it working</h3>
          <p>Pages outlive the chat. They stay in your workspace — searchable, deletable, yours —
          until you decide otherwise.</p>
        </div>
      </li>
    </ol>
  </section>

  <section class="makes" aria-labelledby="makes-title">
    <div class="makes-header">
      <h2 id="makes-title">Built for what agents actually output</h2>
      <p>
        Not landing pages for your side project — the working documents an agent produces while
        doing real work with you.
      </p>
    </div>

    <div class="makes-grid">
      <div class="make">
        <h3>Specs &amp; plans</h3>
        <p>Diagrams, tabs, and trade-off tables instead of a 300-line Markdown file nobody opens.</p>
      </div>
      <div class="make">
        <h3>Code reviews</h3>
        <p>PR diffs with margin notes and severity tags, readable by the whole team.</p>
      </div>
      <div class="make">
        <h3>Prototypes</h3>
        <p>Working sliders, toggles, and states — feel the interaction before the feature exists.</p>
      </div>
      <div class="make">
        <h3>Small tools</h3>
        <p>Throwaway editors for tickets, configs, prompts. Export the result back to the agent.</p>
      </div>
    </div>
  </section>

  <section class="why" aria-labelledby="why-title">
    <h2 id="why-title">Markdown caps out around a hundred lines. Your agent's work doesn't.</h2>
    <p>
      HTML carries diagrams, interaction, and structure in one file your browser already knows how
      to run. plansplease just gives that file a home — works with Claude Code, Cursor, Codex, or
      anything that writes HTML.
    </p>
  </section>

  <section class="cta" aria-labelledby="cta-title">
    <h2 id="cta-title">Stop losing good work in chat scrollback.</h2>
    <p class="cta-lede">Sign in, publish your next agent-made page, and see how long it lasts.</p>
    <div class="cta-actions">
      <a class="btn-primary" href={appSignInUrl}>Continue with GitHub</a>
      <a class="btn-ghost" href="/features/">Explore features</a>
    </div>
    <p class="cta-note">Free during alpha · CLI today, MCP soon · Private by default</p>
  </section>

  <nav class="concept-switch" aria-label="Landing page design concepts">
    <span aria-hidden="true">concept</span>
    <a href="/" aria-current="page">A</a>
    <a href="/1/">B</a>
    <a href="/2/">C</a>
    <a href="/3/">D</a>
  </nav>
</SiteLayout>

<style>
  /* ---------- Hero ---------- */

  .hero {
    position: relative;
    overflow: clip;
    padding: clamp(4.5rem, 9vh, 6.5rem) 0 4rem;
  }

  .hero::before {
    content: "";
    position: absolute;
    top: -18rem;
    left: 50%;
    width: 68rem;
    height: 40rem;
    background: radial-gradient(ellipse at center, rgba(233, 162, 59, 0.06), transparent 62%);
    pointer-events: none;
  }

  h1 {
    position: relative;
    max-width: 24ch;
    margin: 0 0 1.6rem;
    color: var(--text-white);
    font-family: var(--display);
    font-size: clamp(2.7rem, 5.4vw, 4.1rem);
    font-weight: 640;
    letter-spacing: -0.045em;
    line-height: 1.03;
    text-wrap: balance;
  }

  h1 span {
    display: block;
    color: var(--night-muted);
  }

  .hero-lede {
    position: relative;
    max-width: 37rem;
    margin: 0 0 2.4rem;
    color: var(--night-muted);
    font-size: 1.12rem;
    line-height: 1.62;
  }

  .hero-actions {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.72rem 1.4rem;
    border-radius: 10px;
    background: var(--text-white);
    color: var(--ink);
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: background-color 140ms ease;
  }

  .btn-primary:hover,
  .btn-primary:focus-visible {
    background: #e8e4dc;
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    padding: 0.72rem 1.3rem;
    border: 1px solid var(--night-border-hover);
    border-radius: 10px;
    color: var(--text-white);
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 140ms ease, background-color 140ms ease;
  }

  .btn-ghost:hover,
  .btn-ghost:focus-visible {
    border-color: #3a3833;
    background: var(--night-card);
  }

  /* ---------- Product stage ---------- */

  .stage {
    position: relative;
    margin-top: 4.5rem;
  }

  .frame {
    overflow: hidden;
    border: 1px solid var(--night-border);
    border-radius: 14px;
    background: var(--night-card);
    box-shadow: 0 1px 0 rgba(247, 245, 241, 0.04) inset, 0 32px 80px rgba(0, 0, 0, 0.5);
  }

  .frame-bar {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.75rem 1.1rem;
    border-bottom: 1px solid var(--night-border);
    background: var(--night-soft);
  }

  .frame-glyph {
    width: 8px;
    height: 8px;
    border: 1.5px solid var(--night-subtle);
    border-radius: 2px;
  }

  .frame-url {
    flex: 1;
    overflow: hidden;
    color: var(--text);
    font-family: var(--mono);
    font-size: 0.78rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .frame-sync {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.45rem;
    color: var(--night-subtle);
    font-size: 0.72rem;
  }

  .sync-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--mint);
  }

  .frame-body {
    max-width: 46rem;
    padding: 2.2rem 2.6rem 2.6rem;
  }

  .doc-filename {
    margin: 0 0 0.55rem;
    color: var(--night-subtle);
    font-family: var(--mono);
    font-size: 0.72rem;
  }

  .doc-title {
    margin: 0 0 1.6rem;
    color: var(--text-white);
    font-family: var(--display);
    font-size: 1.45rem;
    font-weight: 640;
    letter-spacing: -0.025em;
  }

  .doc-progress {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin-bottom: 1.6rem;
  }

  .progress-copy {
    display: flex;
    justify-content: space-between;
    color: var(--night-muted);
    font-size: 0.82rem;
  }

  .progress-count {
    font-family: var(--mono);
    font-size: 0.75rem;
  }

  .progress-track {
    height: 5px;
    border-radius: 3px;
    background: var(--night-card-elevated);
    overflow: hidden;
  }

  .progress-fill {
    display: block;
    width: 60%;
    height: 100%;
    border-radius: 3px;
    background: var(--mint);
  }

  .doc-tabs {
    display: flex;
    gap: 1.4rem;
    margin-bottom: 1.7rem;
    border-bottom: 1px solid var(--night-border);
  }

  .tab {
    padding-bottom: 0.7rem;
    color: var(--night-subtle);
    font-size: 0.85rem;
    font-weight: 500;
  }

  .tab.is-active {
    border-bottom: 1px solid var(--mint);
    color: var(--text-white);
  }

  .doc-diagram {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 1.1rem 1.2rem;
    margin-bottom: 1.5rem;
    border: 1px solid var(--night-border);
    border-radius: 10px;
    background: var(--night-soft);
  }

  .node {
    padding: 0.42rem 0.8rem;
    border: 1px solid var(--night-border-hover);
    border-radius: 7px;
    color: var(--night-muted);
    font-size: 0.78rem;
    font-weight: 500;
  }

  .node.is-lit {
    border-color: var(--mint-border);
    background: var(--mint-soft);
    color: var(--mint);
  }

  .wire {
    flex: 1;
    max-width: 3.5rem;
    height: 1px;
    background: var(--night-border-hover);
  }

  .doc-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .doc-list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--night-border);
    color: var(--night-muted);
    font-size: 0.85rem;
  }

  .doc-list li:last-child {
    border-bottom: 0;
  }

  .doc-list li span {
    flex-shrink: 0;
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--night-subtle);
  }

  .doc-list li.is-done {
    color: var(--text);
  }

  .doc-list li.is-done span {
    color: var(--mint);
  }

  .doc-list li.is-now {
    color: var(--text-white);
  }

  /* Phone peek */

  .phone {
    position: absolute;
    right: 2.5rem;
    bottom: -2.2rem;
    width: 15rem;
    padding: 1rem 1.05rem 1.2rem;
    border: 1px solid var(--night-border-hover);
    border-radius: 22px;
    background: var(--night-card-elevated);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.55);
    transform: rotate(-2deg);
  }

  .phone-url {
    overflow: hidden;
    margin-bottom: 0.8rem;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--night-border);
    border-radius: 6px;
    background: var(--night-soft);
    color: var(--night-subtle);
    font-family: var(--mono);
    font-size: 0.6rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .phone-title {
    margin: 0 0 0.7rem;
    color: var(--text-white);
    font-family: var(--display);
    font-size: 0.86rem;
    font-weight: 640;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .phone-track {
    height: 4px;
    margin-bottom: 0.9rem;
    border-radius: 2px;
    background: var(--night-border);
    overflow: hidden;
  }

  .phone-track span {
    display: block;
    width: 60%;
    height: 100%;
    border-radius: 2px;
    background: var(--mint);
  }

  .phone-row {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 0;
    border-top: 1px solid var(--night-border);
    color: var(--night-muted);
    font-size: 0.76rem;
  }

  .phone-row.is-now {
    color: var(--text-white);
  }

  .tick {
    width: 10px;
    height: 10px;
    flex-shrink: 0;
    border: 1.5px solid var(--night-subtle);
    border-radius: 50%;
  }

  .phone-row.is-done .tick {
    border-color: var(--mint);
    background: var(--mint-soft);
  }

  .phone-row.is-now .tick {
    border-color: var(--mint);
    background: var(--mint);
  }

  /* ---------- How it works ---------- */

  .how {
    padding: 5.5rem 0;
    border-top: 1px solid var(--night-border);
  }

  .how-header {
    max-width: 42rem;
    margin-bottom: 3.2rem;
  }

  .how-header h2 {
    margin: 0 0 1rem;
    color: var(--text-white);
    font-family: var(--display);
    font-size: clamp(1.75rem, 3vw, 2.35rem);
    font-weight: 640;
    letter-spacing: -0.032em;
    line-height: 1.15;
    text-wrap: balance;
  }

  .how-header p {
    margin: 0;
    color: var(--night-muted);
    font-size: 1.02rem;
    line-height: 1.62;
  }

  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3rem;
  }

  .step-index {
    display: block;
    margin-bottom: 1.1rem;
    color: var(--mint);
    font-family: var(--mono);
    font-size: 0.78rem;
  }

  .step h3 {
    margin: 0 0 0.6rem;
    color: var(--text-white);
    font-family: var(--display);
    font-size: 1.12rem;
    font-weight: 640;
    letter-spacing: -0.02em;
  }

  .step p {
    margin: 0;
    color: var(--night-muted);
    font-size: 0.92rem;
    line-height: 1.62;
  }

  .step-code {
    display: block;
    margin-top: 1.05rem;
    padding: 0.65rem 0.9rem;
    border: 1px solid var(--night-border);
    border-radius: 8px;
    background: var(--night-soft);
    color: var(--text);
    font-family: var(--mono);
    font-size: 0.76rem;
    overflow-x: auto;
    white-space: nowrap;
  }

  /* ---------- What agents make ---------- */

  .makes {
    padding: 5.5rem 0;
    border-top: 1px solid var(--night-border);
  }

  .makes-header {
    max-width: 42rem;
    margin-bottom: 3.2rem;
  }

  .makes-header h2 {
    margin: 0 0 1rem;
    color: var(--text-white);
    font-family: var(--display);
    font-size: clamp(1.75rem, 3vw, 2.35rem);
    font-weight: 640;
    letter-spacing: -0.032em;
    line-height: 1.15;
    text-wrap: balance;
  }

  .makes-header p {
    margin: 0;
    color: var(--night-muted);
    font-size: 1.02rem;
    line-height: 1.62;
  }

  .makes-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.4rem 3.2rem;
  }

  .make {
    padding-top: 1.4rem;
    border-top: 1px solid var(--night-border);
  }

  .make h3 {
    margin: 0 0 0.5rem;
    color: var(--text-white);
    font-family: var(--display);
    font-size: 1.05rem;
    font-weight: 640;
    letter-spacing: -0.015em;
  }

  .make p {
    margin: 0;
    color: var(--night-muted);
    font-size: 0.94rem;
    line-height: 1.6;
  }

  /* ---------- Why HTML ---------- */

  .why {
    padding: 6rem 0;
    border-top: 1px solid var(--night-border);
  }

  .why h2 {
    max-width: 30ch;
    margin: 0 0 1.4rem;
    color: var(--text-white);
    font-family: var(--display);
    font-size: clamp(1.9rem, 3.4vw, 2.7rem);
    font-weight: 640;
    letter-spacing: -0.035em;
    line-height: 1.12;
    text-wrap: balance;
  }

  .why p {
    max-width: 40rem;
    margin: 0;
    color: var(--night-muted);
    font-size: 1.06rem;
    line-height: 1.65;
  }

  /* ---------- CTA ---------- */

  .cta {
    padding: 6rem 0 6.5rem;
    border-top: 1px solid var(--night-border);
    text-align: center;
  }

  .cta h2 {
    max-width: 26ch;
    margin: 0 auto 1rem;
    color: var(--text-white);
    font-family: var(--display);
    font-size: clamp(1.9rem, 3.4vw, 2.6rem);
    font-weight: 640;
    letter-spacing: -0.035em;
    line-height: 1.12;
    text-wrap: balance;
  }

  .cta-lede {
    max-width: 32rem;
    margin: 0 auto 2.1rem;
    color: var(--night-muted);
    font-size: 1.02rem;
    line-height: 1.6;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
    margin-bottom: 1.6rem;
  }

  .cta-note {
    margin: 0;
    color: var(--night-subtle);
    font-family: var(--mono);
    font-size: 0.74rem;
  }

  @media (max-width: 960px) {
    .steps {
      grid-template-columns: 1fr;
      gap: 2.4rem;
    }

    .makes-grid {
      grid-template-columns: 1fr;
      gap: 1.8rem;
    }

    .frame-body {
      padding: 1.7rem 1.5rem 1.9rem;
    }
  }

  @media (max-width: 720px) {
    .phone {
      position: static;
      width: min(15rem, 100%);
      margin: -1.5rem auto 0;
      transform: rotate(0deg);
    }

    .stage {
      margin-top: 3.5rem;
    }

    .frame-sync {
      display: none;
    }
  }

  /* ---------- Concept switcher (temporary, for design review) ---------- */

  .concept-switch {
    position: fixed;
    right: 1.1rem;
    bottom: 1.1rem;
    z-index: 60;
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.45rem;
    border: 1px solid var(--night-border-hover);
    border-radius: 999px;
    background: rgba(18, 18, 19, 0.92);
    backdrop-filter: blur(8px);
    font-family: var(--mono);
    font-size: 0.66rem;
  }

  .concept-switch span {
    margin-right: 0.4rem;
    color: var(--night-subtle);
    letter-spacing: 0.06em;
  }

  .concept-switch a {
    padding: 0.2rem 0.45rem;
    border-radius: 999px;
    color: var(--night-subtle);
    text-decoration: none;
  }

  .concept-switch a:hover,
  .concept-switch a:focus-visible {
    color: var(--text-white);
  }

  .concept-switch a[aria-current="page"] {
    background: var(--night-card-elevated);
    color: var(--mint);
  }
</style>
