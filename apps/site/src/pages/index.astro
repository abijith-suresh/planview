---
// biome-ignore lint/correctness/noUnusedImports: Astro uses this layout component below.
import SiteLayout from "../layouts/SiteLayout.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro uses this page value below.
import { appSignInUrl } from "../lib/app-url";
---

<SiteLayout
  title="plansplease | Keep the pages your agent makes"
  description="Run agent-made HTML locally, or keep a private cloud copy you can open again."
>
  <!-- Hero Section: The 30-Second Pitch -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title">
        Your agent made a page.
        <span>Keep it somewhere useful.</span>
      </h1>

      <p class="hero-intro">
        AI agents like Claude Code produce HTML because Markdown is too restrictive for rich specs,
        interactive tools, and PR reviews. plansplease solves the friction of seeing them: preview
        locally in milliseconds, or keep a private copy in your cloud workspace.
      </p>

      <div class="hero-actions">
        <a class="primary-link" href={appSignInUrl}>Continue with GitHub</a>
        <a class="secondary-link" href="/docs/">Read Docs</a>
      </div>

      <div class="command-box">
        <span class="command-prefix">$</span>
        <code>npm install --global @abijith-suresh/planview</code>
      </div>

      <p class="cta-note">Private cloud workspace. Local CLI included.</p>
    </div>

    <!-- Product Workflow Showcase: Claude Code -> plansplease -> Browser -->
    <div class="hero-showcase" role="img" aria-label="Claude Code generating an HTML file and plansplease opening it">
      <div class="terminal-card">
        <div class="window-bar">
          <div class="window-dots">
            <span></span><span></span><span></span>
          </div>
          <span class="window-title">Terminal — claude-code</span>
        </div>
        <div class="window-body terminal-text">
          <div class="terminal-line"><span class="t-dim">claude&gt;</span> Synthesized architecture into an interactive specification.</div>
          <div class="terminal-line"><span class="t-dim">claude&gt;</span> Written to <span class="t-file">./auth-migration-spec.html</span></div>
          <div class="terminal-spacer"></div>
          <div class="terminal-line"><span class="t-prompt">$</span> <span class="t-cmd">planview publish --open ./auth-migration-spec.html</span></div>
          <div class="terminal-line t-success">✓ Local daemon active on 127.0.0.1:4777</div>
          <div class="terminal-line t-success">✓ Browser opened: http://localhost:4777/auth-migration-spec</div>
        </div>
      </div>

      <div class="preview-card">
        <div class="window-bar">
          <div class="window-url">
            <span class="url-dot"></span>
            <code>localhost:4777 / auth-migration-spec</code>
          </div>
          <span class="preview-badge">Live Preview</span>
        </div>
        <div class="window-body preview-doc">
          <div class="doc-header">
            <div>
              <p class="doc-tag">Generated by Claude Code</p>
              <h2 class="doc-title">Auth Migration Plan & Verification</h2>
            </div>
            <span class="doc-pill">HTML5 + SVG</span>
          </div>

          <div class="doc-diagram">
            <div class="diagram-step">
              <span class="step-box">Client Request</span>
              <span class="step-arrow">→</span>
            </div>
            <div class="diagram-step">
              <span class="step-box highlight">Session Gate</span>
              <span class="step-arrow">→</span>
            </div>
            <div class="diagram-step">
              <span class="step-box">Encrypted Storage</span>
            </div>
          </div>

          <div class="doc-checklist">
            <div class="check-item"><span class="check-mark">✓</span> Single-file HTML runs without bundlers</div>
            <div class="check-item"><span class="check-mark">✓</span> Zero CORS friction via loopback daemon</div>
            <div class="check-item"><span class="check-mark">✓</span> Syncs to private cloud workspace with one command</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- The 3 Core Truths -->
  <section class="pillars-section" aria-labelledby="pillars-title">
    <div class="pillars-grid">
      <article class="pillar-card">
        <h3>Preview locally</h3>
        <p>
          Run <code>planview publish file.html</code> and get an instant localhost URL. Our background
          daemon serves assets with zero latency, solves local file CORS issues, and automatically
          opens your browser.
        </p>
      </article>

      <article class="pillar-card">
        <h3>Keep a cloud copy</h3>
        <p>
          Upload standalone files to your private cloud workspace. Revisit your agent's interactive
          specs, prototypes, and calculators long after the chat scrollback has moved on.
        </p>
      </article>

      <article class="pillar-card">
        <h3>One HTML file to start</h3>
        <p>
          No build steps, no bundlers, and no repo creation. Built for the sweet spot between a
          temporary agent prompt and a permanent repository. Pure standard HTML5.
        </p>
      </article>
    </div>
  </section>

  <!-- Why HTML for Agents? (Grounding in Claude Code philosophy) -->
  <section class="philosophy-section" aria-labelledby="philosophy-title">
    <div class="philosophy-header">
      <h2 id="philosophy-title">Markdown caps out at 100 lines. HTML carries the whole context.</h2>
      <p>
        AI engineering teams are switching from Markdown to HTML. When an agent needs to convey
        information humans actually read, HTML is unreasonably effective.
      </p>
    </div>

    <div class="usecase-grid">
      <div class="usecase-item">
        <h4>Interactive Specs & Plans</h4>
        <p>
          System architectures with visual SVG diagrams, collapsible details, and trade-off tables
          that colleagues will actually review.
        </p>
      </div>

      <div class="usecase-item">
        <h4>Annotated Code Reviews</h4>
        <p>
          Rendered pull request reviews with inline margin annotations, severity tags, and data-flow
          diagrams rather than walls of text.
        </p>
      </div>

      <div class="usecase-item">
        <h4>Throwaway Data Editors</h4>
        <p>
          Single-file tools to triage tickets, edit feature configs, or tune prompts—built with export
          buttons to feed results straight back to the agent.
        </p>
      </div>

      <div class="usecase-item">
        <h4>UI Prototypes & Sliders</h4>
        <p>
          Interactive mockups with sliders and controls to tune animation curves, layouts, and states
          before writing production code.
        </p>
      </div>
    </div>
  </section>

  <!-- Summary Pitch Bar required by test suite -->
  <section class="pitch-line" aria-label="plansplease summary">
    <div class="pitch-container">
      <p>
        For reports, prototypes, dashboards, and one-off pages your agent makes before they become a
        project.
      </p>
      <span class="pitch-badge">One HTML file to start.</span>
    </div>
  </section>

  <!-- Final High-Conversion CTA Banner -->
  <section class="cta-banner" aria-labelledby="cta-banner-title">
    <div class="cta-banner-content">
      <h2 id="cta-banner-title">Stop losing your agent's best work.</h2>
      <p>
        Give every interactive spec, prototype, and tool a permanent home. Start with your next
        prompt today.
      </p>
      <div class="cta-banner-actions">
        <a class="primary-link" href={appSignInUrl}>Continue with GitHub</a>
        <a class="secondary-link" href="/features/">Explore Features</a>
      </div>
      <p class="cta-banner-sub">Free during alpha • Zero setup required • Works offline</p>
    </div>
  </section>
</SiteLayout>

<style>
  /* Hero Layout: Focused 30-second pitch */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(28rem, 1.15fr);
    align-items: center;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    padding: clamp(3.5rem, 7vh, 5.5rem) 0 4rem;
  }

  h1 {
    margin: 0 0 1.25rem;
    color: var(--text-white);
    font-family: var(--display);
    font-size: clamp(2.6rem, 4.5vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.08;
    text-wrap: balance;
  }

  h1 span {
    display: block;
    color: var(--mint);
  }

  .hero-intro {
    max-width: 33rem;
    margin: 0 0 2rem;
    color: var(--night-muted);
    font-size: clamp(1.02rem, 1.25vw, 1.12rem);
    line-height: 1.65;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .primary-link {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem 1.65rem;
    border: 1px solid var(--mint);
    border-radius: 8px;
    background: var(--mint);
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: all 150ms ease;
  }

  .primary-link:hover,
  .primary-link:focus-visible {
    background: var(--mint-hover);
    border-color: var(--mint-hover);
  }

  .secondary-link {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem 1.4rem;
    border: 1px solid var(--night-border-hover);
    border-radius: 8px;
    background: var(--night-card);
    color: var(--text-white);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 150ms ease;
  }

  .secondary-link:hover,
  .secondary-link:focus-visible {
    border-color: var(--mint-border);
    color: var(--mint);
    background: var(--night-card-elevated);
  }

  .command-box {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.65rem 1rem;
    margin-bottom: 1.25rem;
    border: 1px solid var(--night-border);
    border-radius: 8px;
    background: var(--night-card);
    font-family: var(--mono);
    font-size: 0.82rem;
  }

  .command-prefix {
    color: var(--mint);
    font-weight: 600;
    user-select: none;
  }

  .command-box code {
    color: var(--text);
  }

  .cta-note {
    margin: 0;
    color: var(--night-subtle);
    font-size: 0.84rem;
    font-weight: 500;
  }

  /* Product Workflow Showcase */
  .hero-showcase {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .terminal-card,
  .preview-card {
    border: 1px solid var(--night-border);
    border-radius: 12px;
    background: var(--night-card);
    overflow: hidden;
  }

  .preview-card {
    border-color: var(--night-border-hover);
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.45);
  }

  .window-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 1rem;
    border-bottom: 1px solid var(--night-border);
    background: var(--night-soft);
  }

  .window-dots {
    display: flex;
    gap: 6px;
  }

  .window-dots span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--night-border-hover);
  }

  .window-title {
    color: var(--night-muted);
    font-size: 0.78rem;
    font-family: var(--mono);
  }

  .window-url {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .url-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--mint);
  }

  .window-url code {
    color: var(--text);
    font-size: 0.8rem;
    font-family: var(--mono);
  }

  .preview-badge {
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    background: var(--mint-soft);
    border: 1px solid var(--mint-border);
    color: var(--mint);
    font-size: 0.74rem;
    font-weight: 600;
  }

  .terminal-body {
    padding: 1rem 1.25rem;
    font-family: var(--mono);
    font-size: 0.8rem;
    line-height: 1.6;
    background: #08090b;
  }

  .terminal-line {
    color: var(--text);
  }

  .terminal-spacer {
    height: 0.5rem;
  }

  .t-dim {
    color: var(--night-subtle);
  }

  .t-file {
    color: var(--mint);
  }

  .t-prompt {
    color: var(--mint);
  }

  .t-cmd {
    color: var(--text-white);
    font-weight: 600;
  }

  .t-success {
    color: var(--mint);
  }

  .preview-doc {
    padding: 1.5rem;
    background: var(--night);
  }

  .doc-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--night-border);
  }

  .doc-tag {
    margin: 0 0 0.25rem;
    color: var(--mint);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .doc-title {
    margin: 0;
    color: var(--text-white);
    font-family: var(--display);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .doc-pill {
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--night-border);
    border-radius: 4px;
    background: var(--night-soft);
    color: var(--night-muted);
    font-size: 0.74rem;
  }

  .doc-diagram {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    padding: 1rem;
    border: 1px solid var(--night-border);
    border-radius: 8px;
    background: var(--night-card);
  }

  .diagram-step {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .step-box {
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--night-border-hover);
    border-radius: 6px;
    background: var(--night-soft);
    color: var(--text);
    font-size: 0.78rem;
    font-weight: 500;
  }

  .step-box.highlight {
    border-color: var(--mint-border);
    background: var(--mint-soft);
    color: var(--mint);
    font-weight: 600;
  }

  .step-arrow {
    color: var(--night-subtle);
    font-size: 0.85rem;
  }

  .doc-checklist {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .check-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--night-muted);
    font-size: 0.82rem;
  }

  .check-mark {
    color: var(--mint);
    font-weight: 700;
  }

  /* 3 Core Pillars */
  .pillars-section {
    padding: 3.5rem 0;
    border-top: 1px solid var(--night-border);
    border-bottom: 1px solid var(--night-border);
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.75rem;
  }

  .pillar-card {
    padding: 1.85rem;
    border: 1px solid var(--night-border);
    border-radius: 12px;
    background: var(--night-card);
  }

  .pillar-card h3 {
    margin: 0 0 0.75rem;
    color: var(--text-white);
    font-family: var(--display);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .pillar-card p {
    margin: 0;
    color: var(--night-muted);
    font-size: 0.94rem;
    line-height: 1.6;
  }

  /* Philosophy Section */
  .philosophy-section {
    padding: 4.5rem 0;
    border-bottom: 1px solid var(--night-border);
  }

  .philosophy-header {
    max-width: 44rem;
    margin-bottom: 3rem;
  }

  .philosophy-header h2 {
    margin: 0 0 1rem;
    color: var(--text-white);
    font-family: var(--display);
    font-size: clamp(1.8rem, 3.2vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  .philosophy-header p {
    margin: 0;
    color: var(--night-muted);
    font-size: 1.1rem;
    line-height: 1.6;
  }

  .usecase-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .usecase-item {
    padding: 1.75rem;
    border: 1px solid var(--night-border);
    border-radius: 10px;
    background: var(--night-card);
  }

  .usecase-item h4 {
    margin: 0 0 0.5rem;
    color: var(--text-white);
    font-family: var(--display);
    font-size: 1.1rem;
    font-weight: 700;
  }

  .usecase-item p {
    margin: 0;
    color: var(--night-muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  /* Pitch Bar */
  .pitch-line {
    padding: 3rem 0;
    border-bottom: 1px solid var(--night-border);
  }

  .pitch-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.85rem 2.25rem;
    border: 1px solid var(--night-border);
    border-radius: 12px;
    background: var(--night-soft);
  }

  .pitch-container p {
    max-width: 44rem;
    margin: 0;
    color: var(--text);
    font-size: 1.1rem;
    font-weight: 500;
    line-height: 1.5;
  }

  .pitch-badge {
    flex-shrink: 0;
    padding: 0.45rem 0.95rem;
    border: 1px solid var(--mint-border);
    border-radius: 6px;
    background: var(--mint-soft);
    color: var(--mint);
    font-size: 0.85rem;
    font-weight: 700;
  }

  /* CTA Banner */
  .cta-banner {
    padding: 4.5rem 0;
  }

  .cta-banner-content {
    padding: clamp(3rem, 5vw, 4rem) 2rem;
    border: 1px solid var(--night-border);
    border-radius: 14px;
    background: var(--night-card);
    text-align: center;
  }

  .cta-banner h2 {
    max-width: 24ch;
    margin: 0 auto 1rem;
    color: var(--text-white);
    font-family: var(--display);
    font-size: clamp(2rem, 3.4vw, 2.8rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.15;
  }

  .cta-banner p {
    max-width: 34rem;
    margin: 0 auto 2rem;
    color: var(--night-muted);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .cta-banner-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .cta-banner-sub {
    margin: 0;
    color: var(--night-subtle);
    font-size: 0.85rem;
    font-weight: 500;
  }

  /* Responsive */
  @media (max-width: 960px) {
    .hero {
      grid-template-columns: 1fr;
      padding: 3rem 0;
    }

    .hero-intro {
      max-width: 100%;
    }

    .pillars-grid,
    .usecase-grid {
      grid-template-columns: 1fr;
    }

    .pitch-container {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
