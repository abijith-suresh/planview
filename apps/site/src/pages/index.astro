---
// biome-ignore lint/correctness/noUnusedImports: Astro uses this layout component below.
import SiteLayout from "../layouts/SiteLayout.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro uses this page value below.
import { appSignInUrl } from "../lib/app-url";
---

<SiteLayout
  title="plansplease | Keep the pages your agent makes"
  description="Run agent-made HTML locally, or keep a private cloud copy you can open again."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="hero-status"><span class="status-dot" aria-hidden="true"></span>Free during alpha</p>

      <h1 id="hero-title">
        Your agent made a page.
        <span>Keep it somewhere useful.</span>
      </h1>

      <p class="hero-intro">
        Coding agents write rich HTML — specs, prototypes, small tools. plansplease gives each one
        a local URL in milliseconds, and a private cloud copy you can reopen long after the chat
        has moved on.
      </p>

      <div class="hero-actions">
        <a class="btn-primary" href={appSignInUrl}>Continue with GitHub</a>
        <a class="btn-ghost" href="/docs/">Read the docs</a>
      </div>

      <div class="install-row">
        <span class="install-prompt" aria-hidden="true">$</span>
        <code>npm install --global @abijith-suresh/planview</code>
      </div>
    </div>

    <div class="hero-visual" role="img" aria-label="A planview publish command serving an agent-made page at a local URL">
      <div class="preview-card">
        <div class="preview-bar">
          <span class="preview-dot" aria-hidden="true"></span>
          <code>localhost:4777/auth-migration-spec</code>
          <span class="preview-tag">Local</span>
        </div>
        <div class="preview-body">
          <p class="doc-kicker">Generated by Claude Code</p>
          <h2 class="doc-title">Auth Migration Plan &amp; Verification</h2>
          <div class="doc-flow">
            <span class="flow-node">Client request</span>
            <span class="flow-arrow" aria-hidden="true">→</span>
            <span class="flow-node is-active">Session gate</span>
            <span class="flow-arrow" aria-hidden="true">→</span>
            <span class="flow-node">Encrypted storage</span>
          </div>
          <ul class="doc-list">
            <li>Single-file HTML runs without bundlers</li>
            <li>Assets served over loopback, no CORS friction</li>
            <li>One command to keep a private cloud copy</li>
          </ul>
        </div>
      </div>
      <div class="publish-strip">
        <code>planview publish --open ./auth-migration-spec.html</code>
        <span class="strip-status"><span class="status-dot" aria-hidden="true"></span>Served at 127.0.0.1:4777</span>
      </div>
    </div>
  </section>

  <section class="pillars" aria-label="Core capabilities">
    <div class="pillar">
      <p class="pillar-index" aria-hidden="true">01</p>
      <h3>Preview locally</h3>
      <p>
        <code>planview publish file.html</code> returns a localhost URL instantly. A loopback daemon
        serves assets with zero latency, sidesteps file:// CORS limits, and opens your browser.
      </p>
    </div>

    <div class="pillar">
      <p class="pillar-index" aria-hidden="true">02</p>
      <h3>Keep a cloud copy</h3>
      <p>
        Upload standalone files to your private workspace. Interactive specs, prototypes, and
        calculators stay reachable long after the chat scrollback has moved on.
      </p>
    </div>

    <div class="pillar">
      <p class="pillar-index" aria-hidden="true">03</p>
      <h3>One HTML file to start</h3>
      <p>
        No build steps, no bundlers, no repo scaffolding. Built for the gap between a throwaway
        prompt and a permanent project. Pure standard HTML5.
      </p>
    </div>
  </section>

  <section class="philosophy" aria-labelledby="philosophy-title">
    <div class="philosophy-header">
      <p class="section-kicker">Why HTML</p>
      <h2 id="philosophy-title">Markdown caps out at 100 lines. HTML carries the whole context.</h2>
      <p>
        When an agent needs to show you something you can actually read — diagrams, trade-offs,
        clickable states — it reaches for HTML. plansplease is the shortest path from that output
        to a page you can open and keep.
      </p>
    </div>

    <div class="usecase-grid">
      <div class="usecase-item">
        <h4>Interactive specs &amp; plans</h4>
        <p>System diagrams, collapsible detail sections, and trade-off tables that colleagues will actually review.</p>
      </div>

      <div class="usecase-item">
        <h4>Annotated code reviews</h4>
        <p>Rendered PR reviews with inline annotations, severity tags, and data-flow diagrams instead of walls of text.</p>
      </div>

      <div class="usecase-item">
        <h4>Throwaway data editors</h4>
        <p>Single-file tools to triage tickets or tune prompts, with export buttons that feed results back to the agent.</p>
      </div>

      <div class="usecase-item">
        <h4>UI prototypes</h4>
        <p>Mockups with working sliders and states, so layout and interaction decisions happen before production code.</p>
      </div>
    </div>
  </section>

  <section class="pitch-line" aria-label="plansplease summary">
    <p>
      For reports, prototypes, dashboards, and one-off pages your agent makes before they become
      a project.
    </p>
    <span class="pitch-badge">One HTML file to start.</span>
  </section>

  <section class="cta" aria-labelledby="cta-title">
    <h2 id="cta-title">Stop losing your agent's best work.</h2>
    <p>
      Give every interactive spec, prototype, and tool a place to live. Start with your next
      prompt.
    </p>
    <div class="cta-actions">
      <a class="btn-primary" href={appSignInUrl}>Continue with GitHub</a>
      <a class="btn-ghost" href="/features/">Explore features</a>
    </div>
    <p class="cta-sub">Free during alpha · No setup required · Works offline</p>
  </section>
</SiteLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    align-items: center;
    gap: clamp(3rem, 6vw, 5rem);
    padding: clamp(4rem, 8vh, 6rem) 0 4.5rem;
  }

  .hero-status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 1.4rem;
    color: var(--night-muted);
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
  }

  .status-dot {
    flex-shrink: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--mint);
  }

  h1 {
    margin: 0 0 1.4rem;
    color: var(--text-white);
    font-family: var(--display);
    font-size: clamp(2.4rem, 4.6vw, 3.5rem);
    font-weight: 650;
    letter-spacing: -0.035em;
    line-height: 1.06;
    text-wrap: balance;
  }

  h1 span {
    display: block;
    color: var(--night-muted);
  }

  .hero-intro {
    max-width: 32rem;
    margin: 0 0 2.25rem;
    color: var(--night-muted);
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 1.75rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.68rem 1.3rem;
    border-radius: var(--radius);
    background: var(--text-white);
    color: var(--ink);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: background-color 140ms ease;
  }

  .btn-primary:hover,
  .btn-primary:focus-visible {
    background: #d4d4d8;
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    padding: 0.68rem 1.2rem;
    border: 1px solid var(--night-border-hover);
    border-radius: var(--radius);
    color: var(--text-white);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 140ms ease, background-color 140ms ease;
  }

  .btn-ghost:hover,
  .btn-ghost:focus-visible {
    border-color: #3d3d44;
    background: var(--night-card);
  }

  .install-row {
    display: inline-flex;
    align-items: baseline;
    gap: 0.7rem;
    padding: 0.6rem 0.95rem;
    border: 1px solid var(--night-border);
    border-radius: var(--radius);
    background: var(--night-soft);
    font-family: var(--mono);
    font-size: 0.8rem;
  }

  .install-prompt {
    color: var(--night-subtle);
    user-select: none;
  }

  .install-row code {
    color: var(--text);
  }

  .hero-visual {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .preview-card {
    border: 1px solid var(--night-border);
    border-radius: var(--radius-lg);
    background: var(--night-card);
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.4);
  }

  .preview-bar {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--night-border);
  }

  .preview-dot {
    flex-shrink: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--mint);
  }

  .preview-bar code {
    flex: 1;
    overflow: hidden;
    color: var(--night-muted);
    font-family: var(--mono);
    font-size: 0.78rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .preview-tag {
    flex-shrink: 0;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--mint-border);
    border-radius: 4px;
    background: var(--mint-soft);
    color: var(--mint);
    font-family: var(--mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .preview-body {
    padding: 1.5rem 1.6rem 1.6rem;
  }

  .doc-kicker {
    margin: 0 0 0.4rem;
    color: var(--night-subtle);
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .doc-title {
    margin: 0 0 1.35rem;
    color: var(--text-white);
    font-family: var(--display);
    font-size: 1.18rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .doc-flow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    padding: 1rem;
    border: 1px solid var(--night-border);
    border-radius: var(--radius);
    background: var(--night-soft);
  }

  .flow-node {
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--night-border-hover);
    border-radius: var(--radius-sm);
    color: var(--night-muted);
    font-size: 0.78rem;
    font-weight: 500;
  }

  .flow-node.is-active {
    border-color: var(--mint-border);
    background: var(--mint-soft);
    color: var(--mint);
  }

  .flow-arrow {
    color: var(--night-subtle);
    font-size: 0.8rem;
  }

  .doc-list {
    margin: 1.35rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .doc-list li {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    color: var(--night-muted);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .doc-list li::before {
    content: "✓";
    flex-shrink: 0;
    color: var(--mint);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .publish-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.65rem 1rem;
    border: 1px solid var(--night-border);
    border-radius: var(--radius);
    background: var(--night-soft);
  }

  .publish-strip code {
    overflow: hidden;
    color: var(--text);
    font-family: var(--mono);
    font-size: 0.76rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .strip-status {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.5rem;
    color: var(--night-muted);
    font-family: var(--mono);
    font-size: 0.72rem;
  }

  .pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding: 3.75rem 0;
    border-top: 1px solid var(--night-border);
    border-bottom: 1px solid var(--night-border);
  }

  .pillar {
    padding: 0 2.25rem;
  }

  .pillar:first-child {
    padding-left: 0;
  }

  .pillar:last-child {
    padding-right: 0;
  }

  .pillar + .pillar {
    border-left: 1px solid var(--night-border);
  }

  .pillar-index {
    margin: 0;
    color: var(--night-subtle);
    font-family: var(--mono);
    font-size: 0.75rem;
  }

  .pillar h3 {
    margin: 0.85rem 0 0.65rem;
    color: var(--text-white);
    font-family: var(--display);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .pillar p {
    margin: 0;
    color: var(--night-muted);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .pillar code {
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    background: var(--night-card-elevated);
    color: var(--text);
    font-family: var(--mono);
    font-size: 0.8em;
  }

  .philosophy {
    padding: 4.5rem 0;
    border-bottom: 1px solid var(--night-border);
  }

  .philosophy-header {
    max-width: 46rem;
    margin-bottom: 3.25rem;
  }

  .section-kicker {
    margin: 0 0 1rem;
    color: var(--night-subtle);
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .philosophy-header h2 {
    margin: 0 0 1.1rem;
    color: var(--text-white);
    font-family: var(--display);
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    font-weight: 650;
    letter-spacing: -0.028em;
    line-height: 1.18;
    text-wrap: balance;
  }

  .philosophy-header > p {
    margin: 0;
    color: var(--night-muted);
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .usecase-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.25rem 3rem;
  }

  .usecase-item {
    padding-top: 1.3rem;
    border-top: 1px solid var(--night-border);
  }

  .usecase-item h4 {
    margin: 0 0 0.45rem;
    color: var(--text-white);
    font-family: var(--display);
    font-size: 1rem;
    font-weight: 600;
  }

  .usecase-item p {
    margin: 0;
    color: var(--night-muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .pitch-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--night-border);
  }

  .pitch-line p {
    max-width: 44rem;
    margin: 0;
    color: var(--text);
    font-size: 1.08rem;
    font-weight: 450;
    line-height: 1.55;
  }

  .pitch-badge {
    flex-shrink: 0;
    color: var(--mint);
    font-family: var(--mono);
    font-size: 0.82rem;
  }

  .cta {
    padding: 5rem 0 5.5rem;
    text-align: center;
  }

  .cta h2 {
    max-width: 24ch;
    margin: 0 auto 1rem;
    color: var(--text-white);
    font-family: var(--display);
    font-size: clamp(1.9rem, 3.2vw, 2.5rem);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.12;
    text-wrap: balance;
  }

  .cta > p {
    max-width: 34rem;
    margin: 0 auto 2rem;
    color: var(--night-muted);
    font-size: 1.02rem;
    line-height: 1.6;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
    margin-bottom: 1.5rem;
  }

  .cta-sub {
    margin: 0;
    color: var(--night-subtle);
    font-size: 0.82rem;
  }

  @media (max-width: 960px) {
    .hero {
      grid-template-columns: 1fr;
      padding: 3.5rem 0 3rem;
    }

    .pillars {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 3rem 0;
    }

    .pillar {
      padding: 0;
    }

    .pillar + .pillar {
      padding-top: 2rem;
      border-left: 0;
      border-top: 1px solid var(--night-border);
    }

    .usecase-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .pitch-line {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
