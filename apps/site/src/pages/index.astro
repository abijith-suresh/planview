---
// biome-ignore lint/correctness/noUnusedImports: Astro uses this layout component below.
import SiteLayout from "../layouts/SiteLayout.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro uses this page value below.
import { appSignInUrl } from "../lib/app-url";
---

<SiteLayout
  title="plansplease | Keep the pages your agent makes"
  description="Run agent-made HTML locally, or keep a private cloud copy you can open again."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title">
        Your agent made a page.
        <span>Keep it somewhere useful.</span>
      </h1>
      <p class="hero-intro">
        plansplease turns standalone HTML into a page you can open. Preview it on your machine with
        the CLI, or keep a private copy in the cloud workspace when you need to come back to it.
      </p>
      <a class="primary-link" href={appSignInUrl}>Continue with GitHub</a>
      <p class="cta-note">Private cloud workspace. Local CLI included.</p>
    </div>

    <div class="hero-demo" role="img" aria-label="An HTML file becoming a page you can open">
      <div class="demo-header">
        <div class="demo-header-dots" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
        <div class="demo-header-tags">
          <span>html in</span>
          <span>page out</span>
        </div>
      </div>

      <div class="demo-source">
        <div class="demo-source-row">
          <span>file</span>
          <code>morning-plan.html</code>
        </div>
        <div class="demo-source-row demo-source-result">
          <span>local preview</span>
          <code>localhost:4173 / morning-plan</code>
        </div>
      </div>

      <div class="demo-page">
        <div class="demo-page-meta">
          <span>standalone HTML</span>
          <span>ready to open</span>
        </div>
        <div class="demo-page-rule"></div>
        <p class="demo-page-label">agent snapshot / 04 kb</p>
        <h2>Morning plan</h2>
        <p class="demo-page-copy">A useful page, saved before the chat moves on.</p>
        <div class="demo-page-data">
          <div><span>status</span><strong>ready</strong></div>
          <div><span>format</span><strong>HTML</strong></div>
          <div><span>where</span><strong>local or cloud</strong></div>
        </div>
      </div>

      <div class="demo-destinations">
        <div>
          <span>local</span>
          <strong>preview now</strong>
        </div>
        <div>
          <span>cloud</span>
          <strong>keep it</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="pitch-line" aria-label="plansplease summary">
    <p>
      For reports, prototypes, dashboards, and one-off pages your agent makes before they become a
      project.
    </p>
    <span>One HTML file to start.</span>
  </section>

  <section class="home-values" aria-labelledby="home-values-title">
    <h2 id="home-values-title">The useful parts stay small.</h2>

    <div class="home-value-list">
      <article class="home-value-row">
        <span class="home-value-number">01</span>
        <div>
          <h3>Preview locally</h3>
          <p>Run an HTML file through the CLI and get a localhost URL right away.</p>
        </div>
      </article>

      <article class="home-value-row">
        <span class="home-value-number">02</span>
        <div>
          <h3>Keep a cloud copy</h3>
          <p>Upload one standalone file to a private workspace and open it from anywhere.</p>
        </div>
      </article>

      <article class="home-value-row">
        <span class="home-value-number">03</span>
        <div>
          <h3>Make throwaway work useful</h3>
          <p>Save the report, prototype, or dashboard that is too useful to lose in a chat.</p>
        </div>
      </article>

      <article class="home-value-row">
        <span class="home-value-number">04</span>
        <div>
          <h3>Start with one file</h3>
          <p>There is no project setup to maintain before a page earns one.</p>
        </div>
      </article>
    </div>
  </section>
</SiteLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(24rem, 0.95fr);
    align-items: center;
    gap: clamp(3rem, 6vw, 6rem);
    padding: clamp(4.5rem, 9vh, 7rem) 0 5.5rem;
  }

  h1,
  h2,
  p {
    margin-top: 0;
  }

  h1,
  h2 {
    text-wrap: balance;
  }

  h1 {
    max-width: 12ch;
    margin-bottom: 1.5rem;
    color: var(--text);
    font-family: var(--display);
    font-size: clamp(3.2rem, 5.8vw, 5.8rem);
    font-weight: 600;
    letter-spacing: -0.06em;
    line-height: 0.95;
  }

  h1 span {
    display: block;
    color: var(--butter);
    background: linear-gradient(135deg, #fae392 0%, #f8abb6 60%, #c8b9f7 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-intro {
    max-width: 34rem;
    margin-bottom: 2.2rem;
    color: var(--night-muted);
    font-size: clamp(1rem, 1.35vw, 1.15rem);
    line-height: 1.65;
  }

  .primary-link {
    display: inline-flex;
    align-items: center;
    padding: 0.9rem 1.75rem;
    border: 1px solid var(--mint);
    border-radius: 9999px;
    background: var(--mint);
    color: var(--ink);
    font-size: 0.96rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    box-shadow: 0 4px 20px var(--mint-glow);
    transition: all 180ms ease;
  }

  .primary-link:hover,
  .primary-link:focus-visible {
    border-color: var(--text);
    background: var(--text);
    color: var(--ink);
    box-shadow: 0 6px 25px rgba(255, 255, 255, 0.25);
    transform: translateY(-2px);
  }

  .cta-note {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 1rem 0 0;
    color: var(--night-muted);
    font-size: 0.82rem;
  }

  .cta-note::before {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--mint);
    box-shadow: 0 0 8px var(--mint);
  }

  .hero-demo {
    padding: 1.25rem;
    background: var(--night-card);
    border: 1px solid rgba(200, 185, 247, 0.25);
    border-radius: 1.25rem;
    backdrop-filter: blur(20px);
    box-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.5), 0 0 32px -8px var(--lavender-glow);
    color: var(--text);
  }

  .demo-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 0.25rem 1rem;
  }

  .demo-header-dots {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .demo-header-dots span {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
  }

  .demo-header-dots span:nth-child(1) {
    background: var(--coral);
    opacity: 0.75;
  }

  .demo-header-dots span:nth-child(2) {
    background: var(--butter);
    opacity: 0.75;
  }

  .demo-header-dots span:nth-child(3) {
    background: var(--mint);
    opacity: 0.75;
  }

  .demo-header-tags {
    display: flex;
    gap: 0.75rem;
  }

  .demo-header-tags span {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--night-muted);
  }

  .demo-header-tags span:first-child {
    color: var(--lavender);
  }

  .demo-header-tags span:last-child {
    color: var(--mint);
  }

  .demo-page-meta,
  .demo-page-label,
  .demo-source-row,
  .demo-destinations span,
  .demo-destinations strong {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .demo-source {
    display: grid;
    gap: 0.5rem;
    padding: 1rem 1.15rem;
    background: rgba(12, 14, 20, 0.85);
    border: 1px solid var(--night-border);
    border-radius: 0.65rem;
    color: var(--text);
  }

  .demo-source-row {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
  }

  .demo-source-row > span {
    color: var(--lavender);
    opacity: 0.85;
  }

  .demo-source code {
    overflow: hidden;
    color: var(--mint);
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--mono);
    font-size: 0.78rem;
  }

  .demo-source-result > span {
    color: var(--butter);
  }

  .demo-source-result code {
    color: var(--butter);
  }

  .demo-page {
    margin: 1rem 0;
    padding: clamp(1.4rem, 3vw, 1.85rem);
    background: var(--night-card-elevated);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 0.85rem;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
  }

  .demo-page-meta {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .demo-page-meta span:first-child {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.55rem;
    border-radius: 9999px;
    background: rgba(143, 227, 201, 0.1);
    border: 1px solid rgba(143, 227, 201, 0.25);
    color: var(--mint);
  }

  .demo-page-meta span:last-child {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.55rem;
    border-radius: 9999px;
    background: rgba(200, 185, 247, 0.1);
    border: 1px solid rgba(200, 185, 247, 0.25);
    color: var(--lavender);
  }

  .demo-page-rule {
    height: 1px;
    margin: 1.15rem 0 1.5rem;
    background: linear-gradient(90deg, rgba(143, 227, 201, 0.35), rgba(200, 185, 247, 0.35), transparent);
  }

  .demo-page-label {
    margin-bottom: 0.5rem;
    color: var(--night-subtle);
    font-size: 0.7rem;
  }

  .demo-page h2 {
    margin-bottom: 0.5rem;
    color: var(--text);
    font-family: var(--display);
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.06em;
    line-height: 1;
  }

  .demo-page-copy {
    margin-bottom: 1.8rem;
    color: var(--night-muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .demo-page-data {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--night-border);
  }

  .demo-page-data div {
    display: grid;
    gap: 0.35rem;
    padding: 0.9rem 0.75rem 0 0;
  }

  .demo-page-data div + div {
    padding-left: 0.75rem;
    border-left: 1px solid var(--night-border);
  }

  .demo-page-data span {
    color: var(--night-muted);
    font-family: var(--mono);
    font-size: 0.64rem;
    text-transform: uppercase;
  }

  .demo-page-data strong {
    color: var(--text);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .demo-page-data div:first-child strong {
    color: var(--mint);
  }

  .demo-page-data div:nth-child(2) strong {
    color: var(--lavender);
  }

  .demo-page-data div:nth-child(3) strong {
    color: var(--butter);
  }

  .demo-destinations {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .demo-destinations > div {
    display: grid;
    gap: 0.35rem;
    padding: 0.9rem 1rem;
    border-radius: 0.65rem;
    transition: all 180ms ease;
  }

  .demo-destinations > div:first-child {
    background: rgba(143, 227, 201, 0.08);
    border: 1px solid rgba(143, 227, 201, 0.25);
  }

  .demo-destinations > div:first-child:hover {
    background: rgba(143, 227, 201, 0.14);
    box-shadow: 0 0 20px var(--mint-glow);
  }

  .demo-destinations > div:last-child {
    background: rgba(200, 185, 247, 0.08);
    border: 1px solid rgba(200, 185, 247, 0.25);
  }

  .demo-destinations > div:last-child:hover {
    background: rgba(200, 185, 247, 0.14);
    box-shadow: 0 0 20px var(--lavender-glow);
  }

  .demo-destinations span {
    color: var(--night-muted);
    font-size: 0.65rem;
  }

  .demo-destinations strong {
    font-size: 0.8rem;
    font-weight: 600;
  }

  .demo-destinations > div:first-child strong {
    color: var(--mint);
  }

  .demo-destinations > div:last-child strong {
    color: var(--lavender);
  }

  .pitch-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.75rem 2.25rem;
    margin: 1.5rem 0 5.5rem;
    background: var(--night-card);
    border: 1px solid var(--night-border);
    border-radius: 0.85rem;
    backdrop-filter: blur(12px);
    color: var(--night-muted);
  }

  .pitch-line p {
    max-width: 38rem;
    margin: 0;
    color: var(--text);
    font-size: 1.02rem;
    line-height: 1.6;
  }

  .pitch-line span {
    flex: 0 0 auto;
    padding: 0.45rem 0.95rem;
    background: rgba(250, 227, 146, 0.08);
    border: 1px solid rgba(250, 227, 146, 0.28);
    border-radius: 9999px;
    color: var(--butter);
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .home-values {
    padding: 0 0 6rem;
  }

  .home-values h2 {
    max-width: 12ch;
    margin: 0 0 2.2rem;
    color: var(--text);
    font-family: var(--display);
    font-size: clamp(2.4rem, 4.5vw, 4.5rem);
    font-weight: 600;
    letter-spacing: -0.06em;
    line-height: 1;
  }

  .home-value-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .home-value-row {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
    padding: 2.25rem 2rem;
    background: var(--night-card);
    border: 1px solid var(--night-border);
    border-radius: 0.85rem;
    backdrop-filter: blur(12px);
    transition: all 200ms ease;
  }

  .home-value-row:hover {
    background: var(--night-card-elevated);
    border-color: rgba(143, 227, 201, 0.35);
    box-shadow: 0 12px 30px -10px rgba(0, 0, 0, 0.4), 0 0 24px var(--mint-glow);
    transform: translateY(-2px);
  }

  .home-value-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.3rem;
    height: 2.3rem;
    border-radius: 9999px;
    background: rgba(250, 227, 146, 0.08);
    border: 1px solid rgba(250, 227, 146, 0.28);
    color: var(--butter);
    font-family: var(--mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .home-value-row:nth-child(2) .home-value-number {
    background: rgba(143, 227, 201, 0.08);
    border-color: rgba(143, 227, 201, 0.28);
    color: var(--mint);
  }

  .home-value-row:nth-child(3) .home-value-number {
    background: rgba(200, 185, 247, 0.08);
    border-color: rgba(200, 185, 247, 0.28);
    color: var(--lavender);
  }

  .home-value-row:nth-child(4) .home-value-number {
    background: rgba(248, 171, 182, 0.08);
    border-color: rgba(248, 171, 182, 0.28);
    color: var(--coral);
  }

  .home-value-row h3 {
    margin: 0 0 0.5rem;
    color: var(--text);
    font-family: var(--display);
    font-size: clamp(1.5rem, 2.5vw, 2.2rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1.1;
  }

  .home-value-row p {
    max-width: 38rem;
    margin: 0;
    color: var(--night-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }

    .hero-copy,
    .hero-demo {
      max-width: 42rem;
    }

    .home-value-list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .hero {
      gap: 3rem;
      padding: 4.5rem 0 3.5rem;
    }

    h1 {
      max-width: 11ch;
      font-size: clamp(3.2rem, 14vw, 4.8rem);
    }

    .hero-demo {
      padding: 1rem;
    }

    .demo-source-row {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    .demo-source-row + .demo-source-row {
      margin-top: 0.55rem;
    }

    .demo-page {
      padding: 1.25rem;
    }

    .demo-page h2 {
      font-size: 2.1rem;
    }

    .demo-page-data {
      grid-template-columns: 1fr;
    }

    .demo-page-data div,
    .demo-page-data div + div {
      grid-template-columns: 5rem 1fr;
      align-items: baseline;
      padding: 0.7rem 0;
      border-left: 0;
      border-bottom: 1px solid var(--night-border);
    }

    .demo-page-data div:last-child {
      border-bottom: 0;
    }

    .pitch-line {
      display: grid;
      gap: 1.25rem;
      padding: 1.5rem;
      margin-bottom: 3.5rem;
    }

    .home-values {
      padding-bottom: 4rem;
    }

    .home-value-row {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      gap: 1rem;
      padding: 1.5rem;
    }
  }
</style>
