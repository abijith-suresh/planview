---
// biome-ignore lint/correctness/noUnusedImports: Astro uses this layout component below.
import SiteLayout from "../layouts/SiteLayout.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro uses this page value below.
import { appSignInUrl } from "../lib/app-url";
---

<SiteLayout
  title="plansplease | Keep the pages your agent makes"
  description="Run agent-made HTML locally, or keep a private cloud copy you can open again."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title">
        Your agent made a page.
        <span>Keep it somewhere useful.</span>
      </h1>
      <p class="hero-intro">
        plansplease turns standalone HTML into a page you can open. Preview it on your machine with
        the CLI, or keep a private copy in the cloud workspace when you need to come back to it.
      </p>
      <a class="primary-link" href={appSignInUrl}>Continue with GitHub</a>
      <p class="cta-note">Private cloud workspace. Local CLI included.</p>
    </div>

    <div class="hero-demo" role="img" aria-label="An HTML file becoming a page you can open">
      <div class="demo-header">
        <div class="demo-header-dots" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
        <div class="demo-header-tags">
          <span>html in</span>
          <span>page out</span>
        </div>
      </div>

      <div class="demo-source">
        <div class="demo-source-row">
          <span>file</span>
          <code>morning-plan.html</code>
        </div>
        <div class="demo-source-row demo-source-result">
          <span>local preview</span>
          <code>localhost:4173 / morning-plan</code>
        </div>
      </div>

      <div class="demo-page">
        <div class="demo-page-meta">
          <span>standalone HTML</span>
          <span>ready to open</span>
        </div>
        <div class="demo-page-rule"></div>
        <p class="demo-page-label">agent snapshot / 04 kb</p>
        <h2>Morning plan</h2>
        <p class="demo-page-copy">A useful page, saved before the chat moves on.</p>
        <div class="demo-page-data">
          <div><span>status</span><strong>ready</strong></div>
          <div><span>format</span><strong>HTML</strong></div>
          <div><span>where</span><strong>local or cloud</strong></div>
        </div>
      </div>

      <div class="demo-destinations">
        <div>
          <span>local</span>
          <strong>preview now</strong>
        </div>
        <div>
          <span>cloud</span>
          <strong>keep it</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="pitch-line" aria-label="plansplease summary">
    <p>
      For reports, prototypes, dashboards, and one-off pages your agent makes before they become a
      project.
    </p>
    <span>One HTML file to start.</span>
  </section>

  <section class="home-values" aria-labelledby="home-values-title">
    <h2 id="home-values-title">The useful parts stay small.</h2>

    <div class="home-value-list">
      <article class="home-value-row">
        <span class="home-value-number">01</span>
        <div>
          <h3>Preview locally</h3>
          <p>Run an HTML file through the CLI and get a localhost URL right away.</p>
        </div>
      </article>

      <article class="home-value-row">
        <span class="home-value-number">02</span>
        <div>
          <h3>Keep a cloud copy</h3>
          <p>Upload one standalone file to a private workspace and open it from anywhere.</p>
        </div>
      </article>

      <article class="home-value-row">
        <span class="home-value-number">03</span>
        <div>
          <h3>Make throwaway work useful</h3>
          <p>Save the report, prototype, or dashboard that is too useful to lose in a chat.</p>
        </div>
      </article>

      <article class="home-value-row">
        <span class="home-value-number">04</span>
        <div>
          <h3>Start with one file</h3>
          <p>There is no project setup to maintain before a page earns one.</p>
        </div>
      </article>
    </div>
  </section>
</SiteLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(24rem, 0.95fr);
    align-items: center;
    gap: clamp(3rem, 6vw, 6rem);
    padding: clamp(4.5rem, 8vh, 6.5rem) 0 4.5rem;
  }

  h1,
  h2,
  p {
    margin-top: 0;
  }

  h1,
  h2 {
    text-wrap: balance;
  }

  h1 {
    max-width: 14ch;
    margin-bottom: 1.5rem;
    color: var(--text-white);
    font-family: var(--display);
    font-size: clamp(3rem, 5.4vw, 5.2rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1.05;
  }

  h1 span {
    display: block;
    color: var(--mint);
  }

  .hero-intro {
    max-width: 34rem;
    margin-bottom: 2rem;
    color: var(--night-muted);
    font-size: clamp(1rem, 1.3vw, 1.12rem);
    line-height: 1.65;
  }

  .primary-link {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem 1.6rem;
    border: 1px solid var(--mint);
    border-radius: 8px;
    background: var(--mint);
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: all 150ms ease;
  }

  .primary-link:hover,
  .primary-link:focus-visible {
    background: #a9ebd8;
    border-color: #a9ebd8;
    transform: translateY(-1px);
  }

  .cta-note {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 1rem 0 0;
    color: var(--night-muted);
    font-size: 0.82rem;
  }

  .cta-note::before {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--mint);
  }

  .hero-demo {
    padding: 1.25rem;
    background: var(--night-card);
    border: 1px solid var(--night-border);
    border-radius: 12px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
    color: var(--text);
  }

  .demo-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 0.25rem 0.85rem;
  }

  .demo-header-dots {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .demo-header-dots span {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
  }

  .demo-header-dots span:nth-child(1) {
    background: var(--coral);
  }

  .demo-header-dots span:nth-child(2) {
    background: var(--butter);
  }

  .demo-header-dots span:nth-child(3) {
    background: var(--mint);
  }

  .demo-header-tags {
    display: flex;
    gap: 0.75rem;
  }

  .demo-header-tags span {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .demo-header-tags span:first-child {
    color: var(--lavender);
  }

  .demo-header-tags span:last-child {
    color: var(--mint);
  }

  .demo-page-meta,
  .demo-page-label,
  .demo-source-row,
  .demo-destinations span,
  .demo-destinations strong {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .demo-source {
    display: grid;
    gap: 0.5rem;
    padding: 0.9rem 1.1rem;
    background: var(--night);
    border: 1px solid var(--night-border);
    border-radius: 8px;
    color: var(--text);
  }

  .demo-source-row {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
  }

  .demo-source-row > span {
    color: var(--lavender);
  }

  .demo-source code {
    overflow: hidden;
    color: var(--mint);
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--mono);
    font-size: 0.78rem;
  }

  .demo-source-result > span {
    color: var(--butter);
  }

  .demo-source-result code {
    color: var(--butter);
  }

  .demo-page {
    margin: 1rem 0;
    padding: clamp(1.4rem, 2.5vw, 1.75rem);
    background: var(--night-soft);
    border: 1px solid var(--night-border);
    border-radius: 8px;
  }

  .demo-page-meta {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .demo-page-meta span:first-child {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    background: var(--mint-soft);
    border: 1px solid var(--mint-border);
    color: var(--mint);
  }

  .demo-page-meta span:last-child {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    background: var(--lavender-soft);
    border: 1px solid var(--lavender-border);
    color: var(--lavender);
  }

  .demo-page-rule {
    height: 1px;
    margin: 1.15rem 0 1.35rem;
    background: var(--night-border);
  }

  .demo-page-label {
    margin-bottom: 0.4rem;
    color: var(--night-subtle);
    font-size: 0.7rem;
  }

  .demo-page h2 {
    margin-bottom: 0.4rem;
    color: var(--text-white);
    font-family: var(--display);
    font-size: clamp(1.8rem, 3.2vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1.05;
  }

  .demo-page-copy {
    margin-bottom: 1.6rem;
    color: var(--night-muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .demo-page-data {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--night-border);
  }

  .demo-page-data div {
    display: grid;
    gap: 0.3rem;
    padding: 0.85rem 0.75rem 0 0;
  }

  .demo-page-data div + div {
    padding-left: 0.75rem;
    border-left: 1px solid var(--night-border);
  }

  .demo-page-data span {
    color: var(--night-muted);
    font-family: var(--mono);
    font-size: 0.64rem;
    text-transform: uppercase;
  }

  .demo-page-data strong {
    color: var(--text-white);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .demo-page-data div:first-child strong {
    color: var(--mint);
  }

  .demo-page-data div:nth-child(2) strong {
    color: var(--lavender);
  }

  .demo-page-data div:nth-child(3) strong {
    color: var(--butter);
  }

  .demo-destinations {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .demo-destinations > div {
    display: grid;
    gap: 0.3rem;
    padding: 0.85rem 1rem;
    border-radius: 8px;
    transition: border-color 150ms ease;
  }

  .demo-destinations > div:first-child {
    background: var(--mint-soft);
    border: 1px solid var(--mint-border);
  }

  .demo-destinations > div:first-child:hover {
    border-color: var(--mint);
  }

  .demo-destinations > div:last-child {
    background: var(--lavender-soft);
    border: 1px solid var(--lavender-border);
  }

  .demo-destinations > div:last-child:hover {
    border-color: var(--lavender);
  }

  .demo-destinations span {
    color: var(--night-muted);
    font-size: 0.65rem;
  }

  .demo-destinations strong {
    font-size: 0.8rem;
    font-weight: 600;
  }

  .demo-destinations > div:first-child strong {
    color: var(--mint);
  }

  .demo-destinations > div:last-child strong {
    color: var(--lavender);
  }

  .pitch-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.5rem 2rem;
    margin: 1.5rem 0 5rem;
    background: var(--night-card);
    border: 1px solid var(--night-border);
    border-radius: 10px;
    color: var(--night-muted);
  }

  .pitch-line p {
    max-width: 38rem;
    margin: 0;
    color: var(--text);
    font-size: 1rem;
    line-height: 1.6;
  }

  .pitch-line span {
    flex: 0 0 auto;
    padding: 0.4rem 0.85rem;
    background: var(--butter-soft);
    border: 1px solid var(--butter-border);
    border-radius: 6px;
    color: var(--butter);
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .home-values {
    padding-bottom: 5.5rem;
  }

  .home-values h2 {
    max-width: 14ch;
    margin-bottom: 2rem;
    color: var(--text-white);
    font-family: var(--display);
    font-size: clamp(2.2rem, 3.8vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1.05;
  }

  .home-value-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .home-value-row {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1.75rem;
    background: var(--night-card);
    border: 1px solid var(--night-border);
    border-radius: 10px;
    transition: border-color 150ms ease;
  }

  .home-value-row:hover {
    border-color: var(--night-border-hover);
  }

  .home-value-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    flex-shrink: 0;
    background: var(--night-soft);
    border: 1px solid var(--night-border);
    border-radius: 6px;
    color: var(--mint);
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .home-value-row h3 {
    margin: 0 0 0.5rem;
    color: var(--text-white);
    font-family: var(--display);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .home-value-row p {
    margin: 0;
    color: var(--night-muted);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  @media (max-width: 58rem) {
    .hero {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .home-value-list {
      grid-template-columns: 1fr;
    }

    .pitch-line {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      padding: 1.5rem;
    }
  }

  @media (max-width: 36rem) {
    .demo-source-row {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    .demo-destinations {
      grid-template-columns: 1fr;
    }

    .demo-page-data {
      grid-template-columns: 1fr;
    }

    .demo-page-data div + div {
      padding-left: 0;
      border-left: none;
      border-top: 1px solid var(--night-border);
      padding-top: 0.75rem;
    }
  }
</style>
