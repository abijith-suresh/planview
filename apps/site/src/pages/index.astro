---
// biome-ignore lint/correctness/noUnusedImports: Astro uses this layout component below.
import SiteLayout from "../layouts/SiteLayout.astro";

// biome-ignore lint/complexity/useLiteralKeys: The site accepts an optional build-time environment variable.
const appUrl = process.env["PUBLIC_APP_URL"] ?? "https://app-staging-a39a.up.railway.app";
// biome-ignore lint/correctness/noUnusedVariables: Astro uses this value in the page template below.
const signInUrl = `${appUrl.replace(/\/$/, "")}/dashboard`;
---

<SiteLayout
  title="plansplease | Keep the pages your agent makes"
  description="Run agent-made HTML locally, or keep a private cloud copy you can open again."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title">
        Your agent made a page.
        <span>Keep it somewhere useful.</span>
      </h1>
      <p class="hero-intro">
        plansplease turns standalone HTML into a page you can open. Preview it on your machine with
        the CLI, or keep a private copy in the cloud when you need to come back to it.
      </p>
      <a class="primary-link" href={signInUrl}>Continue with GitHub</a>
      <p class="cta-note">Private cloud workspace. Local CLI included.</p>
    </div>

    <div class="hero-demo" role="img" aria-label="An HTML file becoming a page you can open">
      <div class="demo-header">
        <span>html in</span>
        <span>page out</span>
      </div>

      <div class="demo-source">
        <div class="demo-source-row">
          <span>file</span>
          <code>morning-plan.html</code>
        </div>
        <div class="demo-source-row demo-source-result">
          <span>local preview</span>
          <code>localhost:4173 / morning-plan</code>
        </div>
      </div>

      <div class="demo-page">
        <div class="demo-page-meta">
          <span>standalone HTML</span>
          <span>ready to open</span>
        </div>
        <div class="demo-page-rule"></div>
        <p class="demo-page-label">agent snapshot / 04 kb</p>
        <h2>Morning plan</h2>
        <p class="demo-page-copy">A useful page, saved before the chat moves on.</p>
        <div class="demo-page-data">
          <div><span>status</span><strong>ready</strong></div>
          <div><span>format</span><strong>HTML</strong></div>
          <div><span>where</span><strong>local or cloud</strong></div>
        </div>
      </div>

      <div class="demo-destinations">
        <div>
          <span>local</span>
          <strong>preview now</strong>
        </div>
        <div>
          <span>cloud</span>
          <strong>keep it</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="pitch-line" aria-label="plansplease summary">
    <p>
      For reports, prototypes, dashboards, and one-off pages your agent makes before they become a
      project.
    </p>
    <span>One HTML file to start.</span>
  </section>

  <section class="home-values" aria-labelledby="home-values-title">
    <h2 id="home-values-title">The useful parts stay small.</h2>

    <div class="home-value-list">
      <article class="home-value-row">
        <span class="home-value-number">01</span>
        <div>
          <h3>Preview locally</h3>
          <p>Run an HTML file through the CLI and get a localhost URL right away.</p>
        </div>
      </article>

      <article class="home-value-row">
        <span class="home-value-number">02</span>
        <div>
          <h3>Keep a cloud copy</h3>
          <p>Upload one standalone file to a private workspace and open it from anywhere.</p>
        </div>
      </article>

      <article class="home-value-row">
        <span class="home-value-number">03</span>
        <div>
          <h3>Make throwaway work useful</h3>
          <p>Save the report, prototype, or dashboard that is too useful to lose in a chat.</p>
        </div>
      </article>

      <article class="home-value-row">
        <span class="home-value-number">04</span>
        <div>
          <h3>Start with one file</h3>
          <p>There is no project setup to maintain before a page earns one.</p>
        </div>
      </article>
    </div>
  </section>
</SiteLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(26rem, 0.9fr);
    align-items: center;
    gap: clamp(3rem, 7vw, 7rem);
    padding: clamp(4.5rem, 10vh, 7.5rem) 0 5.5rem;
  }

  h1,
  h2,
  p {
    margin-top: 0;
  }

  h1,
  h2 {
    text-wrap: balance;
  }

  h1 {
    max-width: 11ch;
    margin-bottom: 1.8rem;
    color: var(--text);
    font-family: var(--display);
    font-size: clamp(3.5rem, 5.9vw, 6.2rem);
    font-weight: 600;
    letter-spacing: -0.075em;
    line-height: 0.91;
  }

  h1 span {
    display: block;
    color: var(--butter);
  }

  .hero-intro {
    max-width: 34rem;
    margin-bottom: 2rem;
    color: var(--night-muted);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    line-height: 1.6;
  }

  .primary-link {
    display: inline-block;
    padding: 0.9rem 1.05rem;
    border: 1px solid var(--mint);
    border-radius: 0.35rem;
    background: var(--mint);
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 180ms ease, border-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .primary-link:hover,
  .primary-link:focus-visible {
    border-color: var(--text);
    background: var(--text);
    color: var(--ink);
    transform: translateY(-2px);
  }

  .cta-note {
    margin: 0.85rem 0 0;
    color: var(--night-muted);
    font-size: 0.78rem;
  }

  .hero-demo {
    padding: 1.2rem;
    background: var(--lavender);
    border-radius: 1rem 1rem 3.5rem 1rem;
    color: var(--ink);
  }

  .demo-header,
  .demo-page-meta,
  .demo-page-label,
  .demo-source-row,
  .demo-destinations span,
  .demo-destinations strong {
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .demo-header {
    display: flex;
    justify-content: space-between;
    padding: 0 0.2rem 1rem;
    color: var(--ink);
  }

  .demo-source {
    display: grid;
    gap: 0.4rem;
    padding: 1rem;
    background: var(--night-soft);
    color: var(--text);
  }

  .demo-source-row {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
  }

  .demo-source-row > span {
    color: var(--night-muted);
  }

  .demo-source code {
    overflow: hidden;
    color: var(--mint);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .demo-source-result code {
    color: var(--butter);
  }

  .demo-page {
    margin: 0 1.2rem;
    padding: clamp(1.35rem, 3vw, 2rem);
    background: var(--paper);
    box-shadow: 0 1.5rem 2.5rem rgba(29, 29, 45, 0.16);
  }

  .demo-page-meta {
    display: flex;
    justify-content: space-between;
    color: var(--night-soft);
  }

  .demo-page-rule {
    height: 1px;
    margin: 1.25rem 0 2rem;
    background: rgba(40, 38, 56, 0.2);
  }

  .demo-page-label {
    margin-bottom: 0.6rem;
    color: var(--night-soft);
  }

  .demo-page h2 {
    margin-bottom: 0.55rem;
    color: var(--ink);
    font-family: var(--display);
    font-size: clamp(2.2rem, 4vw, 3.8rem);
    font-weight: 600;
    letter-spacing: -0.075em;
    line-height: 0.95;
  }

  .demo-page-copy {
    margin-bottom: 2rem;
    color: #686176;
    font-size: 0.9rem;
  }

  .demo-page-data {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid rgba(40, 38, 56, 0.2);
  }

  .demo-page-data div {
    display: grid;
    gap: 0.4rem;
    padding: 1rem 0.8rem 0 0;
  }

  .demo-page-data div + div {
    padding-left: 0.8rem;
    border-left: 1px solid rgba(40, 38, 56, 0.2);
  }

  .demo-page-data span {
    color: #686176;
    font-family: var(--mono);
    font-size: 0.6rem;
    text-transform: uppercase;
  }

  .demo-page-data strong {
    color: var(--ink);
    font-size: 0.77rem;
    font-weight: 600;
  }

  .demo-destinations {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
    margin-top: 1rem;
  }

  .demo-destinations > div {
    display: grid;
    gap: 0.35rem;
    padding: 0.85rem;
  }

  .demo-destinations > div:first-child {
    background: var(--mint);
  }

  .demo-destinations > div:last-child {
    background: var(--coral);
  }

  .demo-destinations span,
  .demo-destinations strong {
    color: var(--ink);
  }

  .demo-destinations strong {
    font-size: 0.74rem;
    font-weight: 500;
  }

  .pitch-line {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.5rem 0 5rem;
    border-top: 1px solid rgba(247, 240, 229, 0.18);
    color: var(--night-muted);
  }

  .pitch-line p {
    max-width: 38rem;
    margin: 0;
    font-size: 0.95rem;
  }

  .pitch-line span {
    flex: 0 0 auto;
    color: var(--butter);
    font-family: var(--mono);
    font-size: 0.68rem;
    text-transform: uppercase;
  }

  .home-values {
    padding: 0 0 6rem;
  }

  .home-values h2 {
    max-width: 12ch;
    margin: 0 0 2rem;
    color: var(--text);
    font-family: var(--display);
    font-size: clamp(2.4rem, 4.5vw, 4.8rem);
    font-weight: 600;
    letter-spacing: -0.075em;
    line-height: 0.94;
  }

  .home-value-list {
    border-top: 1px solid rgba(247, 240, 229, 0.18);
  }

  .home-value-row {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: 2rem;
    padding: 1.65rem 0;
    border-bottom: 1px solid rgba(247, 240, 229, 0.18);
  }

  .home-value-number {
    padding-top: 0.3rem;
    color: var(--butter);
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
  }

  .home-value-row h3 {
    margin: 0 0 0.35rem;
    color: var(--text);
    font-family: var(--display);
    font-size: clamp(1.65rem, 3vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.06em;
    line-height: 1;
  }

  .home-value-row p {
    max-width: 38rem;
    margin: 0;
    color: var(--night-muted);
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 4rem;
    }

    .hero-copy,
    .hero-demo {
      max-width: 42rem;
    }
  }

  @media (max-width: 620px) {
    .hero {
      gap: 3rem;
      padding: 4.5rem 0 3.5rem;
    }

    h1 {
      max-width: 10ch;
      font-size: clamp(3.35rem, 15vw, 5rem);
    }

    .hero-demo {
      padding: 0.8rem;
      border-radius: 0.75rem 0.75rem 2.5rem 0.75rem;
    }

    .demo-source-row {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    .demo-source-row + .demo-source-row {
      margin-top: 0.55rem;
    }

    .demo-page {
      margin: 0 0.7rem;
      padding: 1.1rem;
    }

    .demo-page h2 {
      font-size: 2.35rem;
    }

    .demo-page-data {
      grid-template-columns: 1fr;
    }

    .demo-page-data div,
    .demo-page-data div + div {
      grid-template-columns: 5rem 1fr;
      align-items: baseline;
      padding: 0.7rem 0;
      border-left: 0;
      border-bottom: 1px solid rgba(40, 38, 56, 0.2);
    }

    .demo-page-data div:last-child {
      border-bottom: 0;
    }

    .pitch-line {
      display: grid;
      gap: 1rem;
      padding-bottom: 3.5rem;
    }

    .home-values {
      padding-bottom: 4rem;
    }

    .home-value-row {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      gap: 0.75rem;
    }
  }
</style>
