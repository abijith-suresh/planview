---
// biome-ignore lint/correctness/noUnusedImports: Astro uses this layout component below.
import SiteLayout from "../layouts/SiteLayout.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro uses this page value below.
import { appSignInUrl } from "../lib/app-url";
---

<SiteLayout
  title="plansplease | Keep the pages your agent makes"
  description="Run agent-made HTML locally, or keep a private cloud copy you can open again."
>
  <!-- Hero Section -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <div class="hero-badge">
        <span class="hero-badge-dot"></span>
        <span>The Workspace for Agent Web Artifacts</span>
      </div>

      <h1 id="hero-title">
        Your agent made a page.
        <span>Keep it somewhere useful.</span>
      </h1>

      <p class="hero-intro">
        plansplease turns standalone HTML into a living page you can open instantly. Preview it on
        your machine with the zero-config CLI, or keep a private cloud copy in your cloud workspace
        so your agent's best work never disappears when the chat thread closes.
      </p>

      <div class="hero-actions">
        <a class="primary-link" href={appSignInUrl}>Continue with GitHub</a>
        <a class="secondary-link" href="/features/">Explore Features</a>
      </div>

      <p class="cta-note">Private cloud workspace. Local CLI included.</p>
    </div>

    <!-- Living Artifact Canvas: Modern Interactive Product Interface (Anti-Terminal) -->
    <div class="hero-showcase" role="img" aria-label="An interactive artifact preview in the plansplease workspace">
      <div class="artifact-frame">
        <!-- Frame Navigation Header -->
        <div class="artifact-header">
          <div class="artifact-meta">
            <span class="artifact-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
              </svg>
            </span>
            <span class="artifact-filename">executive-metrics.html</span>
          </div>

          <div class="artifact-status-pill">
            <span class="status-live-indicator"></span>
            <span>Live Preview</span>
          </div>

          <div class="artifact-actions">
            <span class="action-pill">Interactive</span>
            <span class="action-pill accent">Local: 4777</span>
          </div>
        </div>

        <!-- Simulated Living Web Application Artifact -->
        <div class="artifact-body">
          <div class="artifact-app-bar">
            <div>
              <p class="app-category-label">Interactive Sensitivity Model</p>
              <h2 class="app-title">Q3 Expansion & Retention Dynamics</h2>
            </div>
            <div class="app-scenario-tags">
              <span class="scenario-tag active">Base Case</span>
              <span class="scenario-tag">Accelerated</span>
              <span class="scenario-tag">Stress Test</span>
            </div>
          </div>

          <!-- Key Metrics Grid -->
          <div class="artifact-metrics">
            <div class="metric-card">
              <span class="metric-label">Net Retention Rate</span>
              <div class="metric-row">
                <span class="metric-value">128.4%</span>
                <span class="metric-trend positive">+14.2%</span>
              </div>
              <span class="metric-caption">Top-decile cohort trajectory</span>
            </div>

            <div class="metric-card">
              <span class="metric-label">Capital Efficiency</span>
              <div class="metric-row">
                <span class="metric-value">1.48x</span>
                <span class="metric-trend positive">Optimal</span>
              </div>
              <span class="metric-caption">Magic number benchmarking</span>
            </div>

            <div class="metric-card">
              <span class="metric-label">Cash Runway</span>
              <div class="metric-row">
                <span class="metric-value">32 mo</span>
                <span class="metric-trend neutral">Stable</span>
              </div>
              <span class="metric-caption">Post-round plan buffer</span>
            </div>
          </div>

          <!-- Interactive Visualization Preview -->
          <div class="artifact-chart-preview">
            <div class="chart-header">
              <span>Quarterly Trajectory Analysis</span>
              <span class="chart-legend">Model generated by AI Agent • 100% Client-side JS</span>
            </div>
            <div class="chart-bars" aria-hidden="true">
              <div class="bar-col"><div class="bar-fill" style="height: 48%;"></div><span>Q1</span></div>
              <div class="bar-col"><div class="bar-fill" style="height: 64%;"></div><span>Q2</span></div>
              <div class="bar-col"><div class="bar-fill" style="height: 78%;"></div><span>Q3</span></div>
              <div class="bar-col"><div class="bar-fill highlighted" style="height: 94%;"></div><span>Q4 (Forecast)</span></div>
            </div>
          </div>
        </div>

        <!-- Frame Footer / Inspector -->
        <div class="artifact-footer">
          <div class="footer-meta-item">
            <span class="meta-dot"></span>
            <span>Local Daemon Active</span>
          </div>
          <div class="footer-meta-item">
            <span>Encrypted Cloud Vault Ready</span>
          </div>
          <div class="footer-meta-item">
            <span class="link-label">Zero build steps • Pure HTML5</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Problem & Narrative Section: The Chat Graveyard -->
  <section class="narrative-section" aria-labelledby="narrative-title">
    <div class="narrative-header">
      <span class="section-tag">The Problem</span>
      <h2 id="narrative-title">The chat transcript is a graveyard for great software.</h2>
      <p>
        AI agents generate breathtaking interactive tools, dashboards, simulators, and prototypes in
        seconds. But chat interfaces were built for conversation, not software lifecycle.
      </p>
    </div>

    <div class="contrast-grid">
      <div class="contrast-card problem">
        <span class="contrast-badge">Without plansplease</span>
        <h3>The Lost Artifact Trap</h3>
        <ul class="contrast-list">
          <li>Code gets buried in deep chat scrollbacks and deleted by context compaction.</li>
          <li>Downloaded HTML files rot in your <code>Downloads/</code> folder without context.</li>
          <li>Local file opens suffer from CORS restrictions and broken relative assets.</li>
          <li>Spinning up a full repository and deployment pipeline takes longer than prompting the tool.</li>
        </ul>
      </div>

      <div class="contrast-card solution">
        <span class="contrast-badge accent">With plansplease</span>
        <h3>The Living Artifact Canvas</h3>
        <ul class="contrast-list">
          <li>One command or MCP call immediately spins up a zero-latency loopback preview.</li>
          <li>One-click cloud sync archives your interactive tools into an organized personal vault.</li>
          <li>Full support for multi-asset folders, scripts, charts, Canvas, and Tailwind CDN.</li>
          <li>No git branches, no bundler setups, and no server configuration required.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Core Capabilities Section -->
  <section class="capabilities-section" aria-labelledby="capabilities-title">
    <div class="section-heading-centered">
      <span class="section-tag">Core Superpowers</span>
      <h2 id="capabilities-title">Everything you need to keep your agent's work.</h2>
      <p class="section-subtitle">
        A seamless bridge between ephemeral AI agent generation and permanent, accessible software.
      </p>
    </div>

    <div class="capabilities-grid">
      <article class="capability-card">
        <div class="capability-icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
          </svg>
        </div>
        <h3>Preview locally</h3>
        <p>
          Run an HTML file through the CLI and get a localhost URL right away. Our lightweight
          daemon manages port binding, serves raw assets with zero latency, and opens directly in
          your default browser.
        </p>
        <span class="capability-subtext">Instant loopback • 0ms cold start</span>
      </article>

      <article class="capability-card">
        <div class="capability-icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"></path>
          </svg>
        </div>
        <h3>Keep a cloud copy</h3>
        <p>
          Upload one standalone file to a private workspace and open it from anywhere. Your
          dashboards, calculators, and reports remain permanently accessible in your encrypted
          dashboard long after the agent chat ends.
        </p>
        <span class="capability-subtext">Encrypted vault • GitHub authentication</span>
      </article>

      <article class="capability-card">
        <div class="capability-icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
            <polyline points="2 17 12 22 22 17"></polyline>
            <polyline points="2 12 12 17 22 12"></polyline>
          </svg>
        </div>
        <h3>Agent & MCP Native</h3>
        <p>
          Integrate plansplease directly into Cursor, Claude Desktop, or autonomous agent loops.
          Agents can publish live prototypes and tools autonomously while they plan and execute.
        </p>
        <span class="capability-subtext">Model Context Protocol • Headless CLI</span>
      </article>

      <article class="capability-card">
        <div class="capability-icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
        </div>
        <h3>Pure Web Standards</h3>
        <p>
          No proprietary bundler lock-in. Full native support for standard HTML5, SVG, Canvas,
          WebGL, inline Tailwind, React/Vue CDN bundles, and multi-file asset folders.
        </p>
        <span class="capability-subtext">Zero lock-in • 100% Standard Web</span>
      </article>
    </div>
  </section>

  <!-- Summary Pitch Bar required by test suite -->
  <section class="pitch-line" aria-label="plansplease summary">
    <div class="pitch-container">
      <p>
        For reports, prototypes, dashboards, and one-off pages your agent makes before they become a
        project.
      </p>
      <span class="pitch-badge">One HTML file to start.</span>
    </div>
  </section>

  <!-- Workflow Steps: How It Works -->
  <section class="workflow-section" aria-labelledby="workflow-title">
    <div class="section-heading-centered">
      <span class="section-tag">How It Works</span>
      <h2 id="workflow-title">From prompt to living software in three steps.</h2>
    </div>

    <div class="workflow-steps">
      <div class="workflow-step">
        <div class="step-badge">1</div>
        <h3>Prompt & Generate</h3>
        <p>
          Ask your favorite AI model (Claude, Cursor, ChatGPT, Gemini) to craft an interactive
          tool, simulation, or data report.
        </p>
      </div>

      <div class="workflow-step">
        <div class="step-badge">2</div>
        <h3>Publish in Milliseconds</h3>
        <p>
          Pass the generated HTML to the CLI or let the agent call the plansplease MCP tool
          directly. A localhost preview opens immediately.
        </p>
      </div>

      <div class="workflow-step">
        <div class="step-badge">3</div>
        <h3>Vault in Cloud Workspace</h3>
        <p>
          Sync the artifact to your private cloud workspace. Revisit, inspect, or share it anytime
          without maintaining a single server.
        </p>
      </div>
    </div>
  </section>

  <!-- Real-World Use Cases Grid -->
  <section class="use-cases-section" aria-labelledby="usecases-title">
    <div class="section-heading-centered">
      <span class="section-tag">Versatility</span>
      <h2 id="usecases-title">What creators keep with plansplease.</h2>
    </div>

    <div class="use-cases-grid">
      <div class="use-case-card">
        <h3>Interactive Financial & ROI Simulators</h3>
        <p>
          Complex dynamic calculators, amortization schedules, and sensitivity models generated in a
          single conversation.
        </p>
      </div>

      <div class="use-case-card">
        <h3>Rapid Product & UI Prototypes</h3>
        <p>
          Interactive mockups to test user flow and ergonomics before investing in engineering
          tickets and production code.
        </p>
      </div>

      <div class="use-case-card">
        <h3>Deep Research Syntheses</h3>
        <p>
          Rich visual reports featuring collapsible sections, interactive sorting tables, source
          citations, and live charts.
        </p>
      </div>

      <div class="use-case-card">
        <h3>Single-Purpose Utilities</h3>
        <p>
          Data converters, regex debuggers, JSON transformers, and schema inspectors built on the fly
          for one specific task.
        </p>
      </div>
    </div>
  </section>

  <!-- Final High-Conversion CTA Banner -->
  <section class="cta-banner" aria-labelledby="cta-banner-title">
    <div class="cta-banner-content">
      <h2 id="cta-banner-title">Stop losing your agent's best work.</h2>
      <p>
        Give every interactive tool, dashboard, and prototype a permanent home. Start with your
        next prompt today.
      </p>
      <div class="cta-banner-actions">
        <a class="primary-link" href={appSignInUrl}>Continue with GitHub</a>
        <a class="secondary-link" href="/docs/">Read Documentation</a>
      </div>
      <p class="cta-banner-sub">Free during alpha • Zero setup required • Works offline</p>
    </div>
  </section>
</SiteLayout>

<style>
  /* Hero Layout */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(25rem, 1fr);
    align-items: center;
    gap: clamp(3rem, 5vw, 5rem);
    padding: clamp(4rem, 8vh, 6.5rem) 0 4.5rem;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.35rem 0.95rem;
    margin-bottom: 1.5rem;
    border: 1px solid var(--night-border-hover);
    border-radius: 9999px;
    background: var(--night-card);
    color: var(--mint);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .hero-badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--mint);
    box-shadow: 0 0 8px var(--mint);
  }

  h1 {
    margin: 0 0 1.5rem;
    color: var(--text-white);
    font-family: var(--display);
    font-size: clamp(2.8rem, 4.8vw, 4.4rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1.08;
    text-wrap: balance;
  }

  h1 span {
    display: block;
    color: var(--mint);
  }

  .hero-intro {
    max-width: 35rem;
    margin: 0 0 2rem;
    color: var(--night-muted);
    font-size: clamp(1.05rem, 1.3vw, 1.16rem);
    line-height: 1.65;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .primary-link {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem 1.65rem;
    border: 1px solid var(--mint);
    border-radius: 10px;
    background: var(--mint);
    color: var(--ink);
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(143, 227, 201, 0.25);
    transition: all 160ms ease;
  }

  .primary-link:hover,
  .primary-link:focus-visible {
    background: var(--mint-hover);
    border-color: var(--mint-hover);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(143, 227, 201, 0.35);
  }

  .secondary-link {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem 1.45rem;
    border: 1px solid var(--night-border-hover);
    border-radius: 10px;
    background: var(--night-card);
    color: var(--text);
    font-size: 0.98rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 160ms ease;
  }

  .secondary-link:hover,
  .secondary-link:focus-visible {
    background: var(--night-card-elevated);
    border-color: var(--iris-border);
    color: var(--text-white);
  }

  .cta-note {
    margin: 0;
    color: var(--night-subtle);
    font-size: 0.86rem;
    font-weight: 500;
  }

  /* Living Artifact Showcase Component (Modern Web Interface) */
  .hero-showcase {
    position: relative;
    width: 100%;
  }

  .artifact-frame {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--night-border);
    border-radius: 16px;
    background: var(--night-card);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.06);
    overflow: hidden;
  }

  .artifact-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1.25rem;
    border-bottom: 1px solid var(--night-border);
    background: var(--night-soft);
  }

  .artifact-meta {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--text);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .artifact-icon {
    display: flex;
    align-items: center;
    color: var(--iris);
  }

  .artifact-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    background: var(--mint-soft);
    border: 1px solid var(--mint-border);
    color: var(--mint);
    font-size: 0.78rem;
    font-weight: 600;
  }

  .status-live-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--mint);
  }

  .artifact-actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .action-pill {
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    border: 1px solid var(--night-border);
    background: var(--night-card);
    color: var(--night-muted);
    font-size: 0.76rem;
    font-weight: 500;
  }

  .action-pill.accent {
    color: var(--butter);
    border-color: var(--butter-border);
    background: var(--butter-soft);
  }

  /* Artifact Body (Live Simulation of Generated Tool) */
  .artifact-body {
    padding: 1.5rem;
    background: var(--night);
  }

  .artifact-app-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--night-border);
  }

  .app-category-label {
    margin: 0 0 0.25rem;
    color: var(--iris);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .app-title {
    margin: 0;
    color: var(--text-white);
    font-family: var(--display);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .app-scenario-tags {
    display: flex;
    gap: 0.4rem;
  }

  .scenario-tag {
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    border: 1px solid var(--night-border);
    background: var(--night-card);
    color: var(--night-muted);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .scenario-tag.active {
    background: var(--night-border-hover);
    color: var(--text-white);
    border-color: var(--text-white);
  }

  /* Key Metrics Cards inside artifact */
  .artifact-metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.85rem;
    margin-bottom: 1.25rem;
  }

  .metric-card {
    padding: 0.85rem 1rem;
    border: 1px solid var(--night-border);
    border-radius: 10px;
    background: var(--night-card);
  }

  .metric-label {
    display: block;
    color: var(--night-muted);
    font-size: 0.75rem;
    font-weight: 500;
    margin-bottom: 0.35rem;
  }

  .metric-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .metric-value {
    color: var(--text-white);
    font-family: var(--display);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .metric-trend {
    font-size: 0.75rem;
    font-weight: 600;
  }

  .metric-trend.positive {
    color: var(--mint);
  }

  .metric-trend.neutral {
    color: var(--iris);
  }

  .metric-caption {
    display: block;
    color: var(--night-subtle);
    font-size: 0.7rem;
  }

  /* Data Visualization Simulation */
  .artifact-chart-preview {
    padding: 1rem 1.25rem;
    border: 1px solid var(--night-border);
    border-radius: 10px;
    background: var(--night-card);
  }

  .chart-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    font-size: 0.8rem;
    color: var(--text);
    font-weight: 600;
  }

  .chart-legend {
    color: var(--night-subtle);
    font-size: 0.72rem;
    font-weight: normal;
  }

  .chart-bars {
    display: flex;
    align-items: flex-end;
    gap: 1.5rem;
    height: 70px;
    padding-top: 0.5rem;
  }

  .bar-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    height: 100%;
    justify-content: flex-end;
  }

  .bar-fill {
    width: 100%;
    border-radius: 4px 4px 0 0;
    background: var(--night-border-hover);
    transition: all 200ms ease;
  }

  .bar-fill.highlighted {
    background: var(--mint);
  }

  .bar-col span {
    color: var(--night-muted);
    font-size: 0.72rem;
  }

  /* Artifact Frame Footer */
  .artifact-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.25rem;
    border-top: 1px solid var(--night-border);
    background: var(--night-soft);
    color: var(--night-muted);
    font-size: 0.78rem;
  }

  .footer-meta-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .meta-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--mint);
  }

  .link-label {
    color: var(--iris);
    font-weight: 500;
  }

  /* Narrative / Problem Section */
  .narrative-section {
    padding: 5rem 0;
    border-bottom: 1px solid var(--night-border);
  }

  .narrative-header {
    max-width: 44rem;
    margin-bottom: 3.5rem;
  }

