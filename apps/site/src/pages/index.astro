---
// biome-ignore lint/correctness/noUnusedVariables: Astro template references this value below.
const baseUrl = import.meta.env.BASE_URL;
// biome-ignore lint/correctness/noUnusedVariables: Astro template references this value below.
// biome-ignore lint/complexity/useLiteralKeys: The site accepts an optional build-time environment variable.
const appUrl = process.env["PUBLIC_APP_URL"] ?? "https://app.plansplease.dev";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="plansplease gives the small HTML pages your coding agents make a place to open, locally or in your cloud workspace."
    />
    <meta name="theme-color" content="#f3f2ed" />
    <link rel="icon" href={`${baseUrl}favicon.svg`} type="image/svg+xml" />
    <title>plansplease | A small home for agent-made HTML</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href={baseUrl} aria-label="plansplease home">
          <span class="brand-name">plansplease</span>
        </a>

        <nav aria-label="Main navigation">
          <a href="#how-it-works">How it works</a>
          <a class="nav-link" href={appUrl}>Open workspace</a>
        </nav>
      </header>

      <main id="main-content" tabindex="-1">
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-copy">
            <h1 id="hero-title">
              Your agent made a page.
              <span>Keep it somewhere.</span>
            </h1>
            <p class="hero-intro">
              plansplease gives the small HTML pages your coding agents make a place to open again.
              Run them on localhost with the CLI, or keep one in your cloud workspace.
            </p>
            <a class="primary-link" href={appUrl}>Open the workspace</a>
            <p class="scope-note">For now, the cloud accepts one HTML file at a time.</p>
          </div>

          <div class="hero-visual" role="img" aria-label="A single HTML page ready to read">
            <div class="visual-topline">
              <span>sample page</span>
              <span>html</span>
            </div>
            <div class="page-sheet">
              <div class="page-meta">
                <span>morning-plan.html</span>
                <span>04 kb</span>
              </div>
              <div class="page-address">localhost:4173 / morning-plan</div>
              <div class="page-rule"></div>
              <p class="page-kicker">monday / 08:30</p>
              <h2>Morning plan</h2>
              <p class="page-description">A little room to figure out what comes next.</p>
              <div class="page-list">
                <div class="page-row">
                  <span class="row-number">01</span>
                  <span>Make coffee before opening tabs</span>
                  <span class="row-state">done</span>
                </div>
                <div class="page-row">
                  <span class="row-number">02</span>
                  <span>Read the useful bits of yesterday</span>
                  <span class="row-state">next</span>
                </div>
                <div class="page-row">
                  <span class="row-number">03</span>
                  <span>Leave space for one good idea</span>
                  <span class="row-state">later</span>
                </div>
              </div>
              <div class="page-footer">
                <span>ready to read</span>
                <span>plansplease</span>
              </div>
            </div>
          </div>
        </section>

        <section class="plain-statement" aria-labelledby="statement-title">
          <span class="section-number">01</span>
          <div>
            <h2 id="statement-title">Put the page somewhere you can open it.</h2>
            <p>
              That is the whole job. The local CLI gives an HTML file a localhost address. The web
              workspace gives you a place to upload one when the page needs to leave your machine.
            </p>
          </div>
        </section>

        <section class="workflow-section" id="how-it-works" aria-labelledby="workflow-title">
          <div class="section-heading">
            <span class="section-number">02</span>
            <h2 id="workflow-title">Keep the loop short.</h2>
          </div>

          <div class="workflow-list">
            <div class="workflow-row">
              <span class="workflow-number">01</span>
              <div>
                <h3>Make the HTML</h3>
                <p>Your agent writes the file. You do not need a project around it.</p>
              </div>
              <code>page.html</code>
            </div>
            <div class="workflow-row">
              <span class="workflow-number">02</span>
              <div>
                <h3>Run it locally</h3>
                <p>Use the CLI to publish a localhost snapshot and open it in your browser.</p>
              </div>
              <code>localhost</code>
            </div>
            <div class="workflow-row">
              <span class="workflow-number">03</span>
              <div>
                <h3>Keep one in the cloud</h3>
                <p>Upload the file to your account when a local link is not enough.</p>
              </div>
              <code>your workspace</code>
            </div>
          </div>
        </section>

        <section class="runtime-section" aria-labelledby="runtime-title">
          <div class="runtime-intro">
            <span class="section-number">03</span>
            <div>
              <h2 id="runtime-title">Local when you are building. Cloud when you need a link.</h2>
              <p>Same small file. Pick the place that fits the moment.</p>
            </div>
          </div>

          <div class="runtime-grid">
            <article class="runtime-column runtime-local">
              <h3>On your machine</h3>
              <p>Keep the page close while your agent is working.</p>
              <code class="runtime-command">plansplease publish page.html</code>
              <span class="runtime-result">localhost:4173 / snapshot</span>
            </article>
            <article class="runtime-column runtime-cloud">
              <h3>In your workspace</h3>
              <p>Upload one HTML file and open it from another device.</p>
              <a class="text-link" href={appUrl}>Open the cloud workspace</a>
              <span class="runtime-result">one file / your account</span>
            </article>
          </div>
        </section>

        <section class="closing-section" aria-labelledby="closing-title">
          <h2 id="closing-title">Start with one file.</h2>
          <p>No gallery. No feed. Just a place for the page you want to read again.</p>
          <a class="primary-link" href={appUrl}>Open the workspace</a>
        </section>
      </main>

      <footer class="site-footer">
        <a class="brand footer-brand" href={baseUrl} aria-label="plansplease home">
          <span class="brand-name">plansplease</span>
        </a>
        <p>One HTML file at a time.</p>
        <p>Local CLI / cloud workspace</p>
      </footer>
    </div>
  </body>
</html>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..700&family=IBM+Plex+Mono:wght@400;500&display=swap");

  :root {
    --paper: #f3f2ed;
    --paper-light: #fbfaf6;
    --ink: #282638;
    --muted: #6d6a76;
    --line: #d9d7d0;
    --plum: #75638c;
    --plum-dark: #59486e;
    --lavender: #d4cde7;
    --sage: #bfd4ca;
    --apricot: #eac5b0;
    --pollen: #e3dca8;
    --blue: #c8dbe0;
    --sans: "Bricolage Grotesque", "Trebuchet MS", sans-serif;
    --mono: "IBM Plex Mono", "SFMono-Regular", "Cascadia Code", monospace;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    overflow-x: hidden;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 1rem;
    line-height: 1.55;
  }

  a {
    color: inherit;
  }

  .site-shell {
    width: min(calc(100% - 3rem), 76rem);
    margin: 0 auto;
  }

  .skip-link {
    position: fixed;
    z-index: 20;
    top: 1rem;
    left: 1rem;
    padding: 0.7rem 1rem;
    background: var(--ink);
    color: var(--paper-light);
    font-size: 0.85rem;
    text-decoration: none;
    transform: translateY(-200%);
    transition: transform 180ms ease;
  }

  .skip-link:focus-visible {
    outline: 3px solid var(--plum);
    outline-offset: 3px;
    transform: translateY(0);
  }

  .site-header {
    display: flex;
    min-height: 5.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    border-bottom: 1px solid var(--line);
  }

  .brand {
    text-decoration: none;
  }

  .brand-name {
    font-size: 1.15rem;
    font-weight: 650;
    letter-spacing: -0.065em;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    color: var(--muted);
    font-size: 0.85rem;
  }

  nav a,
  .text-link {
    text-decoration: none;
    transition: color 180ms ease, border-color 180ms ease;
  }

  nav a:hover,
  nav a:focus-visible,
  .text-link:hover,
  .text-link:focus-visible {
    color: var(--plum-dark);
  }

  .nav-link,
  .text-link {
    border-bottom: 1px solid currentColor;
  }

  .hero {
    display: grid;
    min-height: 43rem;
    grid-template-columns: minmax(0, 0.95fr) minmax(25rem, 0.85fr);
    align-items: center;
    gap: clamp(3rem, 8vw, 8rem);
    padding: clamp(5rem, 10vw, 8.5rem) 0;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1,
  h2,
  h3 {
    letter-spacing: -0.065em;
    line-height: 0.98;
  }

  h1 {
    max-width: 9ch;
    margin-bottom: 2rem;
    font-size: clamp(4rem, 8.6vw, 8rem);
    font-weight: 600;
  }

  h1 span {
    display: block;
    color: var(--plum);
  }

  .hero-intro {
    max-width: 31rem;
    margin-bottom: 2rem;
    color: var(--muted);
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    line-height: 1.55;
  }

  .primary-link {
    display: inline-block;
    padding-bottom: 0.25rem;
    border-bottom: 2px solid var(--plum);
    color: var(--ink);
    font-size: 1rem;
    font-weight: 650;
    text-decoration: none;
    transition: color 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .primary-link:hover,
  .primary-link:focus-visible {
    border-color: var(--plum-dark);
    background: var(--lavender);
    color: var(--plum-dark);
  }

  .scope-note {
    max-width: 22rem;
    margin: 2.5rem 0 0;
    padding-left: 0.8rem;
    border-left: 2px solid var(--sage);
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.68rem;
    line-height: 1.6;
  }

  .hero-visual {
    position: relative;
    padding: 1.1rem;
    background: var(--pollen);
    border-radius: 1.25rem 1.25rem 4rem 1.25rem;
  }

  .visual-topline,
  .page-meta,
  .page-address,
  .page-footer,
  .page-kicker,
  .row-state,
  .section-number,
  .workflow-number,
  .runtime-result {
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .visual-topline {
    display: flex;
    justify-content: space-between;
    padding: 0.15rem 0.35rem 1rem;
    color: var(--plum-dark);
  }

  .page-sheet {
    min-height: 28rem;
    padding: clamp(1.35rem, 4vw, 2.5rem);
    border: 1px solid rgba(40, 38, 56, 0.16);
    border-radius: 0.6rem;
    background: var(--paper-light);
    box-shadow: 0 1.5rem 3rem rgba(40, 38, 56, 0.12);
  }

  .page-meta,
  .page-footer {
    display: flex;
    justify-content: space-between;
    color: var(--muted);
  }

  .page-address {
    overflow: hidden;
    margin-top: 2.6rem;
    color: var(--plum);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .page-rule {
    height: 1px;
    margin: 1rem 0 2.2rem;
    background: var(--line);
  }

  .page-kicker {
    margin-bottom: 0.65rem;
    color: var(--muted);
  }

  .page-sheet h2 {
    margin-bottom: 0.55rem;
    font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: 600;
  }

  .page-description {
    margin-bottom: 2rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .page-list {
    border-top: 1px solid var(--line);
  }

  .page-row {
    display: grid;
    grid-template-columns: 2rem 1fr auto;
    gap: 0.7rem;
    align-items: center;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-size: 0.78rem;
  }

  .row-number,
  .row-state {
    color: var(--muted);
  }

  .row-state {
    color: var(--plum);
  }

  .page-footer {
    padding-top: 1.3rem;
  }

  .plain-statement {
    display: grid;
    grid-template-columns: 4rem minmax(0, 42rem);
    gap: 2rem;
    padding: 5.5rem 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .section-number,
  .workflow-number {
    color: var(--plum);
  }

  .plain-statement h2,
  .section-heading h2,
  .runtime-intro h2 {
    margin-bottom: 1.2rem;
    font-size: clamp(2.6rem, 5.5vw, 5.2rem);
    font-weight: 550;
  }

  .plain-statement p,
  .runtime-intro p {
    max-width: 35rem;
    margin-bottom: 0;
    color: var(--muted);
    font-size: 1.05rem;
  }

  .workflow-section {
    padding: 8rem 0;
  }

  .section-heading {
    display: grid;
    grid-template-columns: 4rem minmax(0, 42rem);
    gap: 2rem;
    align-items: start;
    margin-bottom: 3.5rem;
  }

  .workflow-list {
    border-top: 1px solid var(--line);
  }

  .workflow-row {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) minmax(8rem, 0.55fr);
    gap: 2rem;
    align-items: center;
    padding: 1.7rem 0;
    border-bottom: 1px solid var(--line);
  }

  .workflow-row h3 {
    margin-bottom: 0.35rem;
    font-size: 1.45rem;
    font-weight: 600;
  }

  .workflow-row p {
    max-width: 31rem;
    margin-bottom: 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .workflow-row code,
  .runtime-command {
    color: var(--plum-dark);
    font-family: var(--mono);
    font-size: 0.7rem;
  }

  .workflow-row code {
    justify-self: end;
  }

  .runtime-section {
    padding: 5rem 0 8rem;
  }

  .runtime-intro {
    display: grid;
    grid-template-columns: 4rem minmax(0, 46rem);
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .runtime-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .runtime-column {
    min-height: 19rem;
    padding: 2.2rem;
  }

  .runtime-local {
    background: var(--blue);
  }

  .runtime-cloud {
    background: var(--lavender);
  }

  .runtime-column h3 {
    margin-bottom: 0.7rem;
    font-size: 1.8rem;
    font-weight: 600;
  }

  .runtime-column p {
    max-width: 20rem;
    min-height: 3.2rem;
    margin-bottom: 1.8rem;
    color: var(--plum-dark);
    font-size: 0.95rem;
  }

  .runtime-command {
    display: block;
    overflow-x: auto;
    width: fit-content;
    max-width: 100%;
    padding: 0.75rem 0.9rem;
    background: rgba(251, 250, 246, 0.66);
    color: var(--ink);
    white-space: nowrap;
  }

  .runtime-column .text-link {
    display: inline-block;
    margin-bottom: 1rem;
    color: var(--ink);
    font-weight: 600;
  }

  .runtime-result {
    display: block;
    margin-top: 1.8rem;
    color: var(--plum-dark);
  }

  .closing-section {
    padding: 7rem 0 8rem;
    border-top: 1px solid var(--line);
  }

  .closing-section h2 {
    max-width: 8ch;
    margin-bottom: 1.2rem;
    font-size: clamp(3.5rem, 8vw, 7.5rem);
    font-weight: 600;
  }

  .closing-section p {
    max-width: 25rem;
    margin-bottom: 2rem;
    color: var(--muted);
  }

  .site-footer {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1rem;
    align-items: center;
    min-height: 5.5rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.75rem;
  }

  .footer-brand {
    color: var(--ink);
  }

  .site-footer p {
    margin: 0;
    text-align: center;
  }

  .site-footer p:last-child {
    text-align: right;
  }

  :focus-visible {
    outline: 3px solid var(--plum);
    outline-offset: 4px;
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 4rem;
    }

    .hero-copy {
      max-width: 42rem;
    }

    .hero-visual {
      max-width: 42rem;
    }
  }

  @media (max-width: 620px) {
    .site-shell {
      width: min(calc(100% - 2rem), 76rem);
    }

    .site-header {
      min-height: 4.75rem;
    }

    nav {
      gap: 0.8rem;
      font-size: 0.76rem;
    }

    nav > a:first-child {
      display: none;
    }

    .hero {
      min-height: 0;
      padding: 4.5rem 0 5rem;
    }

    h1 {
      font-size: clamp(3.7rem, 17vw, 6rem);
    }

    .hero-visual {
      padding: 0.8rem;
      border-radius: 1rem 1rem 3rem 1rem;
    }

    .page-sheet {
      min-height: 25rem;
      padding: 1.1rem;
    }

    .page-address {
      margin-top: 2rem;
    }

    .page-rule {
      margin-bottom: 1.7rem;
    }

    .page-sheet h2 {
      font-size: 2.5rem;
    }

    .page-row {
      grid-template-columns: 1.7rem 1fr;
      font-size: 0.72rem;
    }

    .row-state {
      grid-column: 2;
      font-size: 0.58rem;
    }

    .plain-statement,
    .section-heading,
    .runtime-intro {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .plain-statement {
      padding: 4rem 0;
    }

    .workflow-section {
      padding: 5.5rem 0;
    }

    .workflow-row {
      grid-template-columns: 2.2rem 1fr;
      gap: 1rem;
      padding: 1.4rem 0;
    }

    .workflow-row code {
      grid-column: 2;
      justify-self: start;
    }

    .runtime-section {
      padding: 3rem 0 5.5rem;
    }

    .runtime-grid {
      grid-template-columns: 1fr;
    }

    .runtime-column {
      min-height: 0;
      padding: 1.7rem;
    }

    .runtime-column p {
      min-height: 0;
    }

    .closing-section {
      padding: 5.5rem 0 6rem;
    }

    .site-footer {
      grid-template-columns: 1fr;
      gap: 0.55rem;
      padding: 1.4rem 0;
    }

    .site-footer p,
    .site-footer p:last-child {
      text-align: left;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>
