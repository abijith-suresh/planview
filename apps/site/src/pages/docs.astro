---
// biome-ignore lint/correctness/noUnusedImports: Astro renders this layout below.
import SiteLayout from "../layouts/SiteLayout.astro";
import { documentationUrl } from "../lib/docs-url";
// biome-ignore lint/correctness/noUnusedVariables: Astro uses this public docs URL below.
const canonical = documentationUrl("");
---

<SiteLayout title="Docs | plansplease" description="Guides for local previews, cloud documents, and MCP agents." activePath="docs" canonical={canonical}>
  <section class="page-heading" aria-labelledby="docs-title">
    <div>
      <h1 id="docs-title">Docs for a small tool.</h1>
      <p>Choose a workflow, follow the setup guide, and find the current limits in the documentation.</p>
    </div>
    <a class="page-action" href={canonical}>Open the documentation</a>
  </section>
  <p class="page-note">Cloud files have public URLs during alpha. Start with non-sensitive test content.</p>
</SiteLayout>
