---
// biome-ignore lint/correctness/noUnusedImports: Astro uses this layout component below.
import SiteLayout from "../layouts/SiteLayout.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro uses this page value below.
import { appSignInUrl } from "../lib/app-url";
---

<SiteLayout
  title="Pricing | plansplease"
  description="plansplease pricing is still being worked out. The alpha is free while the product takes shape."
  activePath="pricing"
>
  <section class="page-heading" aria-labelledby="pricing-title">
    <div>
      <h1 id="pricing-title">Simple for now. Clear about later.</h1>
      <p>
        The alpha is free while we learn what people actually need. There is no billing or paid
        plan yet.
      </p>
    </div>
    <a class="page-action" href={appSignInUrl}>Try the alpha</a>
  </section>

  <section class="content-section" aria-labelledby="plans-title">
    <h2 id="plans-title">A placeholder for the real choice.</h2>

    <div class="pricing-grid">
      <article class="pricing-card pricing-card-current">
        <p class="pricing-label">Available now</p>
        <h2>Alpha</h2>
        <p class="pricing-price">$0 <span>while testing</span></p>
        <p>Everything in the current staging workspace, with sensible limits while we test it.</p>
        <ul>
          <li>Local CLI previews</li>
          <li>Private cloud uploads</li>
          <li>One standalone HTML file at a time</li>
        </ul>
      </article>

      <article class="pricing-card">
        <p class="pricing-label">Planned</p>
        <h2>Premium</h2>
        <p class="pricing-price">$5 <span>per month, maybe</span></p>
        <p>
          The working idea is to charge for the things that cost more to keep around, not for basic
          access.
        </p>
        <ul>
          <li>More storage and longer retention</li>
          <li>Bundled assets and page folders in the cloud</li>
          <li>More control over hosted pages</li>
        </ul>
      </article>
    </div>

    <p class="page-note">
      The $5 figure is a placeholder, not a promise. We will publish actual limits and billing
      details before taking payment.
    </p>
  </section>
</SiteLayout>

<style>
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: rgba(247, 240, 229, 0.18);
  }

  .pricing-card {
    min-height: 24rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: var(--night-soft);
  }

  .pricing-card-current {
    background: var(--paper);
    color: var(--ink);
  }

  .pricing-label {
    margin: 0 0 2rem;
    color: var(--butter);
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .pricing-card-current .pricing-label {
    color: #777047;
  }

  .pricing-card h2 {
    margin: 0 0 0.8rem;
    font-family: var(--display);
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 600;
    letter-spacing: -0.075em;
    line-height: 0.95;
  }

  .pricing-price {
    margin: 0 0 1.25rem;
    color: var(--mint);
    font-family: var(--display);
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 600;
    letter-spacing: -0.07em;
    line-height: 1;
  }

  .pricing-card-current .pricing-price {
    color: #527b6d;
  }

  .pricing-price span {
    display: block;
    margin-top: 0.45rem;
    color: var(--night-muted);
    font-family: var(--mono);
    font-size: 0.65rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .pricing-card-current .pricing-price span,
  .pricing-card-current > p:not(.pricing-label):not(.pricing-price) {
    color: #686176;
  }

  .pricing-card > p:not(.pricing-label):not(.pricing-price) {
    max-width: 28rem;
    min-height: 3.5rem;
    margin: 0;
    color: var(--night-muted);
  }

  .pricing-card ul {
    display: grid;
    gap: 0.55rem;
    margin: 2rem 0 0;
    padding: 1rem 0 0 1.2rem;
    border-top: 1px solid rgba(247, 240, 229, 0.18);
    color: var(--text);
  }

  .pricing-card-current ul {
    border-color: rgba(40, 38, 56, 0.18);
    color: var(--ink);
  }

  @media (max-width: 620px) {
    .pricing-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
