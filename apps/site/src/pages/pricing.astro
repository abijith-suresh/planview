---
// biome-ignore lint/correctness/noUnusedImports: Astro uses this layout component below.
import SiteLayout from "../layouts/SiteLayout.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro uses this page value below.
import { appSignInUrl } from "../lib/app-url";
---

<SiteLayout
  title="Pricing | plansplease"
  description="plansplease pricing is still being worked out. The alpha is free while the product takes shape."
  activePath="pricing"
>
  <section class="page-heading" aria-labelledby="pricing-title">
    <div>
      <h1 id="pricing-title">Simple for now. Clear about later.</h1>
      <p>
        The alpha is free while we learn what people actually need. There is no billing or paid
        plan yet.
      </p>
    </div>
    <a class="page-action" href={appSignInUrl}>Try the alpha</a>
  </section>

  <section class="content-section" aria-labelledby="plans-title">
    <h2 id="plans-title">A placeholder for the real choice.</h2>

    <div class="pricing-grid">
      <article class="pricing-card pricing-card-current">
        <p class="pricing-label">Available now</p>
        <h2>Alpha</h2>
        <p class="pricing-price">$0 <span>while testing</span></p>
        <p>Everything in the current staging workspace, with sensible limits while we test it.</p>
        <ul>
          <li>Local CLI previews</li>
          <li>Private cloud uploads</li>
          <li>One standalone HTML file at a time</li>
        </ul>
      </article>

      <article class="pricing-card">
        <p class="pricing-label">Planned</p>
        <h2>Premium</h2>
        <p class="pricing-price">$5 <span>per month, maybe</span></p>
        <p>
          The working idea is to charge for the things that cost more to keep around, not for basic
          access.
        </p>
        <ul>
          <li>More storage and longer retention</li>
          <li>Bundled assets and page folders in the cloud</li>
          <li>More control over hosted pages</li>
        </ul>
      </article>
    </div>

    <p class="page-note">
      The $5 figure is a placeholder, not a promise. We will publish actual limits and billing
      details before taking payment.
    </p>
  </section>
</SiteLayout>

<style>
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    background: transparent;
  }

  .pricing-card {
    display: flex;
    flex-direction: column;
    min-height: 24rem;
    padding: clamp(1.8rem, 4vw, 2.8rem);
    background: var(--night-card);
    border: 1px solid var(--night-border);
    border-radius: 1rem;
    backdrop-filter: blur(12px);
    transition: all 200ms ease;
  }

  .pricing-card-current {
    background: var(--night-card-elevated);
    border: 1px solid rgba(143, 227, 201, 0.4);
    box-shadow: 0 16px 36px -10px rgba(0, 0, 0, 0.5), 0 0 28px var(--mint-glow);
    color: var(--text);
  }

  .pricing-card:not(.pricing-card-current):hover {
    background: var(--night-card-elevated);
    border-color: rgba(200, 185, 247, 0.35);
    box-shadow: 0 12px 30px -10px rgba(0, 0, 0, 0.4), 0 0 25px var(--lavender-glow);
    transform: translateY(-2px);
  }

  .pricing-label {
    display: inline-flex;
    align-self: flex-start;
    margin: 0 0 1.8rem;
    padding: 0.35rem 0.8rem;
    border-radius: 9999px;
    background: rgba(250, 227, 146, 0.08);
    border: 1px solid rgba(250, 227, 146, 0.28);
    color: var(--butter);
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .pricing-card-current .pricing-label {
    background: rgba(143, 227, 201, 0.1);
    border-color: rgba(143, 227, 201, 0.3);
    color: var(--mint);
  }

  .pricing-card h2 {
    margin: 0 0 0.8rem;
    color: var(--text);
    font-family: var(--display);
    font-size: clamp(2.4rem, 4.5vw, 4rem);
    font-weight: 600;
    letter-spacing: -0.06em;
    line-height: 1;
  }

  .pricing-price {
    margin: 0 0 1.25rem;
    color: var(--mint);
    font-family: var(--display);
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .pricing-card:not(.pricing-card-current) .pricing-price {
    color: var(--lavender);
  }

  .pricing-price span {
    display: block;
    margin-top: 0.45rem;
    color: var(--night-muted);
    font-family: var(--mono);
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .pricing-card-current .pricing-price span {
    color: var(--night-muted);
  }

  .pricing-card > p:not(.pricing-label):not(.pricing-price) {
    max-width: 28rem;
    min-height: 3.2rem;
    margin: 0;
    color: var(--night-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .pricing-card-current > p:not(.pricing-label):not(.pricing-price) {
    color: var(--text);
    opacity: 0.9;
  }

  .pricing-card ul {
    display: grid;
    gap: 0.75rem;
    margin: 2rem 0 0;
    padding: 1.5rem 0 0 1.25rem;
    border-top: 1px solid var(--night-border);
    color: var(--text);
    font-size: 0.92rem;
  }

  .pricing-card-current ul {
    border-color: rgba(143, 227, 201, 0.2);
    color: var(--text);
  }

  .pricing-card li::marker {
    color: var(--lavender);
  }

  .pricing-card-current li::marker {
    color: var(--mint);
  }

  @media (max-width: 620px) {
    .pricing-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
