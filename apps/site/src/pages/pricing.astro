---
// biome-ignore lint/correctness/noUnusedImports: Astro uses this layout component below.
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title="Pricing | plansplease"
  description="Simple for now. Clear about later."
>
  <header class="page-heading">
    <div>
      <h1>Pricing</h1>
      <p>Simple for now. Clear about later.</p>
    </div>
  </header>

  <section class="content-section" aria-label="Plans">
    <div class="pricing-grid">
      <article class="pricing-card pricing-card-current">
        <p class="pricing-label">Current / Alpha</p>
        <h2>Free</h2>
        <p class="pricing-price">$0 <span>during alpha</span></p>
        <p>Everything available today is free while we build out the service.</p>
        <ul>
          <li>Unlimited local previews with CLI</li>
          <li>Cloud copy of single-file HTML pages</li>
          <li>Private workspace with GitHub sign-in</li>
          <li>Alpha usage limits apply</li>
        </ul>
      </article>

      <article class="pricing-card">
        <p class="pricing-label">Later / Future</p>
        <h2>Fair</h2>
        <p class="pricing-price">Simple <span>when limits arrive</span></p>
        <p>We plan to keep a free tier for individual use, with straightforward pricing for teams.</p>
        <ul>
          <li>Free tier for personal projects</li>
          <li>Team workspaces and sharing</li>
          <li>Custom domains</li>
          <li>Higher storage and bandwidth limits</li>
        </ul>
      </article>
    </div>

    <p class="page-note">
      Questions about pricing? <a href="/faq/">Check the FAQ</a> or open an issue on <a href="https://github.com/abijith-suresh/planview">GitHub</a>.
    </p>
  </section>
</SiteLayout>

<style>
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    background: transparent;
  }

  .pricing-card {
    display: flex;
    flex-direction: column;
    min-height: 24rem;
    padding: clamp(1.8rem, 4vw, 2.5rem);
    background: var(--night-card);
    border: 1px solid var(--night-border);
    border-radius: 10px;
    transition: border-color 150ms ease;
  }

  .pricing-card-current {
    background: var(--night-card);
    border: 1px solid var(--mint-border);
    color: var(--text);
  }

  .pricing-card:not(.pricing-card-current):hover {
    border-color: var(--night-border-hover);
  }

  .pricing-label {
    display: inline-flex;
    align-self: flex-start;
    margin: 0 0 1.5rem;
    padding: 0.3rem 0.75rem;
    border-radius: 6px;
    background: var(--butter-soft);
    border: 1px solid var(--butter-border);
    color: var(--butter);
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .pricing-card-current .pricing-label {
    background: var(--mint-soft);
    border-color: var(--mint-border);
    color: var(--mint);
  }

  .pricing-card h2 {
    margin: 0 0 0.6rem;
    color: var(--text-white);
    font-family: var(--display);
    font-size: clamp(2.2rem, 4vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .pricing-price {
    margin: 0 0 1.25rem;
    color: var(--mint);
    font-family: var(--display);
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .pricing-card:not(.pricing-card-current) .pricing-price {
    color: var(--lavender);
  }

  .pricing-price span {
    display: block;
    margin-top: 0.4rem;
    color: var(--night-muted);
    font-family: var(--mono);
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .pricing-card > p:not(.pricing-label):not(.pricing-price) {
    max-width: 28rem;
    min-height: 3rem;
    margin: 0;
    color: var(--night-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .pricing-card ul {
    display: grid;
    gap: 0.75rem;
    margin: 1.75rem 0 0;
    padding: 1.5rem 0 0 1.25rem;
    border-top: 1px solid var(--night-border);
    color: var(--text);
    font-size: 0.92rem;
  }

  .pricing-card li::marker {
    color: var(--mint);
  }

  .pricing-card:not(.pricing-card-current) li::marker {
    color: var(--lavender);
  }

  @media (max-width: 48rem) {
    .pricing-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
