---
// biome-ignore lint/correctness/noUnusedImports: Astro uses this layout component below.
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title="Pricing | plansplease"
  description="Simple for now. Clear about later."
  activePath="pricing"
>
  <header class="page-heading">
    <div>
      <h1>Pricing</h1>
      <p>Simple for now. Clear about later.</p>
    </div>
  </header>

  <section class="content-section" aria-label="Plans">
    <div class="pricing-grid">
      <article class="pricing-card pricing-card-current">
        <div class="pricing-header">
          <span class="pricing-label">Current / Alpha</span>
          <h2>Free</h2>
        </div>
        <div class="pricing-price-box">
          <span class="price-number">$0</span>
          <span class="price-tenure">during alpha</span>
        </div>
        <p class="pricing-intro">Everything available today is free while we build out the service with the developer community.</p>
        <ul class="pricing-features">
          <li>Unlimited local previews with loopback daemon</li>
          <li>Cloud copy of single-file HTML pages</li>
          <li>Private encrypted workspace with GitHub sign-in</li>
          <li>Full support for modern CSS, Tailwind CDN, and Canvas</li>
          <li>Standard community support via GitHub</li>
        </ul>
      </article>

      <article class="pricing-card">
        <div class="pricing-header">
          <span class="pricing-label future">Future Roadmap</span>
          <h2>Fair & Transparent</h2>
        </div>
        <div class="pricing-price-box">
          <span class="price-number">Simple</span>
          <span class="price-tenure">when limits arrive</span>
        </div>
        <p class="pricing-intro">We are committed to maintaining a generous free tier for individual developers and clear pricing for teams.</p>
        <ul class="pricing-features">
          <li>Always-free personal tier for individual developers</li>
          <li>Team shared workspaces and collaborative access</li>
          <li>Custom domains with automatic SSL</li>
          <li>Higher persistent storage and asset bandwidth</li>
          <li>Dedicated support and SLA</li>
        </ul>
      </article>
    </div>

    <p class="page-note">
      Questions about plans or enterprise use cases? <a href="/faq/">Check the FAQ</a> or join the
      discussion on <a href="https://github.com/abijith-suresh/planview">GitHub</a>.
    </p>
  </section>
</SiteLayout>

<style>
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }

  .pricing-card {
    display: flex;
    flex-direction: column;
    padding: clamp(2.25rem, 4vw, 3rem);
    border: 1px solid var(--night-border);
    border-radius: 16px;
    background: var(--night-card);
    transition: all 160ms ease;
  }

  .pricing-card-current {
    border-color: var(--mint-border);
    background: var(--night-card-elevated);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
  }

  .pricing-card:not(.pricing-card-current):hover {
    border-color: var(--night-border-hover);
    transform: translateY(-2px);
  }

  .pricing-header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .pricing-label {
    display: inline-flex;
    align-self: flex-start;
    padding: 0.3rem 0.75rem;
    border-radius: 6px;
    background: var(--mint-soft);
    border: 1px solid var(--mint-border);
    color: var(--mint);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .pricing-label.future {
    background: var(--iris-soft);
    border-color: var(--iris-border);
    color: var(--iris);
  }

  .pricing-card h2 {
    margin: 0;
    color: var(--text-white);
    font-family: var(--display);
    font-size: 1.85rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .pricing-price-box {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    margin-bottom: 1.25rem;
  }

  .price-number {
    color: var(--text-white);
    font-family: var(--display);
    font-size: 3rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .price-tenure {
    color: var(--night-muted);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .pricing-intro {
    margin: 0 0 2rem;
    color: var(--night-muted);
    font-size: 1rem;
    line-height: 1.6;
  }

  .pricing-features {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 1rem;
    flex-grow: 1;
  }

  .pricing-features li {
    position: relative;
    padding-left: 1.75rem;
    color: var(--text);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .pricing-features li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--mint);
    font-weight: 800;
  }

  .pricing-card:not(.pricing-card-current) .pricing-features li::before {
    color: var(--iris);
  }

  @media (max-width: 860px) {
    .pricing-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
