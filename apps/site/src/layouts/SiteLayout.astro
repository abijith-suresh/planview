---
// biome-ignore lint/correctness/noUnusedImports: Astro uses the layout helper below.
import { appSignInUrl } from "../lib/app-url";

interface Props {
  title: string;
  description: string;
  activePath?: "features" | "cli" | "about" | "docs" | "pricing" | "faq" | "privacy" | "";
}

// biome-ignore lint/correctness/noUnusedVariables: Astro uses these props in the document template below.
const { title, description, activePath = "" } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
// biome-ignore lint/correctness/noUnusedVariables: Astro uses this value in the document template below.
const assetBase = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
const homeHref = baseUrl === "/" ? "/" : baseUrl.replace(/\/$/, "");
// biome-ignore lint/correctness/noUnusedVariables: Astro uses this helper in the document template below.
const pageHref = (path: string) => `${homeHref === "/" ? "" : homeHref}/${path}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1d1d2d" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" href={`${assetBase}favicon.svg`} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href={homeHref} aria-label="plansplease home">
          <span class="brand-name">plansplease</span>
        </a>

        <nav class="site-nav" aria-label="Main navigation">
          <a
            class:list={[
              "site-nav-link",
              { "is-current": activePath === "features" },
            ]}
            href={pageHref("features")}
            aria-current={activePath === "features" ? "page" : undefined}
          >Features</a>
          <a
            class:list={["site-nav-link", { "is-current": activePath === "pricing" }]}
            href={pageHref("pricing")}
            aria-current={activePath === "pricing" ? "page" : undefined}
          >Pricing</a>
          <a
            class:list={["site-nav-link", { "is-current": activePath === "docs" }]}
            href={pageHref("docs")}
            aria-current={activePath === "docs" ? "page" : undefined}
          >Docs</a>
          <a
            class:list={["site-nav-link", { "is-current": activePath === "faq" }]}
            href={pageHref("faq")}
            aria-current={activePath === "faq" ? "page" : undefined}
          >FAQ</a>
          <a class="site-nav-cta" href={appSignInUrl}>Sign in</a>
        </nav>

        <details class="mobile-menu">
          <summary class="mobile-menu-toggle" aria-label="Open site menu">
            <span class="menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
            <span>Menu</span>
          </summary>
          <nav class="mobile-menu-panel" aria-label="Mobile navigation">
            <a
              class:list={["mobile-menu-link", { "is-current": activePath === "features" }]}
              href={pageHref("features")}
              aria-current={activePath === "features" ? "page" : undefined}
            >Features</a>
            <a
              class:list={["mobile-menu-link", { "is-current": activePath === "pricing" }]}
              href={pageHref("pricing")}
              aria-current={activePath === "pricing" ? "page" : undefined}
            >Pricing</a>
            <a
              class:list={["mobile-menu-link", { "is-current": activePath === "docs" }]}
              href={pageHref("docs")}
              aria-current={activePath === "docs" ? "page" : undefined}
            >Docs</a>
            <a
              class:list={["mobile-menu-link", { "is-current": activePath === "faq" }]}
              href={pageHref("faq")}
              aria-current={activePath === "faq" ? "page" : undefined}
            >FAQ</a>
            <a class="mobile-menu-link" href={pageHref("cli")}>CLI</a>
            <a class="mobile-menu-link" href={pageHref("about")}>About</a>
            <a class="mobile-menu-cta" href={appSignInUrl}>Sign in with GitHub</a>
          </nav>
        </details>
      </header>

      <main id="main-content" tabindex="-1">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="site-footer-main">
          <div class="footer-brand">
            <a class="brand" href={homeHref} aria-label="plansplease home">
              <span class="brand-name">plansplease</span>
            </a>
            <p>Local previews for the pages your agent makes.</p>
          </div>

          <div class="footer-group">
            <p class="footer-heading">Product</p>
            <nav class="footer-links" aria-label="Product links">
              <a class="footer-link" href={pageHref("features")}>Features</a>
              <a class="footer-link" href={pageHref("pricing")}>Pricing</a>
              <a class="footer-link" href={pageHref("cli")}>CLI</a>
            </nav>
          </div>

          <div class="footer-group">
            <p class="footer-heading">Resources</p>
            <nav class="footer-links" aria-label="Resource links">
              <a class="footer-link" href={pageHref("docs")}>Docs</a>
              <a class="footer-link" href={pageHref("faq")}>FAQ</a>
              <a class="footer-link" href={pageHref("about")}>About</a>
            </nav>
          </div>

          <div class="footer-group">
            <p class="footer-heading">Project</p>
            <nav class="footer-links" aria-label="Project links">
              <a class="footer-link" href="https://github.com/abijith-suresh/planview">GitHub</a>
              <a class="footer-link" href={pageHref("privacy")}>Privacy</a>
              <a class="footer-link" href={appSignInUrl}>Sign in</a>
            </nav>
          </div>
        </div>

        <div class="site-footer-bottom">
          <p>plansplease alpha / local CLI + private cloud</p>
          <p>Made for the useful page between a draft and a project.</p>
        </div>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Chivo:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap");

  :root {
    --night: #1d1d2d;
    --night-soft: #29283e;
    --night-lighter: #393750;
    --night-muted: #b7b0bf;
    --text: #f7f0e5;
    --paper: #f5eddd;
    --ink: #282638;
    --butter: #e5d58d;
    --mint: #a5d2c0;
    --coral: #df9d8d;
    --blue: #aebfdf;
    --lavender: #c2b2e0;
    --mono: "IBM Plex Mono", "SFMono-Regular", "Cascadia Code", monospace;
    --sans: "IBM Plex Sans", "Trebuchet MS", sans-serif;
    --display: "Chivo", "Trebuchet MS", sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    color-scheme: dark;
    scroll-behavior: smooth;
  }

  body {
    min-width: 320px;
    margin: 0;
    overflow-x: hidden;
    background: var(--night);
    color: var(--text);
    font-family: var(--sans);
    font-size: 1rem;
    line-height: 1.55;
  }

  a {
    color: inherit;
  }

  .site-shell {
    width: min(calc(100% - 3rem), 76rem);
    margin: 0 auto;
  }

  .skip-link {
    position: fixed;
    z-index: 20;
    top: 1rem;
    left: 1rem;
    padding: 0.7rem 1rem;
    background: var(--text);
    color: var(--ink);
    font-size: 0.85rem;
    text-decoration: none;
    transform: translateY(-200%);
    transition: transform 180ms ease;
  }

  .skip-link:focus-visible {
    outline: 3px solid var(--mint);
    outline-offset: 3px;
    transform: translateY(0);
  }

  .site-header {
    position: relative;
    display: flex;
    min-height: 5.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    border-bottom: 1px solid rgba(247, 240, 229, 0.18);
  }

  .brand {
    text-decoration: none;
  }

  .brand-name {
    color: var(--text);
    font-family: var(--display);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.06em;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }

  .site-nav {
    color: var(--night-muted);
    font-size: 0.9rem;
  }

  .site-nav-link,
  .footer-link {
    color: var(--night-muted);
    text-decoration: none;
    transition: color 180ms ease;
  }

  .site-nav-link:hover,
  .site-nav-link:focus-visible,
  .site-nav-link.is-current,
  .footer-link:hover,
  .footer-link:focus-visible {
    color: var(--text);
  }

  .site-nav-cta {
    padding: 0.58rem 0.9rem;
    border: 1px solid rgba(247, 240, 229, 0.34);
    border-radius: 0.35rem;
    color: var(--text);
    text-decoration: none;
    transition: background 180ms ease, border-color 180ms ease, color 180ms ease;
  }

  .site-nav-cta:hover,
  .site-nav-cta:focus-visible {
    border-color: var(--mint);
    background: var(--mint);
    color: var(--ink);
  }

  .site-footer {
    padding: 3rem 0 1.25rem;
    border-top: 1px solid rgba(247, 240, 229, 0.18);
    color: var(--night-muted);
    font-size: 0.75rem;
  }

  .site-footer-main {
    display: grid;
    grid-template-columns: minmax(12rem, 1.7fr) repeat(3, minmax(7rem, 1fr));
    gap: 2rem;
  }

  .footer-brand p,
  .site-footer-bottom p {
    margin: 0;
  }

  .footer-brand p {
    max-width: 13rem;
    margin-top: 0.8rem;
    color: var(--night-muted);
    line-height: 1.45;
  }

  .footer-group {
    display: grid;
    align-content: start;
    gap: 0.75rem;
  }

  .footer-heading {
    margin: 0;
    color: var(--butter);
    font-family: var(--mono);
    font-size: 0.64rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .footer-links {
    display: grid;
    justify-items: start;
    gap: 0.4rem;
  }

  .site-footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(247, 240, 229, 0.12);
    color: var(--night-muted);
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .mobile-menu {
    display: none;
  }

  .mobile-menu-toggle {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.6rem 0.75rem;
    border: 1px solid rgba(247, 240, 229, 0.34);
    border-radius: 0.35rem;
    color: var(--text);
    cursor: pointer;
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.05em;
    list-style: none;
    text-transform: uppercase;
  }

  .mobile-menu-toggle::-webkit-details-marker {
    display: none;
  }

  .mobile-menu-toggle:hover,
  .mobile-menu-toggle:focus-visible,
  .mobile-menu[open] .mobile-menu-toggle {
    border-color: var(--mint);
    background: var(--mint);
    color: var(--ink);
  }

  .menu-icon {
    display: grid;
    gap: 3px;
    width: 0.9rem;
  }

  .menu-icon span {
    display: block;
    height: 1px;
    background: currentColor;
  }

  .mobile-menu-panel {
    position: absolute;
    z-index: 10;
    top: calc(100% + 0.75rem);
    right: 0;
    display: grid;
    min-width: 15rem;
    gap: 0.25rem;
    padding: 0.65rem;
    border: 1px solid rgba(247, 240, 229, 0.25);
    background: var(--night-soft);
    box-shadow: 0 1rem 2rem rgba(0, 0, 0, 0.22);
  }

  .mobile-menu-link,
  .mobile-menu-cta {
    display: block;
    padding: 0.7rem 0.75rem;
    color: var(--night-muted);
    text-decoration: none;
  }

  .mobile-menu-link:hover,
  .mobile-menu-link:focus-visible,
  .mobile-menu-link.is-current {
    background: var(--night-lighter);
    color: var(--text);
  }

  .mobile-menu-cta {
    margin-top: 0.35rem;
    background: var(--mint);
    color: var(--ink);
    font-weight: 600;
  }

  .mobile-menu-cta:hover,
  .mobile-menu-cta:focus-visible {
    background: var(--text);
  }

  :focus-visible {
    outline: 3px solid var(--mint);
    outline-offset: 4px;
  }

  .page-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(14rem, 20rem);
    gap: clamp(2rem, 8vw, 8rem);
    align-items: end;
    padding: clamp(4.5rem, 10vh, 7.5rem) 0 3.5rem;
    border-bottom: 1px solid rgba(247, 240, 229, 0.18);
  }

  .page-heading h1,
  .page-heading h2,
  .content-section h2,
  .feature-row h2 {
    margin-top: 0;
    color: var(--text);
    font-family: var(--display);
    font-weight: 600;
    letter-spacing: -0.075em;
    line-height: 0.95;
    text-wrap: balance;
  }

  .page-heading h1 {
    max-width: 10ch;
    margin-bottom: 1.5rem;
    font-size: clamp(3.5rem, 7vw, 7rem);
  }

  .page-heading p {
    max-width: 34rem;
    margin: 0;
    color: var(--night-muted);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
  }

  .page-action {
    display: inline-block;
    justify-self: start;
    padding: 0.9rem 1.05rem;
    border: 1px solid var(--mint);
    border-radius: 0.35rem;
    background: var(--mint);
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 180ms ease, border-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .page-action:hover,
  .page-action:focus-visible {
    border-color: var(--text);
    background: var(--text);
    color: var(--ink);
    transform: translateY(-2px);
  }

  .content-section {
    padding: 4rem 0 5.5rem;
  }

  .content-section > h2 {
    max-width: 10ch;
    margin-bottom: 2rem;
    font-size: clamp(2.4rem, 4vw, 4.2rem);
  }

  .feature-list {
    border-top: 1px solid rgba(247, 240, 229, 0.18);
  }

  .feature-row {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) minmax(12rem, 0.7fr);
    gap: 2rem;
    align-items: start;
    padding: 1.8rem 0;
    border-bottom: 1px solid rgba(247, 240, 229, 0.18);
  }

  .feature-number,
  .feature-command,
  .page-note,
  .command-label,
  .prose-label {
    color: var(--butter);
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .feature-number {
    padding-top: 0.35rem;
  }

  .feature-row h2 {
    margin-bottom: 0.7rem;
    font-size: clamp(1.7rem, 3vw, 2.6rem);
  }

  .feature-row p {
    max-width: 37rem;
    margin: 0;
    color: var(--night-muted);
  }

  .feature-command {
    justify-self: end;
    padding-top: 0.35rem;
    color: var(--mint);
    text-align: right;
    text-transform: none;
  }

  .page-note {
    margin: 2rem 0 0;
    color: var(--night-muted);
    text-transform: none;
  }

  .page-note a {
    color: var(--text);
    text-decoration-color: var(--mint);
    text-underline-offset: 0.2em;
  }

  .command-card {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(20rem, 1.2fr);
    gap: 2rem;
    align-items: center;
    padding: clamp(1.5rem, 4vw, 3rem);
    background: var(--paper);
    color: var(--ink);
  }

  .command-card h2 {
    max-width: 12ch;
    margin: 0 0 0.8rem;
    font-family: var(--display);
    font-size: clamp(2.3rem, 4vw, 4rem);
    letter-spacing: -0.075em;
    line-height: 0.95;
  }

  .command-card p {
    max-width: 28rem;
    margin: 0;
    color: #686176;
  }

  .command-block {
    margin: 0;
    padding: 1.25rem;
    overflow-x: auto;
    background: var(--night-soft);
    color: var(--text);
    font-family: var(--mono);
    font-size: 0.8rem;
    line-height: 1.8;
  }

  .command-block span {
    color: var(--mint);
  }

  .command-block code {
    white-space: pre;
  }

  .content-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: rgba(247, 240, 229, 0.18);
  }

  .content-card {
    min-height: 12rem;
    padding: 1.5rem;
    background: var(--night);
  }

  .content-card h2 {
    margin-bottom: 0.7rem;
    font-size: clamp(1.7rem, 3vw, 2.5rem);
  }

  .content-card p {
    max-width: 28rem;
    margin: 0;
    color: var(--night-muted);
  }

  .prose-page {
    max-width: 48rem;
    padding: clamp(4.5rem, 10vh, 7.5rem) 0 6rem;
  }

  .prose-page h1 {
    max-width: 10ch;
    margin: 0 0 1.5rem;
    color: var(--text);
    font-family: var(--display);
    font-size: clamp(3.5rem, 7vw, 6.5rem);
    font-weight: 600;
    letter-spacing: -0.075em;
    line-height: 0.92;
  }

  .prose-page > p {
    max-width: 38rem;
    color: var(--night-muted);
    font-size: 1.1rem;
  }

  .prose-list {
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgba(247, 240, 229, 0.18);
  }

  .prose-list li {
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(247, 240, 229, 0.18);
  }

  .prose-list h2 {
    margin: 0 0 0.45rem;
    color: var(--text);
    font-family: var(--display);
    font-size: 1.45rem;
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  .prose-list p {
    max-width: 38rem;
    margin: 0;
    color: var(--night-muted);
  }

  @media (max-width: 760px) {
    .page-heading,
    .command-card {
      grid-template-columns: 1fr;
    }

    .page-action {
      margin-top: 0.5rem;
    }

    .feature-row {
      grid-template-columns: 3rem minmax(0, 1fr);
      gap: 1rem;
    }

    .feature-command {
      grid-column: 2;
      justify-self: start;
      padding-top: 0;
      text-align: left;
    }
  }

  @media (max-width: 620px) {
    .site-shell {
      width: min(calc(100% - 2rem), 76rem);
    }

    .site-header {
      min-height: 4.75rem;
    }

    .site-nav {
      display: none;
    }

    .mobile-menu {
      display: block;
    }

    .site-footer {
      padding: 1.4rem 0;
    }

    .site-footer-main {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem 1rem;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }

    .site-footer-bottom {
      display: grid;
      gap: 0.5rem;
      margin-top: 2.25rem;
    }

    .page-heading {
      padding: 4.5rem 0 3.5rem;
    }

    .content-section {
      padding: 3rem 0 4rem;
    }

    .content-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      transition-duration: 0.01ms !important;
    }
  }
</style>
