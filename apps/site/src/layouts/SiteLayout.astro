---
// biome-ignore lint/correctness/noUnusedImports: Astro uses the layout helper below.
import { appSignInUrl } from "../lib/app-url";

interface Props {
  title: string;
  description: string;
  activePath?: "features" | "cli" | "about" | "docs" | "pricing" | "faq" | "privacy" | "";
}

// biome-ignore lint/correctness/noUnusedVariables: Astro uses these props in the document template below.
const { title, description, activePath = "" } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
// biome-ignore lint/correctness/noUnusedVariables: Astro uses this value in the document template below.
const assetBase = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
const homeHref = baseUrl === "/" ? "/" : baseUrl.replace(/\/$/, "");
// biome-ignore lint/correctness/noUnusedVariables: Astro uses this helper in the document template below.
const pageHref = (path: string) => `${homeHref === "/" ? "" : homeHref}/${path}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090a10" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" href={`${assetBase}favicon.svg`} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href={homeHref} aria-label="plansplease home">
          <span class="brand-name"><span class="brand-plans">plans</span><span class="brand-please">please</span></span>
        </a>

        <nav class="site-nav" aria-label="Main navigation">
          <a
            class:list={["site-nav-link", { "is-current": activePath === "features" }]}
            href={pageHref("features")}
            aria-current={activePath === "features" ? "page" : undefined}
          >Features</a>
          <a
            class:list={["site-nav-link", { "is-current": activePath === "pricing" }]}
            href={pageHref("pricing")}
            aria-current={activePath === "pricing" ? "page" : undefined}
          >Pricing</a>
          <a
            class:list={["site-nav-link", { "is-current": activePath === "docs" }]}
            href={pageHref("docs")}
            aria-current={activePath === "docs" ? "page" : undefined}
          >Docs</a>
          <a
            class:list={["site-nav-link", { "is-current": activePath === "cli" }]}
            href={pageHref("cli")}
            aria-current={activePath === "cli" ? "page" : undefined}
          >CLI</a>
          <a
            class:list={["site-nav-link", { "is-current": activePath === "faq" }]}
            href={pageHref("faq")}
            aria-current={activePath === "faq" ? "page" : undefined}
          >FAQ</a>
          <a class="site-nav-cta" href={appSignInUrl}>Sign in</a>
        </nav>

        <details class="mobile-menu">
          <summary class="mobile-menu-toggle" aria-label="Open site menu">
            <span class="menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
            <span>Menu</span>
          </summary>
          <nav class="mobile-menu-panel" aria-label="Mobile navigation">
            <a
              class:list={["mobile-menu-link", { "is-current": activePath === "features" }]}
              href={pageHref("features")}
              aria-current={activePath === "features" ? "page" : undefined}
            >Features</a>
            <a
              class:list={["mobile-menu-link", { "is-current": activePath === "pricing" }]}
              href={pageHref("pricing")}
              aria-current={activePath === "pricing" ? "page" : undefined}
            >Pricing</a>
            <a
              class:list={["mobile-menu-link", { "is-current": activePath === "docs" }]}
              href={pageHref("docs")}
              aria-current={activePath === "docs" ? "page" : undefined}
            >Docs</a>
            <a
              class:list={["mobile-menu-link", { "is-current": activePath === "cli" }]}
              href={pageHref("cli")}
              aria-current={activePath === "cli" ? "page" : undefined}
            >CLI</a>
            <a
              class:list={["mobile-menu-link", { "is-current": activePath === "faq" }]}
              href={pageHref("faq")}
              aria-current={activePath === "faq" ? "page" : undefined}
            >FAQ</a>
            <a class="mobile-menu-link" href={pageHref("about")}>About</a>
            <a class="mobile-menu-cta" href={appSignInUrl}>Sign in with GitHub</a>
          </nav>
        </details>
      </header>

      <main id="main-content" tabindex="-1">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="site-footer-main">
          <div class="footer-brand">
            <a class="brand" href={homeHref} aria-label="plansplease home">
              <span class="brand-name"><span class="brand-plans">plans</span><span class="brand-please">please</span></span>
            </a>
            <p>The living workspace for agent-crafted web artifacts, dashboards, and prototypes.</p>
          </div>

          <div class="footer-group">
            <p class="footer-heading">Product</p>
            <nav class="footer-links" aria-label="Product links">
              <a class="footer-link" href={pageHref("features")}>Features</a>
              <a class="footer-link" href={pageHref("pricing")}>Pricing</a>
              <a class="footer-link" href={pageHref("cli")}>CLI</a>
            </nav>
          </div>

          <div class="footer-group">
            <p class="footer-heading">Resources</p>
            <nav class="footer-links" aria-label="Resource links">
              <a class="footer-link" href={pageHref("docs")}>Docs</a>
              <a class="footer-link" href={pageHref("faq")}>FAQ</a>
              <a class="footer-link" href={pageHref("about")}>About</a>
            </nav>
          </div>

          <div class="footer-group">
            <p class="footer-heading">Project</p>
            <nav class="footer-links" aria-label="Project links">
              <a class="footer-link" href="https://github.com/abijith-suresh/planview">GitHub</a>
              <a class="footer-link" href={pageHref("privacy")}>Privacy</a>
              <a class="footer-link" href={appSignInUrl}>Sign in</a>
            </nav>
          </div>
        </div>

        <div class="site-footer-bottom">
          <p>plansplease • Local loopback daemon + secure cloud workspace</p>
          <p>Giving AI-generated software a lasting, interactive home.</p>
        </div>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap");

  :root {
    /* Obsidian & Deep Slate Canvas */
    --night: #090a10;
    --night-soft: #0e1017;
    --night-card: #131622;
    --night-card-elevated: #1a1e2e;
    --night-border: #23283b;
    --night-border-hover: #373e59;
    --night-muted: #8e95ac;
    --night-subtle: #565d77;

    /* High contrast text */
    --text: #f0f3fc;
    --text-white: #ffffff;
    --paper: #12151e;
    --ink: #07080c;

    /* Distinctive Brand Accents */
    --mint: #8fe3c9;
    --mint-hover: #aef0dc;
    --mint-soft: rgba(143, 227, 201, 0.1);
    --mint-border: rgba(143, 227, 201, 0.28);

    --iris: #818cf8;
    --iris-soft: rgba(129, 140, 248, 0.1);
    --iris-border: rgba(129, 140, 248, 0.28);

    --butter: #fae392;
    --butter-soft: rgba(250, 227, 146, 0.1);
    --butter-border: rgba(250, 227, 146, 0.28);

    --coral: #f8abb6;
    --coral-soft: rgba(248, 171, 182, 0.1);
    --coral-border: rgba(248, 171, 182, 0.28);

    --mono: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace;
    --sans: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    --display: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    color-scheme: dark;
    scroll-behavior: smooth;
  }

  body {
    min-width: 320px;
    margin: 0;
    overflow-x: hidden;
    background-color: var(--night);
    color: var(--text);
    font-family: var(--sans);
    font-size: 1rem;
    line-height: 1.6;
    letter-spacing: -0.012em;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  a {
    color: inherit;
  }

  .site-shell {
    width: min(calc(100% - 3.5rem), 76rem);
    margin: 0 auto;
  }

  /* Accessibility skip link required by test suite */
  .skip-link {
    position: fixed;
    z-index: 50;
    top: 1rem;
    left: 1rem;
    padding: 0.75rem 1.25rem;
    background: var(--night-card);
    border: 1px solid var(--mint);
    border-radius: 8px;
    color: var(--text);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.7);
    transform: translateY(-200%);
    transition: transform 180ms ease;
  }

  .skip-link:focus-visible {
    outline: 3px solid var(--mint);
    outline-offset: 3px;
    transform: translateY(0);
  }

  /* Navigation Header */
  .site-header {
    position: relative;
    display: flex;
    min-height: 5.25rem;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    border-bottom: 1px solid var(--night-border);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .brand-name {
    font-family: var(--display);
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.05em;
    display: inline-flex;
    line-height: 1;
  }

  .brand-plans {
    color: #ffffff;
  }

  .brand-please {
    color: var(--mint);
    transition: color 150ms ease;
  }

  .brand:hover .brand-please {
    color: var(--mint-hover);
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    color: var(--night-muted);
    font-size: 0.92rem;
    font-weight: 500;
  }

  .site-nav-link,
  .footer-link {
    color: var(--night-muted);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .site-nav-link:hover,
  .site-nav-link:focus-visible,
  .site-nav-link.is-current,
  .footer-link:hover,
  .footer-link:focus-visible {
    color: var(--text-white);
  }

  .site-nav-link.is-current {
    color: var(--mint);
    font-weight: 600;
  }

  .site-nav-cta {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1.15rem;
    border: 1px solid var(--mint-border);
    border-radius: 8px;
    background: var(--mint-soft);
    color: var(--mint);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: all 150ms ease;
  }

  .site-nav-cta:hover,
  .site-nav-cta:focus-visible {
    border-color: var(--mint);
    background: var(--mint);
    color: var(--ink);
  }

  /* Shared Page Headings */
  .page-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    padding: clamp(3.5rem, 6vh, 5.5rem) 0 2.5rem;
    border-bottom: 1px solid var(--night-border);
  }

  .page-heading h1 {
    max-width: 22ch;
    margin: 0 0 1rem;
    color: var(--text-white);
    font-family: var(--display);
    font-size: clamp(2.4rem, 4.2vw, 3.6rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .page-heading p {
    max-width: 42rem;
    margin: 0;
    color: var(--night-muted);
    font-size: 1.1rem;
    line-height: 1.6;
  }

  .page-action {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    padding: 0.75rem 1.4rem;
    border: 1px solid var(--mint-border);
    border-radius: 8px;
    background: var(--mint-soft);
    color: var(--mint);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 150ms ease;
  }

  .page-action:hover,
  .page-action:focus-visible {
    background: var(--mint);
    border-color: var(--mint);
    color: var(--ink);
  }

  .content-section {
    padding: clamp(3.5rem, 6vh, 5rem) 0;
    border-bottom: 1px solid var(--night-border);
  }

  .content-section > h2 {
    margin: 0 0 2.5rem;
    color: var(--text-white);
    font-family: var(--display);
    font-size: clamp(1.8rem, 2.8vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .page-note {
    margin: 2.5rem 0 0;
    color: var(--night-muted);
    font-size: 0.95rem;
  }

  .page-note a {
    color: var(--mint);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Footer */
  .site-footer {
    padding: 4.5rem 0 3rem;
    border-top: 1px solid var(--night-border);
    color: var(--night-muted);
    font-size: 0.9rem;
  }

  .site-footer-main {
    display: grid;
    grid-template-columns: minmax(14rem, 2fr) repeat(3, minmax(8rem, 1fr));
    gap: 3rem;
  }

  .footer-brand p,
  .site-footer-bottom p {
    margin: 0;
  }

  .footer-brand p {
    max-width: 18rem;
    margin-top: 1rem;
    color: var(--night-muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .footer-group {
    display: grid;
    align-content: start;
    gap: 1rem;
  }

  .footer-heading {
    margin: 0;
    color: var(--text-white);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .footer-links {
    display: grid;
    justify-items: start;
    gap: 0.65rem;
  }

  .site-footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--night-border);
    color: var(--night-subtle);
    font-size: 0.82rem;
  }

  /* Mobile menu */
  .mobile-menu {
    display: none;
  }

  .mobile-menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--night-border);
    border-radius: 8px;
    color: var(--text);
    cursor: pointer;
    list-style: none;
  }

  .mobile-menu-toggle::-webkit-details-marker {
    display: none;
  }

  .menu-icon {
    display: inline-flex;
    flex-direction: column;
    gap: 3px;
    width: 14px;
  }

  .menu-icon span {
    display: block;
    height: 1.5px;
    background: currentColor;
    border-radius: 1px;
  }

  .mobile-menu-panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    left: 0;
    z-index: 40;
    display: grid;
    gap: 0.4rem;
    padding: 1.25rem;
    border: 1px solid var(--night-border);
    border-radius: 12px;
    background: var(--night-card);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6);
  }

  .mobile-menu-link {
    padding: 0.6rem 0.75rem;
    border-radius: 6px;
    color: var(--text);
    font-size: 0.95rem;
    text-decoration: none;
  }

  .mobile-menu-link:hover,
  .mobile-menu-link.is-current {
    background: var(--night-card-elevated);
    color: var(--mint);
  }

  .mobile-menu-cta {
    margin-top: 0.5rem;
    padding: 0.75rem;
    border-radius: 8px;
    background: var(--mint);
    color: var(--ink);
    font-weight: 600;
    text-align: center;
    text-decoration: none;
  }

  @media (max-width: 860px) {
    .site-nav {
      display: none;
    }

    .mobile-menu {
      display: block;
    }

    .site-footer-main {
      grid-template-columns: 1fr 1fr;
    }

    .footer-brand {
      grid-column: span 2;
    }

    .page-heading {
      flex-direction: column;
      align-items: flex-start;
    }

    .site-footer-bottom {
      flex-direction: column;
      gap: 0.5rem;
    }
  }

  @media (max-width: 540px) {
    .site-shell {
      width: min(calc(100% - 2rem), 76rem);
    }

    .site-footer-main {
      grid-template-columns: 1fr;
    }

    .footer-brand {
      grid-column: span 1;
    }
  }
</style>
