---
// biome-ignore lint/correctness/noUnusedImports: Astro uses the layout helper below.
import { appSignInUrl } from "../lib/app-url";

interface Props {
  title: string;
  description: string;
  activePath?: "features" | "cli" | "about" | "docs" | "pricing" | "faq" | "privacy" | "";
}

// biome-ignore lint/correctness/noUnusedVariables: Astro uses these props in the document template below.
const { title, description, activePath = "" } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
// biome-ignore lint/correctness/noUnusedVariables: Astro uses this value in the document template below.
const assetBase = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
const homeHref = baseUrl === "/" ? "/" : baseUrl.replace(/\/$/, "");
// biome-ignore lint/correctness/noUnusedVariables: Astro uses this helper in the document template below.
const pageHref = (path: string) => `${homeHref === "/" ? "" : homeHref}/${path}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c0c0e" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" href={`${assetBase}favicon.svg`} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="site-header">
      <div class="site-shell site-header-row">
        <a class="brand" href={homeHref} aria-label="plansplease home">
          <span class="brand-name"><span class="brand-plans">plans</span><span class="brand-please">please</span></span>
        </a>

        <nav class="site-nav" aria-label="Main navigation">
          <a
            class:list={["site-nav-link", { "is-current": activePath === "features" }]}
            href={pageHref("features")}
            aria-current={activePath === "features" ? "page" : undefined}
          >Features</a>
          <a
            class:list={["site-nav-link", { "is-current": activePath === "docs" }]}
            href={pageHref("docs")}
            aria-current={activePath === "docs" ? "page" : undefined}
          >Docs</a>
          <a
            class:list={["site-nav-link", { "is-current": activePath === "cli" }]}
            href={pageHref("cli")}
            aria-current={activePath === "cli" ? "page" : undefined}
          >CLI</a>
          <a
            class:list={["site-nav-link", { "is-current": activePath === "pricing" }]}
            href={pageHref("pricing")}
            aria-current={activePath === "pricing" ? "page" : undefined}
          >Pricing</a>
          <a
            class:list={["site-nav-link", { "is-current": activePath === "faq" }]}
            href={pageHref("faq")}
            aria-current={activePath === "faq" ? "page" : undefined}
          >FAQ</a>
          <a class="site-nav-cta" href={appSignInUrl}>Sign in</a>
        </nav>

        <details class="mobile-menu">
          <summary class="mobile-menu-toggle" aria-label="Open site menu">
            <span class="menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
            <span>Menu</span>
          </summary>
          <nav class="mobile-menu-panel" aria-label="Mobile navigation">
            <a
              class:list={["mobile-menu-link", { "is-current": activePath === "features" }]}
              href={pageHref("features")}
              aria-current={activePath === "features" ? "page" : undefined}
            >Features</a>
            <a
              class:list={["mobile-menu-link", { "is-current": activePath === "docs" }]}
              href={pageHref("docs")}
              aria-current={activePath === "docs" ? "page" : undefined}
            >Docs</a>
            <a
              class:list={["mobile-menu-link", { "is-current": activePath === "cli" }]}
              href={pageHref("cli")}
              aria-current={activePath === "cli" ? "page" : undefined}
            >CLI</a>
            <a
              class:list={["mobile-menu-link", { "is-current": activePath === "pricing" }]}
              href={pageHref("pricing")}
              aria-current={activePath === "pricing" ? "page" : undefined}
            >Pricing</a>
            <a
              class:list={["mobile-menu-link", { "is-current": activePath === "faq" }]}
              href={pageHref("faq")}
              aria-current={activePath === "faq" ? "page" : undefined}
            >FAQ</a>
            <a
              class:list={["mobile-menu-link", { "is-current": activePath === "about" }]}
              href={pageHref("about")}
              aria-current={activePath === "about" ? "page" : undefined}
            >About</a>
            <a class="mobile-menu-cta" href={appSignInUrl}>Sign in with GitHub</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main-content" tabindex="-1">
      <div class="site-shell site-main-shell">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="site-shell">
        <div class="site-footer-main">
          <div class="footer-brand">
            <a class="brand" href={homeHref} aria-label="plansplease home">
              <span class="brand-name"><span class="brand-plans">plans</span><span class="brand-please">please</span></span>
            </a>
            <p>Local previews and a private cloud workspace for the HTML your agent writes.</p>
          </div>

          <div class="footer-group">
            <p class="footer-heading">Product</p>
            <nav class="footer-links" aria-label="Product links">
              <a class="footer-link" href={pageHref("features")}>Features</a>
              <a class="footer-link" href={pageHref("pricing")}>Pricing</a>
              <a class="footer-link" href={pageHref("cli")}>CLI</a>
            </nav>
          </div>

          <div class="footer-group">
            <p class="footer-heading">Resources</p>
            <nav class="footer-links" aria-label="Resource links">
              <a class="footer-link" href={pageHref("docs")}>Docs</a>
              <a class="footer-link" href={pageHref("faq")}>FAQ</a>
              <a class="footer-link" href={pageHref("about")}>About</a>
            </nav>
          </div>

          <div class="footer-group">
            <p class="footer-heading">Project</p>
            <nav class="footer-links" aria-label="Project links">
              <a class="footer-link" href="https://github.com/abijith-suresh/planview">GitHub</a>
              <a class="footer-link" href={pageHref("privacy")}>Privacy</a>
              <a class="footer-link" href={appSignInUrl}>Sign in</a>
            </nav>
          </div>
        </div>

        <div class="site-footer-bottom">
          <p>plansplease</p>
          <p>Local previews, private cloud pages. Built for agent workflows.</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@500;600;700&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&family=Fragment+Mono&display=swap");

  :root {
    /* Canvas — warm graphite */
    --night: #0c0c0e;
    --night-soft: #0f0f11;
    --night-card: #121213;
    --night-card-elevated: #161618;

    /* Hairlines */
    --night-border: #201f1e;
    --night-border-hover: #2e2d2a;

    /* Text */
    --night-muted: #a09d97;
    --night-subtle: #6e6b66;
    --text: #d8d5d0;
    --text-white: #f7f5f1;
    --ink: #0c0c0e;

    /* Accent — one amber, used sparingly */
    --mint: #e9a23b;
    --mint-hover: #f2b658;
    --mint-soft: rgba(233, 162, 59, 0.07);
    --mint-border: rgba(233, 162, 59, 0.24);

    --mono: "Fragment Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --sans: "Instrument Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    --display: "Schibsted Grotesk", "Instrument Sans", -apple-system, BlinkMacSystemFont, sans-serif;

    --radius-sm: 6px;
    --radius: 8px;
    --radius-lg: 10px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    color-scheme: dark;
    scroll-behavior: smooth;
  }

  body {
    min-width: 320px;
    margin: 0;
    overflow-x: hidden;
    background-color: var(--night);
    color: var(--text);
    font-family: var(--sans);
    font-size: 0.95rem;
    line-height: 1.65;
    letter-spacing: -0.011em;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }

  ::selection {
    background: rgba(233, 162, 59, 0.2);
    color: var(--text-white);
  }

  a {
    color: inherit;
  }

  .site-shell {
    width: min(calc(100% - 3rem), 72rem);
    margin: 0 auto;
  }

  /* Accessibility skip link required by test suite */
  .skip-link {
    position: fixed;
    z-index: 50;
    top: 1rem;
    left: 1rem;
    padding: 0.7rem 1.1rem;
    background: var(--night-card-elevated);
    border: 1px solid var(--night-border-hover);
    border-radius: var(--radius);
    color: var(--text-white);
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    transform: translateY(-200%);
    transition: transform 160ms ease;
  }

  .skip-link:focus-visible {
    outline: 3px solid var(--mint);
    outline-offset: 3px;
    transform: translateY(0);
  }

  /* Header */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: rgba(12, 12, 14, 0.82);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--night-border);
  }

  .site-header-row {
    display: flex;
    min-height: 3.75rem;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .brand-name {
    display: inline-flex;
    font-family: var(--display);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .brand-plans {
    color: var(--text-white);
  }

  .brand-please {
    color: var(--mint);
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    font-size: 0.875rem;
    font-weight: 450;
  }

  .site-nav-link,
  .footer-link {
    color: var(--night-muted);
    text-decoration: none;
    transition: color 140ms ease;
  }

  .site-nav-link:hover,
  .site-nav-link:focus-visible,
  .site-nav-link.is-current,
  .footer-link:hover,
  .footer-link:focus-visible {
    color: var(--text-white);
  }

  .site-nav-cta {
    display: inline-flex;
    align-items: center;
    margin-left: 0.4rem;
    padding: 0.42rem 0.95rem;
    border: 1px solid var(--night-border-hover);
    border-radius: var(--radius);
    color: var(--text-white);
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 140ms ease, background-color 140ms ease;
  }

  .site-nav-cta:hover,
  .site-nav-cta:focus-visible {
    border-color: #3a3833;
    background: var(--night-card);
  }

  /* Main */
  .site-main-shell {
    min-height: 60vh;
  }

  main:focus {
    outline: none;
  }

  /* Shared Page Headings */
  .page-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    padding: clamp(4rem, 7vh, 5.5rem) 0 2.5rem;
    border-bottom: 1px solid var(--night-border);
  }

  .page-heading h1 {
    max-width: 22ch;
    margin: 0 0 0.9rem;
    color: var(--text-white);
    font-family: var(--display);
    font-size: clamp(2rem, 3.4vw, 2.6rem);
    font-weight: 650;
    letter-spacing: -0.032em;
    line-height: 1.12;
  }

  .page-heading p {
    max-width: 40rem;
    margin: 0;
    color: var(--night-muted);
    font-size: 1rem;
    line-height: 1.65;
  }

  .page-action {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    padding: 0.62rem 1.15rem;
    border: 1px solid var(--night-border-hover);
    border-radius: var(--radius);
    color: var(--text-white);
    font-size: 0.88rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 140ms ease, background-color 140ms ease;
  }

  .page-action:hover,
  .page-action:focus-visible {
    border-color: #3a3833;
    background: var(--night-card);
  }

  /* Shared Content Section */
  .content-section {
    padding: 3.5rem 0 4.5rem;
  }

  .content-section h2 {
    margin: 0 0 1.9rem;
    color: var(--text-white);
    font-family: var(--display);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .page-note {
    max-width: 38rem;
    margin: 3rem 0 0;
    color: var(--night-subtle);
    font-size: 0.86rem;
    line-height: 1.6;
  }

  /* Footer */
  .site-footer {
    border-top: 1px solid var(--night-border);
    padding: 3.5rem 0 3rem;
  }

  .site-footer-main {
    display: grid;
    grid-template-columns: minmax(0, 1.8fr) repeat(3, minmax(0, 1fr));
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .footer-brand p {
    max-width: 20rem;
    margin: 1rem 0 0;
    color: var(--night-muted);
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .footer-heading {
    margin: 0 0 1rem;
    color: var(--night-subtle);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-link {
    font-size: 0.88rem;
    line-height: 1.4;
  }

  .site-footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--night-border);
    color: var(--night-subtle);
    font-size: 0.8rem;
  }

  .site-footer-bottom p {
    margin: 0;
  }

  /* Mobile Navigation Menu */
  .mobile-menu {
    display: none;
    position: relative;
  }

  .mobile-menu-toggle {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--night-border-hover);
    border-radius: var(--radius);
    color: var(--text);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
  }

  .mobile-menu-toggle::-webkit-details-marker {
    display: none;
  }

  .menu-icon {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 3px;
    width: 14px;
    height: 14px;
  }

  .menu-icon span {
    display: block;
    height: 1.5px;
    background: var(--text);
    border-radius: 1px;
  }

  .mobile-menu-panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    width: 15rem;
    padding: 0.6rem;
    border: 1px solid var(--night-border-hover);
    border-radius: var(--radius-lg);
    background: var(--night-card-elevated);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.55);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    z-index: 40;
  }

  .mobile-menu-link {
    display: block;
    padding: 0.55rem 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--night-muted);
    font-size: 0.9rem;
    font-weight: 450;
    text-decoration: none;
  }

  .mobile-menu-link:hover,
  .mobile-menu-link.is-current {
    color: var(--text-white);
    background: var(--night-card);
  }

  .mobile-menu-cta {
    display: block;
    margin-top: 0.4rem;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-sm);
    background: var(--text-white);
    color: var(--ink);
    font-size: 0.86rem;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
  }

  @media (max-width: 840px) {
    .site-nav {
      display: none;
    }

    .mobile-menu {
      display: block;
    }

    .site-footer-main {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .site-footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .page-heading {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
