---
interface Props {
  current: "a" | "b" | "c" | "d";
}

// biome-ignore lint/correctness/noUnusedVariables: Astro uses this prop in the template below.
const { current } = Astro.props;

// biome-ignore lint/correctness/noUnusedVariables: Astro maps this array in the template below.
const concepts = [
  { key: "a", href: "/" },
  { key: "b", href: "/1/" },
  { key: "c", href: "/2/" },
  { key: "d", href: "/3/" },
] as const;
---

<nav class="concept-switch" aria-label="Landing page design concepts">
  <span aria-hidden="true">concept</span>
  {
    concepts.map((concept) => (
      <a
        href={concept.href}
        aria-current={current === concept.key ? "page" : undefined}
      >
        {concept.key.toUpperCase()}
      </a>
    ))
  }
</nav>

<style>
  .concept-switch {
    position: fixed;
    right: 1.1rem;
    bottom: 1.1rem;
    z-index: 90;
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.45rem;
    border: 1px solid var(--night-border-hover);
    border-radius: 999px;
    background: rgba(18, 18, 20, 0.92);
    backdrop-filter: blur(8px);
    font-family: var(--mono);
    font-size: 0.66rem;
  }

  .concept-switch span {
    margin-right: 0.4rem;
    color: var(--night-subtle);
    letter-spacing: 0.06em;
  }

  .concept-switch a {
    padding: 0.2rem 0.45rem;
    border-radius: 999px;
    color: var(--night-subtle);
    text-decoration: none;
  }

  .concept-switch a:hover,
  .concept-switch a:focus-visible {
    color: var(--text-white);
  }

  .concept-switch a[aria-current="page"] {
    background: var(--night-card-elevated);
    color: var(--mint);
  }
</style>
