# Generated by `npx convex dev` for the selected Convex deployment.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Optional server-side aliases for Railway or another Node host. The app also
# accepts the VITE_* names written by the Convex CLI during local development.
# CONVEX_URL=
# CONVEX_SITE_URL=

# Configure these on the Convex deployment with `npx convex env set`.
# They must not be exposed to the browser or committed to git.
# BETTER_AUTH_SECRET=
# SITE_URL=http://localhost:3000
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# UploadThing storage for standalone HTML files. This is server-only; do not
# prefix it with VITE_ or expose it to the browser.
# UPLOADTHING_TOKEN=
# Required by the app server and Convex deployment to authorize metadata writes.
# DOCUMENT_MUTATION_SECRET=
# Use the public app origin on the Node app too. Convex needs the same SITE_URL
# for OAuth redirect URLs and its CIMD transport callback.
# SITE_URL=http://localhost:3000
# Shared by the app server and Convex for private CIMD metadata fetches (32+ bytes).
# CIMD_FETCH_SECRET=
# Set this only if UploadThing cannot infer the public staging URL.
